                'statements': [ \
                    { \
                        'include': { \
                            'includes': [ \
                                {'url': 'a.bare'}, \
                                {'url': 'b\\\'s.bare'}, \
                                {'url': 'system.bare', 'system': true} \
                            ], \
                            'lineNumber': 1, \
                            'lineCount': 3 \
                        } \
                    } \
                ], \
                'scriptLines': ['include \'a.bare\'', 'include \'b\\\\\'s.bare\'', 'include <system.bare>'] \
            } \
        } \
    )
