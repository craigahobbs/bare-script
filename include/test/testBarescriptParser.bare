function testBarescriptParserErrorContinuationExpression():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'a = 1 + \\', \
            '  * 2' \
        ], 1, 'test.bare'), \
        { \
            'error': { \
                'error': 'Syntax error', \
                'line': 'a = 1 + * 2', \
                'columnNumber': 8, \
                'lineNumber': 1, \
                'scriptName': 'test.bare', \
                'message': 'test.bare:1: Syntax error\na = 1 + * 2\n       ^\n' \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserErrorContinuationExpression')


