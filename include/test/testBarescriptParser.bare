function testBarescriptParserValidateScript():
    unittestMockAll()

    # Parse a script exercising every statement form and validate it against the BareScript model schema
    parseResult = barescriptParseScriptEx([ \
        'include \'util.bare\'', \
        'include <unittest.bare>', \
        'a = 1', \
        'systemLog(\'hello\')', \
        'function fn(x, y):', \
        '    return x + y', \
        'endfunction', \
        'async function afn(args...):', \
        '    return', \
        'endfunction', \
        'if a == 1:', \
        '    b = -a', \
        'elif a != 2:', \
        '    b = (a + 1) * 2', \
        'else:', \
        '    b = {\'key\': [0x1f, 1.5e2, \'it\\\'s\', "quoted", true, false, null]}', \
        'endif', \
        'while a < 10:', \
        '    a = a + 1', \
        '    continue', \
        '    break', \
        'endwhile', \
        'for value, ixValue in [1, 2, 3]:  # comment', \
        '    break', \
        'endfor', \
        'jump done', \
        'jumpif (a >= 10) done', \
        'done:', \
        'return a' \
    ])
    script = objectGet(parseResult, 'result')
    unittestEqual(objectGet(parseResult, 'error'), null)
    unittestDeepEqual(barescriptValidateScriptEx(script), {'result': script})

    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserValidateScript')
