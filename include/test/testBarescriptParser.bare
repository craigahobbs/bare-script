function testBarescriptParserExprPrecedence():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'a = 1 + 2 * 3', \
            'b = 1 * 2 + 3 * 4', \
            'c = 2 ** 3 ** 2', \
            'd = 1 - 2 + 3' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'expr': { \
                            'name': 'a', \
                            'expr': { \
                                'binary': { \
                                    'op': '+', \
                                    'left': {'number': 1}, \
                                    'right': {'binary': {'op': '*', 'left': {'number': 2}, 'right': {'number': 3}}} \
                                } \
                            }, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    { \
                        'expr': { \
                            'name': 'b', \
                            'expr': { \
                                'binary': { \
                                    'op': '+', \
                                    'left': {'binary': {'op': '*', 'left': {'number': 1}, 'right': {'number': 2}}}, \
                                    'right': {'binary': {'op': '*', 'left': {'number': 3}, 'right': {'number': 4}}} \
                                } \
                            }, \
                            'lineNumber': 2 \
                        } \
                    }, \
                    { \
                        'expr': { \
                            'name': 'c', \
                            'expr': { \
                                'binary': { \
                                    'op': '**', \
                                    'left': {'binary': {'op': '**', 'left': {'number': 2}, 'right': {'number': 3}}}, \
                                    'right': {'number': 2} \
                                } \
                            }, \
                            'lineNumber': 3 \
                        } \
                    }, \
                    { \
                        'expr': { \
                            'name': 'd', \
                            'expr': { \
                                'binary': { \
                                    'op': '+', \
                                    'left': {'binary': {'op': '-', 'left': {'number': 1}, 'right': {'number': 2}}}, \
                                    'right': {'number': 3} \
                                } \
                            }, \
                            'lineNumber': 4 \
                        } \
                    } \
                ], \
                'scriptLines': ['a = 1 + 2 * 3', 'b = 1 * 2 + 3 * 4', 'c = 2 ** 3 ** 2', 'd = 1 - 2 + 3'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserExprPrecedence')


function testBarescriptParserExprReorder():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'a = 1 && b == c + d * e', \
            'b = a * b + c < d' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'expr': { \
                            'name': 'a', \
                            'expr': { \
                                'binary': { \
                                    'op': '&&', \
                                    'left': {'number': 1}, \
                                    'right': { \
                                        'binary': { \
                                            'op': '==', \
                                            'left': {'variable': 'b'}, \
                                            'right': { \
                                                'binary': { \
                                                    'op': '+', \
                                                    'left': {'variable': 'c'}, \
                                                    'right': { \
                                                        'binary': { \
                                                            'op': '*', \
                                                            'left': {'variable': 'd'}, \
                                                            'right': {'variable': 'e'} \
                                                        } \
                                                    } \
                                                } \
                                            } \
                                        } \
                                    } \
                                } \
                            }, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    { \
                        'expr': { \
                            'name': 'b', \
                            'expr': { \
                                'binary': { \
                                    'op': '<', \
                                    'left': { \
                                        'binary': { \
                                            'op': '+', \
                                            'left': { \
                                                'binary': { \
                                                    'op': '*', \
                                                    'left': {'variable': 'a'}, \
                                                    'right': {'variable': 'b'} \
                                                } \
                                            }, \
                                            'right': {'variable': 'c'} \
                                        } \
                                    }, \
                                    'right': {'variable': 'd'} \
                                } \
                            }, \
                            'lineNumber': 2 \
                        } \
                    } \
                ], \
                'scriptLines': ['a = 1 && b == c + d * e', 'b = a * b + c < d'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserExprReorder')


function testBarescriptParserExprBinaryOperators():
    unittestMockAll()
    for op in ['**', '*', '/', '%', '+', '-', '<<', '>>', '<=', '<', '>=', '>', '==', '!=', '&&', '||', '&', '^', '|']:
        unittestDeepEqual( \
            barescriptParseExpressionEx('a ' + op + ' b'), \
            {'result': {'binary': {'op': op, 'left': {'variable': 'a'}, 'right': {'variable': 'b'}}}}, \
            'op ' + op \
        )
    endfor
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserExprBinaryOperators')


function testBarescriptParserExprBitwisePrecedence():
    unittestMockAll()

    # Shift operators after additive
    unittestDeepEqual( \
        barescriptParseExpressionEx('1 + 2 << 3'), \
        { \
            'result': { \
                'binary': { \
                    'op': '<<', \
                    'left': {'binary': {'op': '+', 'left': {'number': 1}, 'right': {'number': 2}}}, \
                    'right': {'number': 3} \
                } \
            } \
        } \
    )

    # Bitwise after equality
    unittestDeepEqual( \
        barescriptParseExpressionEx('1 == 2 & 3'), \
        { \
            'result': { \
                'binary': { \
                    'op': '&', \
                    'left': {'binary': {'op': '==', 'left': {'number': 1}, 'right': {'number': 2}}}, \
                    'right': {'number': 3} \
                } \
            } \
        } \
    )

    # Bitwise AND before XOR and OR
    unittestDeepEqual( \
        barescriptParseExpressionEx('1 & 2 ^ 3 | 4'), \
        { \
            'result': { \
                'binary': { \
                    'op': '|', \
                    'left': { \
                        'binary': { \
                            'op': '^', \
                            'left': {'binary': {'op': '&', 'left': {'number': 1}, 'right': {'number': 2}}}, \
                            'right': {'number': 3} \
                        } \
                    }, \
                    'right': {'number': 4} \
                } \
            } \
        } \
    )

    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserExprBitwisePrecedence')


function testBarescriptParserExprFunctionSingleChar():
    unittestMockAll()

    # Regression: a single-character function name must parse as a call (not fail)
    unittestDeepEqual( \
        barescriptParseExpressionEx('f()'), \
        {'result': {'function': {'name': 'f', 'args': []}}} \
    )

    # ...including immediately after a unary operator and as an operand
    unittestDeepEqual( \
        barescriptParseExpressionEx('-f()'), \
        {'result': {'unary': {'op': '-', 'expr': {'function': {'name': 'f', 'args': []}}}}} \
    )
    unittestDeepEqual( \
        barescriptParseExpressionEx('x + f(1)'), \
        { \
            'result': { \
                'binary': { \
                    'op': '+', \
                    'left': {'variable': 'x'}, \
                    'right': {'function': {'name': 'f', 'args': [{'number': 1}]}} \
                } \
            } \
        } \
    )

    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserExprFunctionSingleChar')


function testBarescriptParserExprGroupUnary():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'a = (1 + 2) * 3', \
            'b = !~-c', \
            'c = -(a + b)' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'expr': { \
                            'name': 'a', \
                            'expr': { \
                                'binary': { \
                                    'op': '*', \
                                    'left': { \
                                        'group': {'binary': {'op': '+', 'left': {'number': 1}, 'right': {'number': 2}}} \
                                    }, \
                                    'right': {'number': 3} \
                                } \
                            }, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    { \
                        'expr': { \
                            'name': 'b', \
                            'expr': { \
                                'unary': { \
                                    'op': '!', \
                                    'expr': { \
                                        'unary': {'op': '~', 'expr': {'unary': {'op': '-', 'expr': {'variable': 'c'}}}} \
                                    } \
                                } \
                            }, \
                            'lineNumber': 2 \
                        } \
                    }, \
                    { \
                        'expr': { \
                            'name': 'c', \
                            'expr': { \
                                'unary': { \
                                    'op': '-', \
                                    'expr': { \
                                        'group': { \
                                            'binary': {'op': '+', 'left': {'variable': 'a'}, 'right': {'variable': 'b'}} \
                                        } \
                                    } \
                                } \
                            }, \
                            'lineNumber': 3 \
                        } \
                    } \
                ], \
                'scriptLines': ['a = (1 + 2) * 3', 'b = !~-c', 'c = -(a + b)'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserExprGroupUnary')


