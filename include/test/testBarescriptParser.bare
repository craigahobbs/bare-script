include '../barescriptModel.bare'
include '../barescriptParser.bare'
include '../unittest.bare'
include '../unittestMock.bare'


function testBarescriptParserScript():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'a = 1', \
            'b = a + 1', \
            'foo(a, b)' \
        ], 1, 'test.bare'), \
        { \
            'result': { \
                'statements': [ \
                    {'expr': {'name': 'a', 'expr': {'number': 1}, 'lineNumber': 1}}, \
                    { \
                        'expr': { \
                            'name': 'b', \
                            'expr': {'binary': {'op': '+', 'left': {'variable': 'a'}, 'right': {'number': 1}}}, \
                            'lineNumber': 2 \
                        } \
                    }, \
                    { \
                        'expr': { \
                            'expr': {'function': {'name': 'foo', 'args': [{'variable': 'a'}, {'variable': 'b'}]}}, \
                            'lineNumber': 3 \
                        } \
                    } \
                ], \
                'scriptLines': ['a = 1', 'b = a + 1', 'foo(a, b)'], \
                'scriptName': 'test.bare' \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserScript')


function testBarescriptParserScriptString():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx('a = 1\nb = 2'), \
        { \
            'result': { \
                'statements': [ \
                    {'expr': {'name': 'a', 'expr': {'number': 1}, 'lineNumber': 1}}, \
                    {'expr': {'name': 'b', 'expr': {'number': 2}, 'lineNumber': 2}} \
                ], \
                'scriptLines': ['a = 1', 'b = 2'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserScriptString')


function testBarescriptParserScriptStringParts():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'a = 1\nb = 2', \
            'c = 3' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    {'expr': {'name': 'a', 'expr': {'number': 1}, 'lineNumber': 1}}, \
                    {'expr': {'name': 'b', 'expr': {'number': 2}, 'lineNumber': 2}}, \
                    {'expr': {'name': 'c', 'expr': {'number': 3}, 'lineNumber': 3}} \
                ], \
                'scriptLines': ['a = 1', 'b = 2', 'c = 3'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserScriptStringParts')


function testBarescriptParserScriptEmpty():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([]), \
        {'result': {'statements': [], 'scriptLines': []}} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserScriptEmpty')


function testBarescriptParserScriptStartLineNumber():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'a = 1', \
            'jump unknown' \
        ], 10, 'test.bare'), \
        { \
            'result': { \
                'statements': [ \
                    {'expr': {'name': 'a', 'expr': {'number': 1}, 'lineNumber': 1}}, \
                    {'jump': {'label': 'unknown', 'lineNumber': 2}} \
                ], \
                'scriptLines': ['a = 1', 'jump unknown'], \
                'scriptName': 'test.bare' \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserScriptStartLineNumber')


function testBarescriptParserScriptComments():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            '# comment', \
            '', \
            '   ', \
            'a = 1', \
            '  # indented comment' \
        ]), \
        { \
            'result': { \
                'statements': [{'expr': {'name': 'a', 'expr': {'number': 1}, 'lineNumber': 4}}], \
                'scriptLines': ['# comment', '', '   ', 'a = 1', '  # indented comment'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserScriptComments')


function testBarescriptParserScriptContinuation():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'a = 1 + \\', \
            '    2 + \\', \
            '    3', \
            'b = 4' \
        ], 1, 'test.bare'), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'expr': { \
                            'name': 'a', \
                            'expr': { \
                                'binary': { \
                                    'op': '+', \
                                    'left': {'binary': {'op': '+', 'left': {'number': 1}, 'right': {'number': 2}}}, \
                                    'right': {'number': 3} \
                                } \
                            }, \
                            'lineNumber': 1, \
                            'lineCount': 3 \
                        } \
                    }, \
                    {'expr': {'name': 'b', 'expr': {'number': 4}, 'lineNumber': 4}} \
                ], \
                'scriptLines': ['a = 1 + \\', '    2 + \\', '    3', 'b = 4'], \
                'scriptName': 'test.bare' \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserScriptContinuation')


function testBarescriptParserScriptContinuationTrim():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'a = arrayNew( \\', \
            '  1, \\', \
            '  2 \\', \
            ')' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'expr': { \
                            'name': 'a', \
                            'expr': {'function': {'name': 'arrayNew', 'args': [{'number': 1}, {'number': 2}]}}, \
                            'lineNumber': 1, \
                            'lineCount': 4 \
                        } \
                    } \
                ], \
                'scriptLines': ['a = arrayNew( \\', '  1, \\', '  2 \\', ')'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserScriptContinuationTrim')


function testBarescriptParserScriptContinuationComments():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            '# Comments don\'t continue \\', \
            'a = [ \\', \
            '    # Comments are OK within a continuation...', \
            '    1, \\', \
            '    # ...with or without a continuation backslash \\', \
            '    2 \\', \
            ']' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'expr': { \
                            'name': 'a', \
                            'expr': {'function': {'name': 'arrayNew', 'args': [{'number': 1}, {'number': 2}]}}, \
                            'lineNumber': 2, \
                            'lineCount': 6 \
                        } \
                    } \
                ], \
                'scriptLines': [ \
                    '# Comments don\'t continue \\', \
                    'a = [ \\', \
                    '    # Comments are OK within a continuation...', \
                    '    1, \\', \
                    '    # ...with or without a continuation backslash \\', \
                    '    2 \\', \
                    ']' \
                ] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserScriptContinuationComments')


function testBarescriptParserFunction():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'function foo():', \
            '    return', \
            'endfunction' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'function': {'name': 'foo', 'statements': [{'return': {'lineNumber': 2}}], 'lineNumber': 1} \
                    } \
                ], \
                'scriptLines': ['function foo():', '    return', 'endfunction'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserFunction')


function testBarescriptParserFunctionArgs():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'function foo(a, b):', \
            '    return a + b', \
            'endfunction' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'function': { \
                            'name': 'foo', \
                            'statements': [ \
                                { \
                                    'return': { \
                                        'lineNumber': 2, \
                                        'expr': { \
                                            'binary': {'op': '+', 'left': {'variable': 'a'}, 'right': {'variable': 'b'}} \
                                        } \
                                    } \
                                } \
                            ], \
                            'lineNumber': 1, \
                            'args': ['a', 'b'] \
                        } \
                    } \
                ], \
                'scriptLines': ['function foo(a, b):', '    return a + b', 'endfunction'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserFunctionArgs')


function testBarescriptParserFunctionAsync():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'async function foo():', \
            '    return 1', \
            'endfunction' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'function': { \
                            'name': 'foo', \
                            'statements': [{'return': {'lineNumber': 2, 'expr': {'number': 1}}}], \
                            'lineNumber': 1, \
                            'async': true \
                        } \
                    } \
                ], \
                'scriptLines': ['async function foo():', '    return 1', 'endfunction'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserFunctionAsync')


function testBarescriptParserFunctionLastArgArray():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'function foo(a, b...):', \
            '    return b', \
            'endfunction' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'function': { \
                            'name': 'foo', \
                            'statements': [{'return': {'lineNumber': 2, 'expr': {'variable': 'b'}}}], \
                            'lineNumber': 1, \
                            'args': ['a', 'b'], \
                            'lastArgArray': true \
                        } \
                    } \
                ], \
                'scriptLines': ['function foo(a, b...):', '    return b', 'endfunction'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserFunctionLastArgArray')


function testBarescriptParserIfThen():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'if a:', \
            '    b = 1', \
            'endif' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'jump': { \
                            'label': '__barescriptDone0', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': 'a'}}}, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    {'expr': {'name': 'b', 'expr': {'number': 1}, 'lineNumber': 2}}, \
                    {'label': {'name': '__barescriptDone0', 'lineNumber': 3}} \
                ], \
                'scriptLines': ['if a:', '    b = 1', 'endif'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserIfThen')


function testBarescriptParserIfElifElse():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'if a:', \
            '    b = 1', \
            'elif c:', \
            '    b = 2', \
            'elif d:', \
            '    b = 3', \
            'else:', \
            '    b = 4', \
            'endif' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'jump': { \
                            'label': '__barescriptIf0', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': 'a'}}}, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    {'expr': {'name': 'b', 'expr': {'number': 1}, 'lineNumber': 2}}, \
                    {'jump': {'label': '__barescriptDone0', 'lineNumber': 3}}, \
                    {'label': {'name': '__barescriptIf0', 'lineNumber': 3}}, \
                    { \
                        'jump': { \
                            'label': '__barescriptIf1', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': 'c'}}}, \
                            'lineNumber': 3 \
                        } \
                    }, \
                    {'expr': {'name': 'b', 'expr': {'number': 2}, 'lineNumber': 4}}, \
                    {'jump': {'label': '__barescriptDone0', 'lineNumber': 5}}, \
                    {'label': {'name': '__barescriptIf1', 'lineNumber': 5}}, \
                    { \
                        'jump': { \
                            'label': '__barescriptIf2', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': 'd'}}}, \
                            'lineNumber': 5 \
                        } \
                    }, \
                    {'expr': {'name': 'b', 'expr': {'number': 3}, 'lineNumber': 6}}, \
                    {'jump': {'label': '__barescriptDone0', 'lineNumber': 7}}, \
                    {'label': {'name': '__barescriptIf2', 'lineNumber': 7}}, \
                    {'expr': {'name': 'b', 'expr': {'number': 4}, 'lineNumber': 8}}, \
                    {'label': {'name': '__barescriptDone0', 'lineNumber': 9}} \
                ], \
                'scriptLines': [ \
                    'if a:', \
                    '    b = 1', \
                    'elif c:', \
                    '    b = 2', \
                    'elif d:', \
                    '    b = 3', \
                    'else:', \
                    '    b = 4', \
                    'endif' \
                ] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserIfElifElse')


function testBarescriptParserIfElse():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'if a:', \
            '    b = 1', \
            'else:', \
            '    b = 2', \
            'endif' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'jump': { \
                            'label': '__barescriptIf0', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': 'a'}}}, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    {'expr': {'name': 'b', 'expr': {'number': 1}, 'lineNumber': 2}}, \
                    {'jump': {'label': '__barescriptDone0', 'lineNumber': 3}}, \
                    {'label': {'name': '__barescriptIf0', 'lineNumber': 3}}, \
                    {'expr': {'name': 'b', 'expr': {'number': 2}, 'lineNumber': 4}}, \
                    {'label': {'name': '__barescriptDone0', 'lineNumber': 5}} \
                ], \
                'scriptLines': ['if a:', '    b = 1', 'else:', '    b = 2', 'endif'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserIfElse')


function testBarescriptParserWhile():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'while a:', \
            '    a = a - 1', \
            'endwhile' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'jump': { \
                            'label': '__barescriptDone0', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': 'a'}}}, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    {'label': {'name': '__barescriptLoop0', 'lineNumber': 1}}, \
                    { \
                        'expr': { \
                            'name': 'a', \
                            'expr': {'binary': {'op': '-', 'left': {'variable': 'a'}, 'right': {'number': 1}}}, \
                            'lineNumber': 2 \
                        } \
                    }, \
                    {'jump': {'label': '__barescriptLoop0', 'expr': {'variable': 'a'}, 'lineNumber': 3}}, \
                    {'label': {'name': '__barescriptDone0', 'lineNumber': 3}} \
                ], \
                'scriptLines': ['while a:', '    a = a - 1', 'endwhile'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserWhile')


function testBarescriptParserWhileBreakContinue():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'while a:', \
            '    if b:', \
            '        break', \
            '    endif', \
            '    if c:', \
            '        continue', \
            '    endif', \
            'endwhile' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'jump': { \
                            'label': '__barescriptDone0', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': 'a'}}}, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    {'label': {'name': '__barescriptLoop0', 'lineNumber': 1}}, \
                    { \
                        'jump': { \
                            'label': '__barescriptDone1', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': 'b'}}}, \
                            'lineNumber': 2 \
                        } \
                    }, \
                    {'jump': {'label': '__barescriptDone0', 'lineNumber': 3}}, \
                    {'label': {'name': '__barescriptDone1', 'lineNumber': 4}}, \
                    { \
                        'jump': { \
                            'label': '__barescriptDone2', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': 'c'}}}, \
                            'lineNumber': 5 \
                        } \
                    }, \
                    {'jump': {'label': '__barescriptContinue0', 'lineNumber': 6}}, \
                    {'label': {'name': '__barescriptDone2', 'lineNumber': 7}}, \
                    {'label': {'name': '__barescriptContinue0', 'lineNumber': 8}}, \
                    {'jump': {'label': '__barescriptLoop0', 'expr': {'variable': 'a'}, 'lineNumber': 8}}, \
                    {'label': {'name': '__barescriptDone0', 'lineNumber': 8}} \
                ], \
                'scriptLines': [ \
                    'while a:', \
                    '    if b:', \
                    '        break', \
                    '    endif', \
                    '    if c:', \
                    '        continue', \
                    '    endif', \
                    'endwhile' \
                ] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserWhileBreakContinue')


function testBarescriptParserFor():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'for x in a:', \
            '    foo(x)', \
            'endfor' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    {'expr': {'name': '__barescriptValues0', 'expr': {'variable': 'a'}, 'lineNumber': 1}}, \
                    { \
                        'expr': { \
                            'name': '__barescriptLength0', \
                            'expr': { \
                                'function': {'name': 'arrayLength', 'args': [{'variable': '__barescriptValues0'}]} \
                            }, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    { \
                        'jump': { \
                            'label': '__barescriptDone0', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': '__barescriptLength0'}}}, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    {'expr': {'name': '__barescriptIndex0', 'expr': {'number': 0}, 'lineNumber': 1}}, \
                    {'label': {'name': '__barescriptLoop0', 'lineNumber': 1}}, \
                    { \
                        'expr': { \
                            'name': 'x', \
                            'expr': { \
                                'function': { \
                                    'name': 'arrayGet', \
                                    'args': [{'variable': '__barescriptValues0'}, {'variable': '__barescriptIndex0'}] \
                                } \
                            }, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    { \
                        'expr': {'expr': {'function': {'name': 'foo', 'args': [{'variable': 'x'}]}}, 'lineNumber': 2} \
                    }, \
                    { \
                        'expr': { \
                            'name': '__barescriptIndex0', \
                            'expr': { \
                                'binary': { \
                                    'op': '+', \
                                    'left': {'variable': '__barescriptIndex0'}, \
                                    'right': {'number': 1} \
                                } \
                            }, \
                            'lineNumber': 3 \
                        } \
                    }, \
                    { \
                        'jump': { \
                            'label': '__barescriptLoop0', \
                            'expr': { \
                                'binary': { \
                                    'op': '<', \
                                    'left': {'variable': '__barescriptIndex0'}, \
                                    'right': {'variable': '__barescriptLength0'} \
                                } \
                            }, \
                            'lineNumber': 3 \
                        } \
                    }, \
                    {'label': {'name': '__barescriptDone0', 'lineNumber': 3}} \
                ], \
                'scriptLines': ['for x in a:', '    foo(x)', 'endfor'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserFor')


function testBarescriptParserForIndex():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'for x, ix in a:', \
            '    foo(x, ix)', \
            'endfor' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    {'expr': {'name': '__barescriptValues0', 'expr': {'variable': 'a'}, 'lineNumber': 1}}, \
                    { \
                        'expr': { \
                            'name': '__barescriptLength0', \
                            'expr': { \
                                'function': {'name': 'arrayLength', 'args': [{'variable': '__barescriptValues0'}]} \
                            }, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    { \
                        'jump': { \
                            'label': '__barescriptDone0', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': '__barescriptLength0'}}}, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    {'expr': {'name': 'ix', 'expr': {'number': 0}, 'lineNumber': 1}}, \
                    {'label': {'name': '__barescriptLoop0', 'lineNumber': 1}}, \
                    { \
                        'expr': { \
                            'name': 'x', \
                            'expr': { \
                                'function': { \
                                    'name': 'arrayGet', \
                                    'args': [{'variable': '__barescriptValues0'}, {'variable': 'ix'}] \
                                } \
                            }, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    { \
                        'expr': { \
                            'expr': {'function': {'name': 'foo', 'args': [{'variable': 'x'}, {'variable': 'ix'}]}}, \
                            'lineNumber': 2 \
                        } \
                    }, \
                    { \
                        'expr': { \
                            'name': 'ix', \
                            'expr': {'binary': {'op': '+', 'left': {'variable': 'ix'}, 'right': {'number': 1}}}, \
                            'lineNumber': 3 \
                        } \
                    }, \
                    { \
                        'jump': { \
                            'label': '__barescriptLoop0', \
                            'expr': { \
                                'binary': { \
                                    'op': '<', \
                                    'left': {'variable': 'ix'}, \
                                    'right': {'variable': '__barescriptLength0'} \
                                } \
                            }, \
                            'lineNumber': 3 \
                        } \
                    }, \
                    {'label': {'name': '__barescriptDone0', 'lineNumber': 3}} \
                ], \
                'scriptLines': ['for x, ix in a:', '    foo(x, ix)', 'endfor'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserForIndex')


function testBarescriptParserForBreakContinue():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'for x in a:', \
            '    if b:', \
            '        break', \
            '    endif', \
            '    if c:', \
            '        continue', \
            '    endif', \
            'endfor' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    {'expr': {'name': '__barescriptValues0', 'expr': {'variable': 'a'}, 'lineNumber': 1}}, \
                    { \
                        'expr': { \
                            'name': '__barescriptLength0', \
                            'expr': { \
                                'function': {'name': 'arrayLength', 'args': [{'variable': '__barescriptValues0'}]} \
                            }, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    { \
                        'jump': { \
                            'label': '__barescriptDone0', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': '__barescriptLength0'}}}, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    {'expr': {'name': '__barescriptIndex0', 'expr': {'number': 0}, 'lineNumber': 1}}, \
                    {'label': {'name': '__barescriptLoop0', 'lineNumber': 1}}, \
                    { \
                        'expr': { \
                            'name': 'x', \
                            'expr': { \
                                'function': { \
                                    'name': 'arrayGet', \
                                    'args': [{'variable': '__barescriptValues0'}, {'variable': '__barescriptIndex0'}] \
                                } \
                            }, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    { \
                        'jump': { \
                            'label': '__barescriptDone1', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': 'b'}}}, \
                            'lineNumber': 2 \
                        } \
                    }, \
                    {'jump': {'label': '__barescriptDone0', 'lineNumber': 3}}, \
                    {'label': {'name': '__barescriptDone1', 'lineNumber': 4}}, \
                    { \
                        'jump': { \
                            'label': '__barescriptDone2', \
                            'expr': {'unary': {'op': '!', 'expr': {'variable': 'c'}}}, \
                            'lineNumber': 5 \
                        } \
                    }, \
                    {'jump': {'label': '__barescriptContinue0', 'lineNumber': 6}}, \
                    {'label': {'name': '__barescriptDone2', 'lineNumber': 7}}, \
                    {'label': {'name': '__barescriptContinue0', 'lineNumber': 8}}, \
                    { \
                        'expr': { \
                            'name': '__barescriptIndex0', \
                            'expr': { \
                                'binary': { \
                                    'op': '+', \
                                    'left': {'variable': '__barescriptIndex0'}, \
                                    'right': {'number': 1} \
                                } \
                            }, \
                            'lineNumber': 8 \
                        } \
                    }, \
                    { \
                        'jump': { \
                            'label': '__barescriptLoop0', \
                            'expr': { \
                                'binary': { \
                                    'op': '<', \
                                    'left': {'variable': '__barescriptIndex0'}, \
                                    'right': {'variable': '__barescriptLength0'} \
                                } \
                            }, \
                            'lineNumber': 8 \
                        } \
                    }, \
                    {'label': {'name': '__barescriptDone0', 'lineNumber': 8}} \
                ], \
                'scriptLines': [ \
                    'for x in a:', \
                    '    if b:', \
                    '        break', \
                    '    endif', \
                    '    if c:', \
                    '        continue', \
                    '    endif', \
                    'endfor' \
                ] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserForBreakContinue')


function testBarescriptParserFunctionControlFlow():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'function foo(a):', \
            '    for x in a:', \
            '        while x:', \
            '            break', \
            '        endwhile', \
            '    endfor', \
            'endfunction' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'function': { \
                            'name': 'foo', \
                            'statements': [ \
                                { \
                                    'expr': { \
                                        'name': '__barescriptValues0', \
                                        'expr': {'variable': 'a'}, \
                                        'lineNumber': 2 \
                                    } \
                                }, \
                                { \
                                    'expr': { \
                                        'name': '__barescriptLength0', \
                                        'expr': { \
                                            'function': { \
                                                'name': 'arrayLength', \
                                                'args': [{'variable': '__barescriptValues0'}] \
                                            } \
                                        }, \
                                        'lineNumber': 2 \
                                    } \
                                }, \
                                { \
                                    'jump': { \
                                        'label': '__barescriptDone0', \
                                        'expr': {'unary': {'op': '!', 'expr': {'variable': '__barescriptLength0'}}}, \
                                        'lineNumber': 2 \
                                    } \
                                }, \
                                { \
                                    'expr': {'name': '__barescriptIndex0', 'expr': {'number': 0}, 'lineNumber': 2} \
                                }, \
                                {'label': {'name': '__barescriptLoop0', 'lineNumber': 2}}, \
                                { \
                                    'expr': { \
                                        'name': 'x', \
                                        'expr': { \
                                            'function': { \
                                                'name': 'arrayGet', \
                                                'args': [ \
                                                    {'variable': '__barescriptValues0'}, \
                                                    {'variable': '__barescriptIndex0'} \
                                                ] \
                                            } \
                                        }, \
                                        'lineNumber': 2 \
                                    } \
                                }, \
                                { \
                                    'jump': { \
                                        'label': '__barescriptDone1', \
                                        'expr': {'unary': {'op': '!', 'expr': {'variable': 'x'}}}, \
                                        'lineNumber': 3 \
                                    } \
                                }, \
                                {'label': {'name': '__barescriptLoop1', 'lineNumber': 3}}, \
                                {'jump': {'label': '__barescriptDone1', 'lineNumber': 4}}, \
                                { \
                                    'jump': {'label': '__barescriptLoop1', 'expr': {'variable': 'x'}, 'lineNumber': 5} \
                                }, \
                                {'label': {'name': '__barescriptDone1', 'lineNumber': 5}}, \
                                { \
                                    'expr': { \
                                        'name': '__barescriptIndex0', \
                                        'expr': { \
                                            'binary': { \
                                                'op': '+', \
                                                'left': {'variable': '__barescriptIndex0'}, \
                                                'right': {'number': 1} \
                                            } \
                                        }, \
                                        'lineNumber': 6 \
                                    } \
                                }, \
                                { \
                                    'jump': { \
                                        'label': '__barescriptLoop0', \
                                        'expr': { \
                                            'binary': { \
                                                'op': '<', \
                                                'left': {'variable': '__barescriptIndex0'}, \
                                                'right': {'variable': '__barescriptLength0'} \
                                            } \
                                        }, \
                                        'lineNumber': 6 \
                                    } \
                                }, \
                                {'label': {'name': '__barescriptDone0', 'lineNumber': 6}} \
                            ], \
                            'lineNumber': 1, \
                            'args': ['a'] \
                        } \
                    } \
                ], \
                'scriptLines': [ \
                    'function foo(a):', \
                    '    for x in a:', \
                    '        while x:', \
                    '            break', \
                    '        endwhile', \
                    '    endfor', \
                    'endfunction' \
                ] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserFunctionControlFlow')


