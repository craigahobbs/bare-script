function testBarescriptParserExprStrings():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'a = \'abc\'', \
            'b = "def"', \
            'c = \'it\\\'s \\\\ \\n \\t \\b \\f\'', \
            'd = "dq \\" \\u0041"', \
            'e = \'\'' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    {'expr': {'name': 'a', 'expr': {'string': 'abc'}, 'lineNumber': 1}}, \
                    {'expr': {'name': 'b', 'expr': {'string': 'def'}, 'lineNumber': 2}}, \
                    {'expr': {'name': 'c', 'expr': {'string': 'it\'s \\ \n \t \b \f'}, 'lineNumber': 3}}, \
                    {'expr': {'name': 'd', 'expr': {'string': 'dq " A'}, 'lineNumber': 4}}, \
                    {'expr': {'name': 'e', 'expr': {'string': ''}, 'lineNumber': 5}} \
                ], \
                'scriptLines': [ \
                    'a = \'abc\'', \
                    'b = "def"', \
                    'c = \'it\\\'s \\\\ \\n \\t \\b \\f\'', \
                    'd = "dq \\" \\u0041"', \
                    'e = \'\'' \
                ] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserExprStrings')


function testBarescriptParserExprStringBackslashEnd():
    unittestMockAll()

    # A string ending with an escaped backslash must not swallow the following argument
    unittestDeepEqual( \
        barescriptParseExpressionEx('test(\'abc \\\\\', \'def\')'), \
        {'result': {'function': {'name': 'test', 'args': [{'string': 'abc \\'}, {'string': 'def'}]}}} \
    )
    unittestDeepEqual( \
        barescriptParseExpressionEx('test("abc \\\\", "def")'), \
        {'result': {'function': {'name': 'test', 'args': [{'string': 'abc \\'}, {'string': 'def'}]}}} \
    )

    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserExprStringBackslashEnd')


function testBarescriptParserExprLiterals():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'a = {}', \
            'b = {\'x\': 1, \'y\': [1, 2]}', \
            'c = []', \
            'd = [1, [2, 3]]', \
            'e = foo()', \
            'f = foo(bar(1), 2)' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'expr': { \
                            'name': 'a', \
                            'expr': {'function': {'name': 'objectNew', 'args': []}}, \
                            'lineNumber': 1 \
                        } \
                    }, \
                    { \
                        'expr': { \
                            'name': 'b', \
                            'expr': { \
                                'function': { \
                                    'name': 'objectNew', \
                                    'args': [ \
                                        {'string': 'x'}, \
                                        {'number': 1}, \
                                        {'string': 'y'}, \
                                        { \
                                            'function': {'name': 'arrayNew', 'args': [{'number': 1}, {'number': 2}]} \
                                        } \
                                    ] \
                                } \
                            }, \
                            'lineNumber': 2 \
                        } \
                    }, \
                    { \
                        'expr': {'name': 'c', 'expr': {'function': {'name': 'arrayNew', 'args': []}}, 'lineNumber': 3} \
                    }, \
                    { \
                        'expr': { \
                            'name': 'd', \
                            'expr': { \
                                'function': { \
                                    'name': 'arrayNew', \
                                    'args': [ \
                                        {'number': 1}, \
                                        { \
                                            'function': {'name': 'arrayNew', 'args': [{'number': 2}, {'number': 3}]} \
                                        } \
                                    ] \
                                } \
                            }, \
                            'lineNumber': 4 \
                        } \
                    }, \
                    { \
                        'expr': {'name': 'e', 'expr': {'function': {'name': 'foo', 'args': []}}, 'lineNumber': 5} \
                    }, \
                    { \
                        'expr': { \
                            'name': 'f', \
                            'expr': { \
                                'function': { \
                                    'name': 'foo', \
                                    'args': [{'function': {'name': 'bar', 'args': [{'number': 1}]}}, {'number': 2}] \
                                } \
                            }, \
                            'lineNumber': 6 \
                        } \
                    } \
                ], \
                'scriptLines': [ \
                    'a = {}', \
                    'b = {\'x\': 1, \'y\': [1, 2]}', \
                    'c = []', \
                    'd = [1, [2, 3]]', \
                    'e = foo()', \
                    'f = foo(bar(1), 2)' \
                ] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserExprLiterals')


function testBarescriptParserExprComment():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'a = 1 + 2  # comment' \
        ]), \
        { \
            'result': { \
                'statements': [ \
                    { \
                        'expr': { \
                            'name': 'a', \
                            'expr': {'binary': {'op': '+', 'left': {'number': 1}, 'right': {'number': 2}}}, \
                            'lineNumber': 1 \
                        } \
                    } \
                ], \
                'scriptLines': ['a = 1 + 2  # comment'] \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserExprComment')


function testBarescriptParserErrorNestedFunction():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'function outer():', \
            'function inner():', \
            'endfunction', \
            'endfunction' \
        ], 1, 'test.bare'), \
        { \
            'error': { \
                'error': 'Nested function definition', \
                'line': 'function inner():', \
                'columnNumber': 1, \
                'lineNumber': 2, \
                'scriptName': 'test.bare', \
                'message': 'test.bare:2: Nested function definition\nfunction inner():\n^\n' \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserErrorNestedFunction')


