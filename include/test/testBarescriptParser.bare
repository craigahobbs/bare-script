function testBarescriptParserErrorIncludeUnescapedQuote():
    unittestMockAll()
    unittestDeepEqual( \
        barescriptParseScriptEx([ \
            'include \'a\'b\'' \
        ], 1, 'test.bare'), \
        { \
            'error': { \
                'error': 'Syntax error', \
                'line': 'include \'a\'b\'', \
                'columnNumber': 8, \
                'lineNumber': 1, \
                'scriptName': 'test.bare', \
                'message': 'test.bare:1: Syntax error\ninclude \'a\'b\'\n       ^\n' \
            } \
        } \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptParserErrorIncludeUnescapedQuote')


