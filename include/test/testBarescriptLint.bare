    script = barescriptValidateScript({ \
        'statements': [ \
            {'label': {'name': 'testLabel'}}, \
            {'label': {'name': 'testLabel'}}, \
            {'jump': {'label': 'testLabel'}} \
        ] \
    })
    unittestDeepEqual(barescriptLintScript(script), [':1: Redefinition of global label "testLabel"'])
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptLintGlobalLabelRedefined')


function testBarescriptLintFunctionPointlessStatement():
    unittestMockAll()
    script = barescriptValidateScript({ \
        'statements': [ \
            {'function': { \
                'name': 'testFn', \
                'statements': [ \
                    {'expr': {'expr': {'unary': {'op': '!', 'expr': { \
                        'group': {'binary': {'op': '+', 'left': {'number': 0}, 'right': {'function': {'name': 'foo'}}}} \
                    }}}}}, \
                    {'expr': {'expr': {'unary': {'op': '!', 'expr': { \
                        'group': {'binary': {'op': '+', 'left': {'number': 0}, 'right': {'number': 1}}} \
                    }}}}} \
                ] \
            }} \
        ] \
    })
    unittestDeepEqual(barescriptLintScript(script), [':1: Pointless statement in function "testFn"'])
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptLintFunctionPointlessStatement')


function testBarescriptLintGlobalPointlessStatement():
    unittestMockAll()
    script = barescriptValidateScript({ \
        'statements': [ \
            {'expr': {'expr': {'unary': {'op': '!', 'expr': { \
                'group': {'binary': {'op': '+', 'left': {'number': 0}, 'right': {'function': {'name': 'foo'}}}} \
            }}}}}, \
            {'expr': {'expr': {'unary': {'op': '!', 'expr': { \
                'group': {'binary': {'op': '+', 'left': {'number': 0}, 'right': {'number': 1}}} \
            }}}}} \
        ] \
    })
    unittestDeepEqual(barescriptLintScript(script), [':1: Pointless global statement'])
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptLintGlobalPointlessStatement')
