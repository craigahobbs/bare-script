function testBarescriptLintFunctionRequiresAsync():
    unittestMockAll()
    script = barescriptValidateScript({ \
        'statements': [ \
            {'function': { \
                'name': 'testFn', \
                'statements': [ \
                    {'jump': {'label': 'label1'}}, \
                    {'label': {'name': 'label1'}}, \
                    {'jump': {'label': 'label1', 'expr': {'number': 0}}}, \
                    {'return': {'expr': {'unary': {'op': '!', 'expr': { \
                        'group': {'binary': {'op': '+', 'left': {'number': 0}, 'right': {'function': {'name': 'asyncFn'}}}} \
                    }}}}} \
                ] \
            }} \
        ] \
    })
    unittestDeepEqual( \
        barescriptLintScript(script, {'asyncFn': testBarescriptLintAsyncFn}, {'asyncFn': true}), \
        [':1: Function "testFn" requires async'] \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptLintFunctionRequiresAsync')


