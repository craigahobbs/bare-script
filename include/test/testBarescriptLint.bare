function testBarescriptLintFunctionUnecessaryAsync():
    unittestMockAll()
    script = barescriptValidateScript({ \
        'statements': [ \
            {'function': { \
                'name': 'testFn', \
                'async': true, \
                'statements': [ \
                    {'return': {'expr': {'unary': {'op': '!', 'expr': { \
                        'group': {'binary': {'op': '+', 'left': {'number': 0}, 'right': {'function': {'name': 'nonAsyncFn'}}}} \
                    }}}}} \
                ] \
            }}, \
            {'function': { \
                'name': 'testFn2', \
                'statements': [ \
                    {'return': {}} \
                ] \
            }} \
        ] \
    })
    unittestDeepEqual( \
        barescriptLintScript(script, {'nonAsyncFn': testBarescriptLintNonAsyncFn}, {}), \
        [':1: Unecessary async function "testFn"'] \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptLintFunctionUnecessaryAsync')


function testBarescriptLintFunctionUnecessaryAsyncArgOk():
    unittestMockAll()
    script = barescriptValidateScript({ \
        'statements': [ \
            {'function': { \
                'name': 'testFn', \
                'async': true, \
                'statements': [ \
                    {'return': {'expr': {'function': {'name': 'nonAsyncFn', 'args': [{'function': {'name': 'asyncFn'}}]}}}} \
                ] \
            }} \
        ] \
    })
    unittestDeepEqual( \
        barescriptLintScript( \
            script, \
            {'asyncFn': testBarescriptLintAsyncFn, 'nonAsyncFn': testBarescriptLintNonAsyncFn}, \
            {'asyncFn': true} \
        ), \
        [] \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptLintFunctionUnecessaryAsyncArgOk')


