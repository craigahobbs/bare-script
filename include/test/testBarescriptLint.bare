function testBarescriptLintFunctionUnknownGlobal():
    unittestMockAll()
    script = barescriptValidateScript({ \
        'scriptName': 'test.bare', \
        'scriptLines': [ \
            'function testFn(b):', \
            '    a = false', \
            '    a = a', \
            '    a = b', \
            '    a = UNKNOWN', \
            'endfunction' \
        ], \
        'statements': [ \
            {'function': { \
                'name': 'testFn', \
                'args': ['b'], \
                'statements': [ \
                    {'expr': {'name': 'a', 'expr': {'variable': 'false'}, 'lineNumber': 2}}, \
                    {'expr': {'name': 'a', 'expr': {'variable': 'a'}, 'lineNumber': 3}}, \
                    {'expr': {'name': 'a', 'expr': {'variable': 'b'}, 'lineNumber': 4}}, \
                    {'expr': {'name': 'a', 'expr': {'variable': 'UNKNOWN'}, 'lineNumber': 5}} \
                ], \
                'lineNumber': 1 \
            }} \
        ] \
    })
    unittestDeepEqual(barescriptLintScript(script, {}), ['test.bare:5: Unknown global variable "UNKNOWN"'])
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptLintFunctionUnknownGlobal')


