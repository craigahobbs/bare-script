        'scriptName': 'test.bare', \
        'scriptLines': [ \
            'function testFn():', \
            '    a = b', \
            '    b = a', \
            'endfunction' \
        ], \
        'statements': [ \
            {'function': { \
                'name': 'testFn', \
                'statements': [ \
                    {'expr': {'name': 'a', 'expr': {'variable': 'b'}, 'lineNumber': 2}}, \
                    {'expr': {'name': 'b', 'expr': {'variable': 'a'}, 'lineNumber': 3}} \
                ], \
                'lineNumber': 1 \
            }} \
        ] \
    })
    unittestDeepEqual(barescriptLintScript(script), ['test.bare:2: Variable "b" of function "testFn" used before assignment'])
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptLintFunctionVariableUsedBeforeAssignment')


