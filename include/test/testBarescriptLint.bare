include '../barescriptLint.bare'
include '../barescriptModel.bare'
include '../unittest.bare'
include '../unittestMock.bare'


# Helper functions used as global function values for the async lint tests
function testBarescriptLintAsyncFn():
endfunction

function testBarescriptLintNonAsyncFn():
endfunction


function testBarescriptLintEmptyScript():
    unittestMockAll()
    script = barescriptValidateScript({'statements': [], 'scriptName': 'test.bare', 'scriptLines': []})
    unittestDeepEqual(barescriptLintScript(script), ['test.bare:1: Empty script'])
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptLintEmptyScript')


function testBarescriptLintFunctionRedefined():
    unittestMockAll()
    script = barescriptValidateScript({ \
        'statements': [ \
            {'function': {'name': 'testFn', 'statements': [], 'lineNumber': 1}}, \
            {'function': {'name': 'testFn', 'statements': [], 'lineNumber': 4}} \
        ], \
        'scriptName': 'test.bare', \
        'scriptLines': [ \
            'function testFn():', \
            'endfunction', \
            '', \
            'function testFn():', \
            'endfunction' \
        ] \
    })
    unittestDeepEqual(barescriptLintScript(script), ['test.bare:4: Redefinition of function "testFn"'])
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptLintFunctionRedefined')


function testBarescriptLintFunctionDuplicateArgument():
    unittestMockAll()
    script = barescriptValidateScript({ \
        'statements': [ \
            {'function': { \
                'name': 'testFn', \
                'args': ['a', 'b', 'a'], \
                'statements': [ \
                    {'return': { \
                        'expr': {'binary': {'op': '+', 'left': {'variable': 'a'}, 'right': {'variable': 'b'}}}, \
                        'lineNumber': 2 \
                    }} \
                ], \
                'lineNumber': 1 \
            }} \
        ], \
        'scriptName': 'test.bare', \
        'scriptLines': [ \
            'function testFn(a, b, a):', \
            '    return a + b', \
            'endfunction' \
        ] \
    })
    unittestDeepEqual(barescriptLintScript(script), ['test.bare:1: Duplicate argument "a" of function "testFn"'])
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptLintFunctionDuplicateArgument')


