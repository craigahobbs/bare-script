function testBarescriptLintFunctionUnusedVariable():
    unittestMockAll()
    script = barescriptValidateScript({ \
        'scriptName': 'test.bare', \
        'scriptLines': [ \
            'function testFn():', \
            '    a = 1', \
            '    b = 2', \
            '    c = a', \
            '    d = 3', \
            '    jump testLabel if d', \
            '    testLabel:', \
            '    e = -(b + c)', \
            'endfunction' \
        ], \
        'statements': [ \
            {'function': { \
                'name': 'testFn', \
                'statements': [ \
                    {'expr': {'name': 'a', 'expr': {'number': 1}, 'lineNumber': 2}}, \
                    {'expr': {'name': 'b', 'expr': {'number': 2}, 'lineNumber': 3}}, \
                    {'expr': {'name': 'c', 'expr': {'variable': 'a'}, 'lineNumber': 4}}, \
                    {'expr': {'name': 'd', 'expr': {'number': 3}, 'lineNumber': 5}}, \
                    {'jump': {'label': 'testLabel', 'expr': {'variable': 'd'}, 'lineNumber': 6}}, \
                    {'label': {'name': 'testLabel', 'lineNumber': 7}}, \
                    {'expr': {'name': 'e', 'expr': {'unary': { \
                        'op': '-', \
                        'expr': {'group': {'binary': {'op': '+', 'left': {'variable': 'b'}, 'right': {'variable': 'c'}}}} \
                    }}, 'lineNumber': 8}} \
                ], \
                'lineNumber': 1 \
            }} \
        ] \
    })
    unittestDeepEqual(barescriptLintScript(script), ['test.bare:8: Unused variable "e" defined in function "testFn"'])
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testBarescriptLintFunctionUnusedVariable')


