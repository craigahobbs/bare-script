function testSchemaGetReferencedTypesProtoType():
    unittestMockAll()

    # jsonParse builds an own "__proto__" key
    types = jsonParse( \
        '{"MyStruct": {"struct": {"name": "MyStruct", "members": [{"name": "a", "type": {"user": "__proto__"}}]}},' + \
        ' "__proto__": {"struct": {"name": "__proto__", "members": [{"name": "b", "type": {"builtin": "int"}}]}}}' \
    )
    referencedTypes = schemaGetReferencedTypes(types, 'MyStruct')
    unittestDeepEqual(arraySort(objectKeys(referencedTypes)), ['MyStruct', '__proto__'])
    unittestDeepEqual(objectGet(referencedTypes, '__proto__'), objectGet(types, '__proto__'))
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaGetReferencedTypesProtoType')


function testSchemaGetReferencedTypesProtoTypeRecursive():
    unittestMockAll()

    # jsonParse builds an own "__proto__" key
    types = jsonParse( \
        '{"__proto__": {"struct": {"name": "__proto__", "members": [{"name": "a", "type": {"user": "__proto__"}}]}}}' \
    )
    referencedTypes = schemaGetReferencedTypes(types, '__proto__')
    unittestDeepEqual(objectKeys(referencedTypes), ['__proto__'])
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaGetReferencedTypesProtoTypeRecursive')


#
# schemaGetStructMembers tests
#


function testSchemaGetStructMembers():
    unittestMockAll()
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStruct', \
                'members': [ \
                    {'name': 'a', 'type': {'builtin': 'int'}} \
                ] \
            } \
        } \
    }
    struct = objectGet(objectGet(types, 'MyStruct'), 'struct')

    # The returned array is the type model's live members array (not a copy)
    unittestEqual(systemIs(schemaGetStructMembers(types, struct), objectGet(struct, 'members')), true)
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaGetStructMembers')


function testSchemaGetStructMembersBases():
    unittestMockAll()
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStruct', \
                'bases': ['MyStruct2'], \
                'members': [ \
                    {'name': 'a', 'type': {'builtin': 'int'}} \
                ] \
            } \
        }, \
        'MyStruct2': { \
            'struct': { \
                'name': 'MyStruct2', \
                'members': [ \
                    {'name': 'b', 'type': {'builtin': 'string'}} \
                ] \
            } \
        } \
    }
    struct = objectGet(objectGet(types, 'MyStruct'), 'struct')

    # Inherited members come first
    unittestDeepEqual(schemaGetStructMembers(types, struct), [ \
        {'name': 'b', 'type': {'builtin': 'string'}}, \
        {'name': 'a', 'type': {'builtin': 'int'}} \
    ])
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaGetStructMembersBases')


function testSchemaGetStructMembersBaseTypedef():
    unittestMockAll()
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStruct', \
                'bases': ['MyTypedef'], \
                'members': [ \
                    {'name': 'a', 'type': {'builtin': 'int'}} \
                ] \
            } \
        }, \
        'MyTypedef': { \
            'typedef': { \
                'name': 'MyTypedef', \
                'type': {'user': 'MyStruct2'} \
            } \
        }, \
        'MyStruct2': { \
            'struct': { \
                'name': 'MyStruct2', \
                'members': [ \
                    {'name': 'b', 'type': {'builtin': 'string'}} \
                ] \
            } \
        } \
    }
    struct = objectGet(objectGet(types, 'MyStruct'), 'struct')

    # Base typedefs resolve to their underlying struct
    unittestDeepEqual(schemaGetStructMembers(types, struct), [ \
        {'name': 'b', 'type': {'builtin': 'string'}}, \
        {'name': 'a', 'type': {'builtin': 'int'}} \
    ])
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaGetStructMembersBaseTypedef')


