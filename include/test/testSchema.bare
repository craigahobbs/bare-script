function testSchemaValidateDictKeyNullable():
    unittestMockAll()
    types = { \
        'MyEnum': { \
            'enum': { \
                'name': 'MyEnum', \
                'values': [ \
                    {'name': 'A'}, \
                    {'name': 'B'} \
                ] \
            } \
        }, \
        'MyTypedef': { \
            'typedef': { \
                'name': 'MyTypedef', \
                'type': {'dict': {'type': {'builtin': 'int'}, 'keyType': {'user': 'MyEnum'}, 'keyAttr': {'nullable': true}}} \
            } \
        }, \
        'MyTypedef2': { \
            'typedef': { \
                'name': 'MyTypedef2', \
                'type': {'dict': {'type': {'builtin': 'int'}, 'keyType': {'user': 'MyEnum'}}} \
            } \
        } \
    }

    # A nullable-null key becomes the "null" string key
    obj = {'A': 1, 'null': 2}
    unittestDeepEqual(schemaValidate(types, 'MyTypedef', obj), obj)
    unittestDeepEqual( \
        schemaValidateEx(types, 'MyTypedef2', obj), \
        {'error': 'Invalid value "null" (type "string"), expected type "MyEnum"', 'memberFqn': null} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateDictKeyNullable')


function testSchemaValidateDictKeyNullableValueError():
    unittestMockAll()
    # The nullable-null key appears as the "null" string in the member FQN
    obj = {'null': 'bad'}
    unittestDeepEqual( \
        testSchemaValidateExHelper({'dict': {'type': {'builtin': 'int'}, 'keyAttr': {'nullable': true}}}, obj), \
        {'error': 'Invalid value "bad" (type "string") for member "null", expected type "int"', 'memberFqn': 'null'} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateDictKeyNullableValueError')


function testSchemaValidateDictKeyNullableAsString():
    unittestMockAll()
    obj = {'a': 1, 'null': 2, 'c': 3}

    # A nullable-null key round-trips as the "null" string key
    unittestDeepEqual(testSchemaValidateHelper({'dict': {'type': {'builtin': 'int'}, 'keyAttr': {'nullable': true}}}, obj), obj)

    # Without a nullable key attribute, "null" is a valid plain string key
    unittestDeepEqual(testSchemaValidateHelper({'dict': {'type': {'builtin': 'int'}}}, obj), obj)
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateDictKeyNullableAsString')


