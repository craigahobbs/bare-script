function testSchemaValidateInvalidModel():
    unittestMockAll()
    types = { \
        'MyBadBuiltin': { \
            'typedef': { \
                'name': 'MyBadBuiltin', \
                'type': {'builtin': 'foobar'} \
            } \
        }, \
        'MyBadType': { \
            'typedef': { \
                'name': 'MyBadType', \
                'type': {'bad_type_key': 'foobar'} \
            } \
        }, \
        'MyBadUser': { \
            'typedef': { \
                'name': 'MyBadUser', \
                'type': {'user': 'MyBadUserKey'} \
            } \
        }, \
        'MyBadUserKey': { \
            'bad_user_key': {} \
        } \
    }
    unittestEqual(schemaValidate(types, 'MyBadBuiltin', 'abc'), 'abc')
    unittestEqual(schemaValidate(types, 'MyBadType', 'abc'), 'abc')
    unittestEqual(schemaValidate(types, 'MyBadUser', 'abc'), 'abc')
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateInvalidModel')
