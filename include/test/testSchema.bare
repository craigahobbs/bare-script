function testSchemaValidateStructUnion():
    unittestMockAll()
    types = { \
        'MyUnion': { \
            'struct': { \
                'name': 'MyUnion', \
                'members': [ \
                    {'name': 'a', 'type': {'builtin': 'int'}}, \
                    {'name': 'b', 'type': {'builtin': 'string'}} \
                ], \
                'union': true \
            } \
        } \
    }

    unittestDeepEqual(schemaValidate(types, 'MyUnion', {'a': 7}), {'a': 7})
    unittestDeepEqual(schemaValidate(types, 'MyUnion', {'b': 'abc'}), {'b': 'abc'})
    unittestDeepEqual( \
        schemaValidateEx(types, 'MyUnion', {}), \
        {'error': 'Invalid value {} (type "object"), expected type "MyUnion"', 'memberFqn': null} \
    )
    unittestDeepEqual( \
        schemaValidateEx(types, 'MyUnion', {'c': 7}), \
        {'error': 'Unknown member "c"', 'memberFqn': null} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateStructUnion')


function testSchemaValidateStructBase():
    unittestMockAll()
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStruct', \
                'bases': ['MyStruct2'], \
                'members': [ \
                    {'name': 'a', 'type': {'builtin': 'int'}} \
                ] \
            } \
        }, \
        'MyStruct2': { \
            'struct': { \
                'name': 'MyStruct2', \
                'bases': ['MyTypedef'] \
            } \
        }, \
        'MyStruct3': { \
            'struct': { \
                'name': 'MyStruct3', \
                'members': [ \
                    {'name': 'b', 'type': {'builtin': 'int'}} \
                ] \
            } \
        }, \
        'MyTypedef': { \
            'typedef': { \
                'name': 'MyTypedef', \
                'type': {'user': 'MyStruct3'} \
            } \
        } \
    }

    obj = {'a': 7, 'b': 11}
    unittestDeepEqual(schemaValidate(types, 'MyStruct', obj), obj)
    unittestDeepEqual( \
        schemaValidateEx(types, 'MyStruct', {'a': 7}), \
        {'error': 'Required member "b" missing', 'memberFqn': null} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateStructBase')


