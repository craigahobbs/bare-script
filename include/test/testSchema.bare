#
# schemaValidate tests
#


# Helper function to validate a value against a single type
function testSchemaValidateHelper(type, obj):
    types = {'MyTypedef': {'typedef': {'type': type}}}
    return schemaValidate(types, 'MyTypedef', obj)
endfunction


# Helper function to validate a value against a single type, with error reporting
function testSchemaValidateExHelper(type, obj):
    types = {'MyTypedef': {'typedef': {'type': type}}}
    return schemaValidateEx(types, 'MyTypedef', obj)
endfunction


function testSchemaValidateMemberFqn():
    unittestMockAll()
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStruct', \
                'members': [ \
                    {'name': 'a', 'type': {'array': {'type': {'builtin': 'int'}}}} \
                ] \
            } \
        } \
    }

    # A root member FQN may be passed
    unittestDeepEqual( \
        schemaValidateEx(types, 'MyStruct', {'a': [1, 'abc']}, 'request'), \
        {'error': 'Invalid value "abc" (type "string") for member "request.a.1", expected type "int"', 'memberFqn': 'request.a.1'} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateMemberFqn')


function testSchemaValidateMemberFqnNonString():
    unittestMockAll()
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStruct', \
                'members': [ \
                    {'name': 'a', 'type': {'array': {'type': {'builtin': 'int'}}}} \
                ] \
            } \
        } \
    }

    # Non-string root member FQN
    unittestDeepEqual( \
        schemaValidateEx(types, 'MyStruct', {'a': [1, 'abc']}, 5), \
        {'error': 'Invalid value "abc" (type "string") for member "5.a.1", expected type "int"', 'memberFqn': '5.a.1'} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateMemberFqnNonString')


function testSchemaValidateMemberFqnEmptyString():
    unittestMockAll()
    types = { \
        'MyTypedef': { \
            'typedef': { \
                'name': 'MyTypedef', \
                'type': {'builtin': 'int'} \
            } \
        } \
    }

    # The member part is omitted for an empty-string FQN
    unittestDeepEqual( \
        schemaValidateEx(types, 'MyTypedef', 'abc', ''), \
        {'error': 'Invalid value "abc" (type "string"), expected type "int"', 'memberFqn': ''} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateMemberFqnEmptyString')


function testSchemaValidateString():
