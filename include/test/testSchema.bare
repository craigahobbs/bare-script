function testSchemaValidateTypedef():
    unittestMockAll()
    types = { \
        'MyTypedef': { \
            'typedef': { \
                'name': 'MyTypedef', \
                'type': {'builtin': 'int'}, \
                'attr': {'gte': 5} \
            } \
        } \
    }
    unittestEqual(schemaValidate(types, 'MyTypedef', 5), 5)
    unittestDeepEqual( \
        schemaValidateEx(types, 'MyTypedef', 4), \
        {'error': 'Invalid value 4 (type "number"), expected type "MyTypedef" [>= 5]', 'memberFqn': null} \
    )
    unittestDeepEqual( \
        schemaValidateEx(types, 'MyTypedef', null), \
        {'error': 'Invalid value null (type "null"), expected type "int"', 'memberFqn': null} \
    )
    unittestDeepEqual( \
        schemaValidateEx(types, 'MyTypedef', 'null'), \
        {'error': 'Invalid value "null" (type "string"), expected type "int"', 'memberFqn': null} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateTypedef')


