#
# schemaValidate struct tests
#


function testSchemaValidateStruct():
    unittestMockAll()
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStruct', \
                'members': [ \
                    {'name': 'a', 'type': {'builtin': 'string'}}, \
                    {'name': 'b', 'type': {'builtin': 'int'}}, \
                    {'name': 'c', 'type': {'builtin': 'float'}}, \
                    {'name': 'd', 'type': {'builtin': 'bool'}}, \
                    {'name': 'e', 'type': {'builtin': 'date'}}, \
                    {'name': 'f', 'type': {'builtin': 'datetime'}}, \
                    {'name': 'g', 'type': {'builtin': 'uuid'}}, \
                    {'name': 'h', 'type': {'builtin': 'any'}}, \
                    {'name': 'i', 'type': {'user': 'MyStruct2'}}, \
                    {'name': 'j', 'type': {'user': 'MyEnum'}}, \
                    {'name': 'k', 'type': {'user': 'MyTypedef'}} \
                ] \
            } \
        }, \
        'MyStruct2': { \
            'struct': { \
                'name': 'MyStruct2', \
                'members': [ \
                    {'name': 'a', 'type': {'builtin': 'string'}}, \
                    {'name': 'b', 'type': {'builtin': 'int'}} \
                ] \
            } \
        }, \
        'MyEnum': { \
            'enum': { \
                'name': 'MyEnum', \
                'values': [ \
                    {'name': 'A'}, \
                    {'name': 'B'} \
                ] \
            } \
        }, \
        'MyTypedef': { \
            'typedef': { \
                'name': 'MyTypedef', \
                'type': {'builtin': 'int'}, \
                'attr': {'gt': 0} \
            } \
        } \
    }

    expected = { \
        'a': 'abc', \
        'b': 7, \
        'c': 7.1, \
        'd': true, \
        'e': datetimeNew(2020, 6, 13), \
        'f': datetimeISOParse('2020-06-13T13:25:00-07:00'), \
        'g': 'a3597528-a253-4c76-bc2d-8da0026cc838', \
        'h': {'foo': 'bar'}, \
        'i': { \
            'a': 'abc', \
            'b': 7 \
        }, \
        'j': 'A', \
        'k': 1 \
    }

    obj = objectCopy(expected)
    unittestDeepEqual(schemaValidate(types, 'MyStruct', obj), expected)

    objString = { \
        'a': 'abc', \
        'b': '7', \
        'c': '7.1', \
        'd': 'true', \
        'e': '2020-06-13', \
        'f': '2020-06-13T13:25:00-07:00', \
        'g': 'a3597528-a253-4c76-bc2d-8da0026cc838', \
        'h': {'foo': 'bar'}, \
        'i': { \
            'a': 'abc', \
            'b': '7' \
        }, \
        'j': 'A', \
        'k': '1' \
    }
    unittestDeepEqual(schemaValidate(types, 'MyStruct', objString), expected)
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateStruct')


