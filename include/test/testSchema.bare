function testSchemaValidateDictProtoKey():
    unittestMockAll()

    # jsonParse builds an own "__proto__" key
    obj = jsonParse('{"__proto__": {"a": 1}, "b": {"c": 2}}')
    obj2 = testSchemaValidateHelper({'dict': {'type': {'dict': {'type': {'builtin': 'int'}}}}}, obj)
    unittestDeepEqual(objectKeys(obj2), ['__proto__', 'b'])
    unittestDeepEqual(objectGet(obj2, '__proto__'), {'a': 1})
    unittestDeepEqual(objectGet(obj2, 'b'), {'c': 2})
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateDictProtoKey')


