function testSchemaValidateStructMemberProto():
    unittestMockAll()
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStruct', \
                'members': [ \
                    {'name': '__proto__', 'type': {'builtin': 'int'}} \
                ] \
            } \
        } \
    }
    obj = schemaValidate(types, 'MyStruct', jsonParse('{"__proto__": 5}'))
    unittestDeepEqual(objectKeys(obj), ['__proto__'])
    unittestEqual(objectGet(obj, '__proto__'), 5)
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateStructMemberProto')


function testSchemaValidateStructNullable():
    unittestMockAll()
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStruct', \
                'members': [ \
                    {'name': 'a', 'type': {'builtin': 'int'}}, \
                    {'name': 'b', 'type': {'builtin': 'int'}, 'attr': {'nullable': true}}, \
                    {'name': 'c', 'type': {'builtin': 'string'}, 'attr': {'nullable': true}}, \
                    {'name': 'd', 'type': {'builtin': 'float'}, 'attr': {'nullable': false}} \
                ] \
            } \
        } \
    }

    obj = {'a': 7, 'b': 8, 'c': 'abc', 'd': 7.1}
    unittestDeepEqual(schemaValidate(types, 'MyStruct', obj), obj)

    obj = {'a': 7, 'b': null, 'c': null, 'd': 7.1}
    unittestDeepEqual(schemaValidate(types, 'MyStruct', obj), obj)

    obj = {'a': 7, 'b': null, 'c': 'null', 'd': 7.1}
    unittestDeepEqual(schemaValidate(types, 'MyStruct', obj), {'a': 7, 'b': null, 'c': null, 'd': 7.1})

    obj = {'a': 7, 'b': 'null', 'c': null, 'd': 7.1}
    unittestDeepEqual(schemaValidate(types, 'MyStruct', obj), {'a': 7, 'b': null, 'c': null, 'd': 7.1})

    unittestDeepEqual( \
        schemaValidateEx(types, 'MyStruct', {'a': null, 'b': null, 'c': null, 'd': 7.1}), \
        {'error': 'Invalid value null (type "null") for member "a", expected type "int"', 'memberFqn': 'a'} \
    )
    unittestDeepEqual( \
        schemaValidateEx(types, 'MyStruct', {'a': 7, 'b': null, 'c': null, 'd': null}), \
        {'error': 'Invalid value null (type "null") for member "d", expected type "float"', 'memberFqn': 'd'} \
    )
    unittestDeepEqual( \
        schemaValidateEx(types, 'MyStruct', {'a': 7, 'c': null, 'd': 7.1}), \
        {'error': 'Required member "b" missing', 'memberFqn': null} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateStructNullable')


function testSchemaValidateStructNullableAttr():
    unittestMockAll()
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStruct', \
                'members': [ \
                    {'name': 'a', 'type': {'builtin': 'int'}}, \
                    {'name': 'b', 'type': {'builtin': 'int'}, 'attr': {'nullable': true, 'lt': 5}} \
                ] \
            } \
        } \
    }

    obj = {'a': 7, 'b': 4}
    unittestDeepEqual(schemaValidate(types, 'MyStruct', obj), obj)

    unittestDeepEqual( \
        schemaValidateEx(types, 'MyStruct', {'a': 7, 'b': 5}), \
        {'error': 'Invalid value 5 (type "number") for member "b", expected type "int" [< 5]', 'memberFqn': 'b'} \
    )

    obj = {'a': 7, 'b': null}
    unittestDeepEqual(schemaValidate(types, 'MyStruct', obj), obj)
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaValidateStructNullableAttr')


