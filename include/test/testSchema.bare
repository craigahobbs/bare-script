function testSchemaGetReferencedTypesAccumulate():
    unittestMockAll()
    types = { \
        'MyTypedef': { \
            'typedef': { \
                'name': 'MyTypedef', \
                'type': {'builtin': 'int'} \
            } \
        }, \
        'MyTypedef2': { \
            'typedef': { \
                'name': 'MyTypedef2', \
                'type': {'builtin': 'int'} \
            } \
        } \
    }
    referencedTypes = schemaGetReferencedTypes(types, 'MyTypedef')
    unittestDeepEqual(schemaGetReferencedTypes(types, 'MyTypedef2', referencedTypes), types)
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaGetReferencedTypesAccumulate')


