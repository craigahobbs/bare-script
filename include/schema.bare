include <schemaUtil.bare>


# $function: schemaGetReferencedTypes
# $group: schema.bare
# $doc: Get a user type's referenced [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='')
# $arg types: The [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='')
# $arg typeName: The type name
# $arg referencedTypes: Optional. A map of referenced user type name to user type model to update.
# $return: The referenced [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='')
function schemaGetReferencedTypes(types, typeName, referencedTypes):
    return schemaGetReferencedTypesHelper(types, {'user': typeName}, if(referencedTypes != null, referencedTypes, {}))
endfunction


# Helper function for schemaGetReferencedTypes
function schemaGetReferencedTypesHelper(types, type, referencedTypes):
    # Array?
    if objectHas(type, 'array'):
        schemaGetReferencedTypesHelper(types, objectGet(objectGet(type, 'array'), 'type'), referencedTypes)

    # Dict?
    elif objectHas(type, 'dict'):
        dict = objectGet(type, 'dict')
        schemaGetReferencedTypesHelper(types, objectGet(dict, 'type'), referencedTypes)
        if objectHas(dict, 'keyType'):
            schemaGetReferencedTypesHelper(types, objectGet(dict, 'keyType'), referencedTypes)
        endif

    # User type?
    elif objectHas(type, 'user'):
        typeName = objectGet(type, 'user')

        # Already encountered?
        if !objectHas(referencedTypes, typeName):
            userType = objectGet(types, typeName)
            objectSet(referencedTypes, typeName, userType)

            # Struct?
            if objectHas(userType, 'struct'):
                struct = objectGet(userType, 'struct')
                if objectHas(struct, 'bases'):
                    for base in objectGet(struct, 'bases'):
                        schemaGetReferencedTypesHelper(types, {'user': base}, referencedTypes)
                    endfor
                endif
                for member in schemaGetStructMembers(types, struct):
                    schemaGetReferencedTypesHelper(types, objectGet(member, 'type'), referencedTypes)
                endfor

            # Enum?
            elif objectHas(userType, 'enum'):
                enum = objectGet(userType, 'enum')
                if objectHas(enum, 'bases'):
                    for base in objectGet(enum, 'bases'):
                        schemaGetReferencedTypesHelper(types, {'user': base}, referencedTypes)
                    endfor
                endif

            # Typedef?
            elif objectHas(userType, 'typedef'):
                schemaGetReferencedTypesHelper(types, objectGet(objectGet(userType, 'typedef'), 'type'), referencedTypes)

            # Action?
            elif objectHas(userType, 'action'):
                action = objectGet(userType, 'action')
                for section in schemaActionSections:
                    if objectHas(action, section):
                        schemaGetReferencedTypesHelper(types, {'user': objectGet(action, section)}, referencedTypes)
                    endif
                endfor
            endif
        endif
    endif

    return referencedTypes
endfunction


# $function: schemaValidate
# $group: schema.bare
# $doc: Validate a value using a schema [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='').
# $doc: Container values are duplicated since some member types are transformed during validation.
# $arg types: The [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='')
# $arg typeName: The type name
# $arg value: The value to validate
# $arg memberFqn: Optional (default is null). The fully-qualified member name (for error messages).
# $return: The validated, transformed value, or null if validation fails
function schemaValidate(types, typeName, value, memberFqn):
    error = {}
    valueNew = schemaValidateTypeHelper(types, {'user': typeName}, value, memberFqn, error)
    if objectHas(error, 'message'):
        systemLogDebug('schema.bare: ' + objectGet(error, 'message'))
        return null
    endif
    return valueNew
endfunction


# $function: schemaValidateEx
# $group: schema.bare
# $doc: Validate a value using a schema [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='')
# $doc: with programmatic error reporting. Container values are duplicated since some member types are
# $doc: transformed during validation.
# $arg types: The [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='')
# $arg typeName: The type name
# $arg value: The value to validate
# $arg memberFqn: Optional (default is null). The fully-qualified member name (for error messages).
# $return: On success, an object with the "result" key set to the validated, transformed value.
# $return: On failure, an object with the "error" key set to the validation error message and the
# $return: "memberFqn" key set to the fully-qualified member name (or null).
function schemaValidateEx(types, typeName, value, memberFqn):
    error = {}
    valueNew = schemaValidateTypeHelper(types, {'user': typeName}, value, memberFqn, error)
    if objectHas(error, 'message'):
        return {'error': objectGet(error, 'message'), 'memberFqn': objectGet(error, 'memberFqn')}
    endif
    return {'result': valueNew}
endfunction


# Regular expressions used by schemaValidateTypeHelper
schemaValidateRegexDate = regexNew('^(?<year>[0-9]{4})-(?<month>[0-9]{2})-(?<day>[0-9]{2})$')
schemaValidateRegexDatetime = regexNew( \
    '^(?<year>[0-9]{4})-(?<month>[0-9]{2})-(?<day>[0-9]{2})' + \
    'T(?<hour>[0-9]{2}):(?<minute>[0-9]{2})(?::(?<second>[0-9]{2})(?:\\.(?<fraction>[0-9]+))?)?' + \
    '(?<tz>Z|(?<tzhour>[+-][0-9]{2}):(?<tzminute>[0-9]{2}))$' \
)
schemaValidateRegexUuid = regexNew('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$', 'i')


# Default dict key type used by schemaValidateTypeHelper
schemaValidateDictKeyTypeDefault = {'builtin': 'string'}


# Helper function to validate a value against a type - on error, sets the error object's
# "message" and "memberFqn" keys and returns null. The type branches are ordered by frequency
# (builtin and user types dominate) since each branch skipped costs an additional test.
function schemaValidateTypeHelper(types, type, value, memberFqn, error):
    valueNew = value
    valueType = systemType(value)

    # Built-in type?
    if objectHas(type, 'builtin'):
        builtin = objectGet(type, 'builtin')

        # string?
        if builtin == 'string':
            # Not a string?
            if valueType != 'string':
                return schemaMemberError(error, type, value, memberFqn, null)
            endif

        # int or float?
        elif builtin == 'int' || builtin == 'float':
            # Convert string?
            if valueType == 'string':
                valueNew = numberParseFloat(value)
                if valueNew == null:
                    return schemaMemberError(error, type, value, memberFqn, null)
                endif

            # Not a number?
            elif valueType != 'number':
                return schemaMemberError(error, type, value, memberFqn, null)
            endif

            # Non-int number?
            if builtin == 'int' && mathFloor(valueNew) != valueNew:
                return schemaMemberError(error, type, value, memberFqn, null)
            endif

        # bool?
        elif builtin == 'bool':
            # Convert string?
            if valueType == 'string':
                if value == 'true':
                    valueNew = true
                elif value == 'false':
                    valueNew = false
                else:
                    return schemaMemberError(error, type, value, memberFqn, null)
                endif

            # Not a bool?
            elif valueType != 'boolean':
                return schemaMemberError(error, type, value, memberFqn, null)
            endif

        # date?
        elif builtin == 'date':
            # Convert string?
            if valueType == 'string':
                mDate = regexMatch(schemaValidateRegexDate, value)
                if mDate == null:
                    return schemaMemberError(error, type, value, memberFqn, null)
                endif
                groups = objectGet(mDate, 'groups')
                year = numberParseInt(objectGet(groups, 'year'))
                month = numberParseInt(objectGet(groups, 'month'))
                day = numberParseInt(objectGet(groups, 'day'))
                valueNew = if(year >= 100, datetimeNew(year, month, day))
                # datetimeNew rolls an out-of-range month/day over (e.g. Feb 30 -> Mar 1), always changing the month; reject that
                if valueNew == null || datetimeMonth(valueNew) != month:
                    return schemaMemberError(error, type, value, memberFqn, null)
                endif

            # Not a date, or a date with a time-of-day?
            elif valueType != 'datetime' || \
                    datetimeHour(value) + datetimeMinute(value) + datetimeSecond(value) + datetimeMillisecond(value) != 0:
                return schemaMemberError(error, type, value, memberFqn, null)
            endif

        # datetime?
        elif builtin == 'datetime':
            # Convert string?
            if valueType == 'string':
                mDatetime = regexMatch(schemaValidateRegexDatetime, value)
                if mDatetime == null:
                    return schemaMemberError(error, type, value, memberFqn, null)
                endif
                groups = objectGet(mDatetime, 'groups')
                year = numberParseInt(objectGet(groups, 'year'))
                month = numberParseInt(objectGet(groups, 'month'))
                day = numberParseInt(objectGet(groups, 'day'))
                second = objectGet(groups, 'second')
                tzHour = objectGet(groups, 'tzhour')
                tzMinute = objectGet(groups, 'tzminute')
                # datetimeNew rolls an out-of-range month/day over (e.g. Feb 30 -> Mar 1), always changing the month; reject that
                if year < 100 || numberParseInt(objectGet(groups, 'hour')) > 23 || numberParseInt(objectGet(groups, 'minute')) > 59 || \
                        (second != null && numberParseInt(second) > 59) || \
                        (tzHour != null && mathAbs(numberParseInt(tzHour)) > 23) || (tzMinute != null && numberParseInt(tzMinute) > 59) || \
                        datetimeMonth(datetimeNew(year, month, day)) != month:
                    return schemaMemberError(error, type, value, memberFqn, null)
                endif

                # Parse the datetime string - normalize omitted seconds and the fraction digit count for datetimeISOParse
                fraction = objectGet(groups, 'fraction')
                valueNew = datetimeISOParse( \
                    stringSlice(value, 0, 16) + if(second != null, ':' + second, ':00') + \
                    if(fraction != null, '.' + stringSlice(fraction, 0, mathMin(6, stringLength(fraction))), '') + objectGet(groups, 'tz') \
                )

            # Not a datetime?
            elif valueType != 'datetime':
                return schemaMemberError(error, type, value, memberFqn, null)
            endif

        # uuid?
        elif builtin == 'uuid':
            if valueType != 'string' || regexMatch(schemaValidateRegexUuid, value) == null:
                return schemaMemberError(error, type, value, memberFqn, null)
            endif
        endif

    # User type?
    elif objectHas(type, 'user'):
        userType = objectGet(types, objectGet(type, 'user'))

        # action?
        if objectHas(userType, 'action'):
            return schemaMemberError(error, type, value, memberFqn, null)
        endif

        # typedef?
        if objectHas(userType, 'typedef'):
            typedef = objectGet(userType, 'typedef')
            typedefAttr = objectGet(typedef, 'attr')

            # Validate the value
            valueNullable = typedefAttr != null && objectGet(typedefAttr, 'nullable')
            if valueNullable && (value == null || value == 'null'):
                valueNew = null
            else:
                valueNew = schemaValidateTypeHelper(types, objectGet(typedef, 'type'), value, memberFqn, error)
                if objectHas(error, 'message'):
                    return null
                endif
                if typedefAttr != null:
                    schemaValidateAttr(type, typedefAttr, valueNew, memberFqn, error)
                    if objectHas(error, 'message'):
                        return null
                    endif
                endif
            endif

        # enum?
        elif objectHas(userType, 'enum'):
            enum = objectGet(userType, 'enum')

            # Not a valid enum value?
            isValid = false
            for enumValue in schemaGetEnumValues(types, enum):
                if value == objectGet(enumValue, 'name'):
                    isValid = true
                    break
                endif
            endfor
            if !isValid:
                return schemaMemberError(error, type, value, memberFqn, null)
            endif

        # struct?
        elif objectHas(userType, 'struct'):
            struct = objectGet(userType, 'struct')

            # Valid value type?
            if value == '':
                valueNew = {}
            elif valueType != 'object':
                return schemaMemberError(error, {'user': objectGet(struct, 'name')}, value, memberFqn, null)
            endif

            # Valid union?
            isUnion = objectGet(struct, 'union')
            if isUnion && arrayLength(objectKeys(valueNew)) != 1:
                return schemaMemberError(error, {'user': objectGet(struct, 'name')}, value, memberFqn, null)
            endif

            # Get the struct members
            members = schemaGetStructMembers(types, struct)

            # Validate the struct members
            valueCopy = {}
            for member in members:
                memberName = objectGet(member, 'name')

                # Missing non-optional member?
                if !objectHas(valueNew, memberName):
                    if !isUnion && !objectGet(member, 'optional'):
                        objectSet(error, 'message', 'Required member "' + schemaMemberFqnString([memberFqn, memberName]) + '" missing')
                        objectSet(error, 'memberFqn', null)
                        return null
                    endif
                else:
                    # Validate the member value
                    memberFqnMember = [memberFqn, memberName]
                    memberType = objectGet(member, 'type')
                    memberAttr = objectGet(member, 'attr')
                    memberValue = objectGet(valueNew, memberName)

                    # No member attributes? Validate the member value directly
                    if memberAttr == null:
                        memberValue = schemaValidateTypeHelper(types, memberType, memberValue, memberFqnMember, error)
                        if objectHas(error, 'message'):
                            return null
                        endif

                    # Nullable null?
                    elif objectGet(memberAttr, 'nullable') && (memberValue == null || memberValue == 'null'):
                        memberValue = null
                    else:
                        memberValue = schemaValidateTypeHelper(types, memberType, memberValue, memberFqnMember, error)
                        if objectHas(error, 'message'):
                            return null
                        endif
                        schemaValidateAttr(memberType, memberAttr, memberValue, memberFqnMember, error)
                        if objectHas(error, 'message'):
                            return null
                        endif
                    endif

                    # Copy the validated member
                    objectSet(valueCopy, memberName, memberValue)

                    # A union value has exactly one member - the remaining members are all skipped
                    if isUnion:
                        break
                    endif
                endif
            endfor

            # Any unknown members?
            if arrayLength(objectKeys(valueCopy)) != arrayLength(objectKeys(valueNew)):
                memberSet = {}
                for member in members:
                    objectSet(memberSet, objectGet(member, 'name'), true)
                endfor
                for valueNewKey in objectKeys(valueNew):
                    if !objectHas(memberSet, valueNewKey):
                        unknownFqn = schemaMemberFqnString([memberFqn, valueNewKey])
                        objectSet(error, 'message', 'Unknown member "' + schemaUtilTruncate(unknownFqn) + '"')
                        objectSet(error, 'memberFqn', null)
                        return null
                    endif
                endfor
            endif

            # Return the validated, transformed copy
            valueNew = valueCopy
        endif

    # array?
    elif objectHas(type, 'array'):
        # Valid value type?
        array = objectGet(type, 'array')
        arrayType = objectGet(array, 'type')
        arrayAttr = objectGet(array, 'attr')
        if value == '':
            valueNew = []
        elif valueType != 'array':
            return schemaMemberError(error, type, value, memberFqn, null)
        endif

        # Validate the array contents
        valueCopy = []
        arrayValueNullable = arrayAttr != null && objectGet(arrayAttr, 'nullable')
        for arrayValue, ixArrayValue in valueNew:
            memberFqnValue = [memberFqn, ixArrayValue]
            if arrayValueNullable && (arrayValue == null || arrayValue == 'null'):
                arrayValue = null
            else:
                arrayValue = schemaValidateTypeHelper(types, arrayType, arrayValue, memberFqnValue, error)
                if objectHas(error, 'message'):
                    return null
                endif
                if arrayAttr != null:
                    schemaValidateAttr(arrayType, arrayAttr, arrayValue, memberFqnValue, error)
                    if objectHas(error, 'message'):
                        return null
                    endif
                endif
            endif
            arrayPush(valueCopy, arrayValue)
        endfor

        # Return the validated, transformed copy
        valueNew = valueCopy

    # dict?
    elif objectHas(type, 'dict'):
        # Valid value type?
        dict = objectGet(type, 'dict')
        dictType = objectGet(dict, 'type')
        dictAttr = objectGet(dict, 'attr')
        dictKeyType = objectGet(dict, 'keyType', schemaValidateDictKeyTypeDefault)
        dictKeyAttr = objectGet(dict, 'keyAttr')
        if value == '':
            valueNew = {}
        elif valueType != 'object':
            return schemaMemberError(error, type, value, memberFqn, null)
        endif

        # Validate the dict key/value pairs
        valueCopy = {}
        dictKeyNullable = dictKeyAttr != null && objectGet(dictKeyAttr, 'nullable')
        dictValueNullable = dictAttr != null && objectGet(dictAttr, 'nullable')
        for dictKey in objectKeys(valueNew):
            dictValue = objectGet(valueNew, dictKey)
            memberFqnKey = [memberFqn, dictKey]

            # Validate the key
            if dictKeyNullable && dictKey == 'null':
                dictKey = null
            else:
                dictKey = schemaValidateTypeHelper(types, dictKeyType, dictKey, memberFqn, error)
                if objectHas(error, 'message'):
                    return null
                endif
                if dictKeyAttr != null:
                    schemaValidateAttr(dictKeyType, dictKeyAttr, dictKey, memberFqn, error)
                    if objectHas(error, 'message'):
                        return null
                    endif
                endif
            endif

            # Validate the value
            if dictValueNullable && (dictValue == null || dictValue == 'null'):
                dictValue = null
            else:
                dictValue = schemaValidateTypeHelper(types, dictType, dictValue, memberFqnKey, error)
                if objectHas(error, 'message'):
                    return null
                endif
                if dictAttr != null:
                    schemaValidateAttr(dictType, dictAttr, dictValue, memberFqnKey, error)
                    if objectHas(error, 'message'):
                        return null
                    endif
                endif
            endif

            # Copy the key/value - a nullable-null key becomes the "null" string key
            objectSet(valueCopy, if(dictKey != null, dictKey, 'null'), dictValue)
        endfor

        # Return the validated, transformed copy
        valueNew = valueCopy
    endif

    return valueNew
endfunction


# Helper function to materialize a member's fully-qualified name string. For performance, member
# FQNs are built lazily as [parent, key] pairs and only converted to strings on error.
function schemaMemberFqnString(memberFqn):
    if memberFqn == null || systemType(memberFqn) == 'string':
        return memberFqn
    endif
    parts = []
    fqnPart = memberFqn
    while systemType(fqnPart) == 'array':
        arrayPush(parts, '' + arrayGet(fqnPart, 1))
        fqnPart = arrayGet(fqnPart, 0)
    endwhile
    if fqnPart != null:
        arrayPush(parts, '' + fqnPart)
    endif
    arrayReverse(parts)
    return arrayJoin(parts, '.')
endfunction


# Helper function to set a member validation error - always returns null
function schemaMemberError(error, type, value, memberFqn, attr):
    memberFqnValue = schemaMemberFqnString(memberFqn)
    memberPart = if(memberFqnValue, ' for member "' + memberFqnValue + '"', '')
    if objectHas(type, 'builtin'):
        typeName = objectGet(type, 'builtin')
    elif objectHas(type, 'array'):
        typeName = 'array'
    elif objectHas(type, 'dict'):
        typeName = 'dict'
    else:
        typeName = objectGet(type, 'user')
    endif
    attrPart = if(attr != null, ' [' + attr + ']', '')
    valueStr = schemaUtilTruncate(jsonStringify(value))
    message = 'Invalid value ' + valueStr + ' (type "' + systemType(value) + '")' + memberPart + \
        ', expected type "' + typeName + '"' + attrPart
    objectSet(error, 'message', message)
    objectSet(error, 'memberFqn', memberFqnValue)
    return null
endfunction


# Helper function to validate a value's attributes - on error, sets the error object's
# "message" and "memberFqn" keys and returns null
function schemaValidateAttr(type, attr, value, memberFqn, error):
    if objectHas(attr, 'eq') && !(value == objectGet(attr, 'eq')):
        return schemaMemberError(error, type, value, memberFqn, '== ' + objectGet(attr, 'eq'))
    endif
    if objectHas(attr, 'lt') && !(value < objectGet(attr, 'lt')):
        return schemaMemberError(error, type, value, memberFqn, '< ' + objectGet(attr, 'lt'))
    endif
    if objectHas(attr, 'lte') && !(value <= objectGet(attr, 'lte')):
        return schemaMemberError(error, type, value, memberFqn, '<= ' + objectGet(attr, 'lte'))
    endif
    if objectHas(attr, 'gt') && !(value > objectGet(attr, 'gt')):
        return schemaMemberError(error, type, value, memberFqn, '> ' + objectGet(attr, 'gt'))
    endif
    if objectHas(attr, 'gte') && !(value >= objectGet(attr, 'gte')):
        return schemaMemberError(error, type, value, memberFqn, '>= ' + objectGet(attr, 'gte'))
    endif
    if objectHas(attr, 'lenEq') || objectHas(attr, 'lenLT') || objectHas(attr, 'lenLTE') || \
            objectHas(attr, 'lenGT') || objectHas(attr, 'lenGTE'):
        valueType = systemType(value)
        if valueType == 'array':
            length = arrayLength(value)
        elif valueType == 'string':
            length = stringLength(value)
        elif valueType == 'object':
            length = arrayLength(objectKeys(value))
        else:
            length = null
        endif
        if objectHas(attr, 'lenEq') && !(length == objectGet(attr, 'lenEq')):
            return schemaMemberError(error, type, value, memberFqn, 'len == ' + objectGet(attr, 'lenEq'))
        endif
        if objectHas(attr, 'lenLT') && !(length < objectGet(attr, 'lenLT')):
            return schemaMemberError(error, type, value, memberFqn, 'len < ' + objectGet(attr, 'lenLT'))
        endif
        if objectHas(attr, 'lenLTE') && !(length <= objectGet(attr, 'lenLTE')):
            return schemaMemberError(error, type, value, memberFqn, 'len <= ' + objectGet(attr, 'lenLTE'))
        endif
        if objectHas(attr, 'lenGT') && !(length > objectGet(attr, 'lenGT')):
            return schemaMemberError(error, type, value, memberFqn, 'len > ' + objectGet(attr, 'lenGT'))
        endif
        if objectHas(attr, 'lenGTE') && !(length >= objectGet(attr, 'lenGTE')):
            return schemaMemberError(error, type, value, memberFqn, 'len >= ' + objectGet(attr, 'lenGTE'))
        endif
    endif
    return null
endfunction


# $function: schemaGetStructMembers
# $group: schema.bare
# $doc: Get a struct's members (inherited members first)
# $arg types: The [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='')
# $arg struct: The [struct model](https://craigahobbs.github.io/bare-script/model/#var.vName='Struct'&var.vURL='')
# $return: The array of [struct member models](https://craigahobbs.github.io/bare-script/model/#var.vName='StructMember'&var.vURL='')
function schemaGetStructMembers(types, struct):
    # No base structs?
    if !objectHas(struct, 'bases'):
        return if(objectHas(struct, 'members'), objectGet(struct, 'members'), [])
    endif

    # Get base struct members
    members = []
    for base in objectGet(struct, 'bases'):
        baseUserType = objectGet(types, base)
        while objectHas(baseUserType, 'typedef'):
            baseUserType = objectGet(types, objectGet(objectGet(objectGet(baseUserType, 'typedef'), 'type'), 'user'))
        endwhile
        arrayExtend(members, schemaGetStructMembers(types, objectGet(baseUserType, 'struct')))
    endfor

    # Add struct members
    if objectHas(struct, 'members'):
        arrayExtend(members, objectGet(struct, 'members'))
    endif

    return members
endfunction


# $function: schemaGetEnumValues
# $group: schema.bare
# $doc: Get an enum's values (inherited values first)
# $arg types: The [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='')
# $arg enum: The [enum model](https://craigahobbs.github.io/bare-script/model/#var.vName='Enum'&var.vURL='')
# $return: The array of [enum value models](https://craigahobbs.github.io/bare-script/model/#var.vName='EnumValue'&var.vURL='')
function schemaGetEnumValues(types, enum):
    # No base enums?
    if !objectHas(enum, 'bases'):
        return if(objectHas(enum, 'values'), objectGet(enum, 'values'), [])
    endif

    # Get base enum values
    values = []
    for base in objectGet(enum, 'bases'):
        baseUserType = objectGet(types, base)
        while objectHas(baseUserType, 'typedef'):
            baseUserType = objectGet(types, objectGet(objectGet(objectGet(baseUserType, 'typedef'), 'type'), 'user'))
        endwhile
        arrayExtend(values, schemaGetEnumValues(types, objectGet(baseUserType, 'enum')))
    endfor

    # Add enum values
    if objectHas(enum, 'values'):
        arrayExtend(values, objectGet(enum, 'values'))
    endif

    return values
endfunction
