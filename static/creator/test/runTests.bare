include <unittest.bare>
include <unittestMock.bare>


# Start coverage
unittestCoverageStart()

# Test includes
include 'testCreator.bare'
include 'testCreatorFrontend.bare'
include 'testCreatorUtil.bare'

# Stop coverage
unittestCoverageStop()

# Test report
return unittestReport({'title': 'BareScript Creator Tests', 'coverageExclude': ['runTests.bare'], 'coverageMin': 100})
