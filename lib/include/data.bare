include <barescriptParser.bare>
include <schema.bare>
include <schemaParser.bare>


# $function: dataParseCSV
# $group: data.bare
# $doc: Parse CSV text to a data array
# $arg text: The CSV text or array of CSV text
# $return: The data array. String values are parsed into typed values; if a value fails to parse as its
# $return: column's type, a debug message is logged and the remaining column values are left as strings.
function dataParseCSV(text):
    # Collect all lines from variadic text arguments
    if systemType(text) == 'array':
        lines = []
        for textPart in arrayFlat(text):
            if textPart != null:
                arrayExtend(lines, stringSplitLines(textPart))
            endif
        endfor
    else:
        lines = stringSplitLines(text)
    endif

    # Filter blank lines and split into rows
    rows = []
    for line in lines:
        # Skip blank lines
        if regexMatch(dataParseCSVBlankLine, line):
            continue
        endif

        # A line with no quoted fields is its comma-separated fields
        if stringIndexOf(line, '"') == -1:
            arrayPush(rows, stringSplit(line, ','))
            continue
        endif

        # Parse the line into fields
        row = []
        linePart = line
        while linePart != null:
            # Quoted field?
            mQuoted = stringStartsWith(linePart, '"') && regexMatch(dataParseCSVQuotedField, linePart)
            if mQuoted:
                groups = objectGet(mQuoted, 'groups')
                arrayPush(row, stringReplace(objectGet(groups, '1'), '""', '"'))

                # Continue parsing fields only on a comma delimiter - at end-of-line the field is the last
                linePart = if(objectGet(groups, '2') == ',', stringSlice(linePart, stringLength(objectGet(groups, '0'))))
                continue
            endif

            # Non-quoted field
            ixComma = stringIndexOf(linePart, ',')
            if ixComma != -1:
                arrayPush(row, stringSlice(linePart, 0, ixComma))
                linePart = stringSlice(linePart, ixComma + 1)
            else:
                arrayPush(row, linePart)
                linePart = null
            endif
        endwhile
        arrayPush(rows, row)
    endfor

    # Assemble data rows
    result = []
    if arrayLength(rows) >= 2:
        # Extract and trim field headers
        fields = []
        for headerField in arrayGet(rows, 0):
            arrayPush(fields, stringTrim(headerField))
        endfor

        # Build data rows
        for row, ixRow in rows:
            if ixRow:
                rowObj = {}
                rowLength = arrayLength(row)
                for field, ixField in fields:
                    objectSet(rowObj, field, if(ixField < rowLength, arrayGet(row, ixField)))
                endfor
                arrayPush(result, rowObj)
            endif
        endfor
    endif

    # Validate the data (as CSV)
    dataValidate(result, true)
    return result
endfunction

dataParseCSVBlankLine = regexNew('^\s*$')
dataParseCSVQuotedField = regexNew('^"((?:""|[^"])*)"(,|\s*$)')


# $function: dataValidate
# $group: data.bare
# $doc: Validate a data array
# $arg data: The data array
# $arg [csv = false]: If true, parse value strings
# $return: The map of field name to field type, or null if the data is invalid
function dataValidate(data, csv):
    result = dataValidateEx(data, csv)
    if objectHas(result, 'error'):
        systemLogDebug('data.bare: dataValidate - ' + objectGet(result, 'error'))
        return null
    endif
    return objectGet(result, 'result')
endfunction


# $function: dataValidateEx
# $group: data.bare
# $doc: Validate a data array with programmatic error reporting
# $arg data: The data array
# $arg [csv = false]: If true, parse value strings
# $return: On success, an object with the "result" key set to the map of field name to field type.
# $return: On failure, an object with the "error" key set to the validation error message.
function dataValidateEx(data, csv):
    # Determine field types - a row with the fields of a row whose field types are all determined is skipped
    types = {}
    fieldsTyped = null
    for row in data:
        fields = objectKeys(row)
        if fields == fieldsTyped:
            continue
        endif
        isTyped = true
        for field in fields:
            if !objectGet(types, field):
                value = objectGet(row, field)
                valueType = systemType(value)
                if valueType == 'boolean':
                    objectSet(types, field, 'boolean')
                elif valueType == 'number':
                    objectSet(types, field, 'number')
                elif valueType == 'datetime':
                    objectSet(types, field, 'datetime')
                elif valueType == 'string':
                    # If we aren't parsing CSV strings, its just a string
                    if !csv:
                        objectSet(types, field, 'string')

                    # If its the null string we can't determine the type yet
                    elif value == '' || value == 'null':
                        objectSet(types, field, null)

                    # Can the string be parsed into another type?
                    elif value == 'true' || value == 'false':
                        objectSet(types, field, 'boolean')
                    elif numberParseFloat(value) != null:
                        objectSet(types, field, 'number')
                    elif datetimeISOParse(value) != null:
                        objectSet(types, field, 'datetime')
                    else:
                        objectSet(types, field, 'string')
                    endif
                endif
                isTyped = isTyped && objectGet(types, field) != null
            endif
        endfor
        if isTyped:
            fieldsTyped = fields
        endif
    endfor

    # Set the type for fields with undetermined type
    for field in objectKeys(types):
        fieldType = objectGet(types, field)
        if fieldType == null:
            objectSet(types, field, 'string')
        endif
    endfor

    # Validate field values (typeKeys ensures fieldType is always set by the fix-up pass above)
    typeKeys = objectKeys(types)
    if !csv:
        for row in data:
            for field in typeKeys:
                value = objectGet(row, field)
                if value != null && systemType(value) != objectGet(types, field):
                    return dataValidateError(field, value, objectGet(types, field))
                endif
            endfor
        endfor
        return {'result': types}
    endif

    # Validate CSV field values, parsing the value strings
    for row in data:
        for field in typeKeys:
            value = objectGet(row, field)
            fieldType = objectGet(types, field)

            # Not a string?
            if systemType(value) != 'string':
                if value != null && systemType(value) != fieldType:
                    return dataValidateError(field, value, fieldType)
                endif

            # String field? Only the null string is parsed
            elif fieldType == 'string':
                if value == 'null':
                    objectSet(row, field, null)
                endif

            # Parse the value string of a typed (non-string) field
            else:
                isNull = value == '' || value == 'null'
                parsedValue = if(isNull, null, if(fieldType == 'number', numberParseFloat(value), \
                    if(fieldType == 'datetime', datetimeISOParse(value), if(value == 'true', true, if(value == 'false', false)))))
                if parsedValue == null && !isNull:
                    return dataValidateError(field, value, fieldType)
                endif
                objectSet(row, field, parsedValue)
            endif
        endfor
    endfor

    return {'result': types}
endfunction


# Helper to create the dataValidateEx field value error result
function dataValidateError(field, value, fieldType):
    return {'error': 'Invalid "' + field + '" field value ' + jsonStringify(value) + ', expected type ' + fieldType}
endfunction


# $function: dataJoin
# $group: data.bare
# $doc: Join two data arrays. A right-row field that collides with a left-row field is renamed
# $doc: with a "2" suffix. For example:
# $doc:
# $doc: ```bare-script
# $doc: include <data.bare>
# $doc:
# $doc: people = [{'name': 'Alice', 'city': 'NY'}, {'name': 'Bob', 'city': 'SF'}]
# $doc: cities = [{'city': 'NY', 'state': 'NY'}, {'city': 'SF', 'state': 'CA'}]
# $doc: joined = dataJoin(people, cities, 'city')
# $doc: # joined is [{'city': 'NY', 'city2': 'NY', 'name': 'Alice', 'state': 'NY'}, ...]
# $doc: ```
# $arg leftData: The left data array
# $arg rightData: The right data array
# $arg joinExpr: The join expression
# $arg [rightExpr = null]:
# $arg rightExpr: The right join expression
# $arg [isLeftJoin = false]: By default, all left rows are included in the result.
# $arg isLeftJoin: If true, left rows with no matching right row are excluded.
# $arg [variables = null]: A variables object for join expression evaluation
# $return: The joined data array
function dataJoin(leftData, rightData, joinExpr, rightExpr, isLeftJoin, variables):
    # Compute the map of right field name to joined row field name (handle collisions)
    leftNames = {}
    for leftRow in leftData:
        objectAssign(leftNames, leftRow)
    endfor

    rightNamesRaw = {}
    for rightRow in rightData:
        objectAssign(rightNamesRaw, rightRow)
    endfor

    rightNames = {}
    rightNamesUsed = {}
    for fieldName in objectKeys(rightNamesRaw):
        if !objectHas(leftNames, fieldName):
            objectSet(rightNames, fieldName, fieldName)
        else:
            ixUnique = 2
            uniqueName = fieldName + ixUnique
            while objectHas(leftNames, uniqueName) || objectHas(rightNamesUsed, uniqueName) || objectHas(rightNamesRaw, uniqueName):
                ixUnique = ixUnique + 1
                uniqueName = fieldName + ixUnique
            endwhile
            objectSet(rightNamesUsed, uniqueName, uniqueName)
            objectSet(rightNames, fieldName, uniqueName)
        endif
    endfor

    # Parse the join expressions
    leftExprParsed = barescriptParseExpression(joinExpr, null, null, false)
    rightExprParsed = if(rightExpr != null, barescriptParseExpression(rightExpr, null, null, false), leftExprParsed)

    # Bucket the right rows, with their fields renamed, by their expression value
    rightCategoryRows = {}
    for rightRow in rightData:
        rightRowVars = if(variables != null, objectAssign(objectCopy(rightRow), variables), rightRow)
        categoryKey = jsonStringify(barescriptEvaluateExpression(rightExprParsed, rightRowVars))
        rightRows = objectGet(rightCategoryRows, categoryKey)
        if rightRows == null:
            rightRows = []
            objectSet(rightCategoryRows, categoryKey, rightRows)
        endif
        rightRowJoin = {}
        for rightFieldName in objectKeys(rightRow):
            objectSet(rightRowJoin, objectGet(rightNames, rightFieldName), objectGet(rightRow, rightFieldName))
        endfor
        arrayPush(rightRows, rightRowJoin)
    endfor

    # Join the left with the right
    resultData = []
    for leftRow in leftData:
        leftRowVars = if(variables != null, objectAssign(objectCopy(leftRow), variables), leftRow)
        categoryKey = jsonStringify(barescriptEvaluateExpression(leftExprParsed, leftRowVars))
        if objectHas(rightCategoryRows, categoryKey):
            for rightRowJoin in objectGet(rightCategoryRows, categoryKey):
                arrayPush(resultData, objectAssign(objectCopy(leftRow), rightRowJoin))
            endfor
        elif !isLeftJoin:
            arrayPush(resultData, objectCopy(leftRow))
        endif
    endfor

    return resultData
endfunction


# $function: dataCalculatedField
# $group: data.bare
# $doc: Add a calculated field to each row of a data array, in place. For example:
# $doc:
# $doc: ```bare-script
# $doc: include <data.bare>
# $doc:
# $doc: data = [{'a': 1, 'b': 2}, {'a': 3, 'b': 4}]
# $doc: dataCalculatedField(data, 'sum', 'a + b')
# $doc: # data is [{'a': 1, 'b': 2, 'sum': 3}, {'a': 3, 'b': 4, 'sum': 7}]
# $doc: ```
# $arg data: The data array
# $arg fieldName: The calculated field name
# $arg expr: The calculated field expression
# $arg [variables = null]: A variables object for the expression evaluation
# $return: The updated data array
function dataCalculatedField(data, fieldName, expr, variables):
    # Parse the calculation expression
    calcExpr = barescriptParseExpression(expr, null, null, false)

    # Compute the calculated field for each row
    if variables != null:
        for row in data:
            objectSet(row, fieldName, barescriptEvaluateExpression(calcExpr, objectAssign(objectCopy(row), variables)))
        endfor
    else:
        for row in data:
            objectSet(row, fieldName, barescriptEvaluateExpression(calcExpr, row))
        endfor
    endif

    return data
endfunction


# $function: dataFilter
# $group: data.bare
# $doc: Filter a data array. The filter expression is evaluated for each row, with the row's fields
# $doc: and the variables object's members as variables. For example:
# $doc:
# $doc: ```bare-script
# $doc: include <data.bare>
# $doc:
# $doc: data = [{'city': 'NY', 'temp': 65}, {'city': 'SF', 'temp': 60}, {'city': 'NY', 'temp': 70}]
# $doc: warm = dataFilter(data, 'city == "NY" && temp > minTemp', {'minTemp': 66})
# $doc: # warm is [{'city': 'NY', 'temp': 70}]
# $doc: ```
# $arg data: The data array
# $arg expr: The filter expression
# $arg [variables = null]: A variables object for the expression evaluation
# $return: The filtered data array
function dataFilter(data, expr, variables):
    result = []

    # Parse the filter expression
    filterExpr = barescriptParseExpression(expr, null, null, false)

    # Filter the data
    if variables != null:
        for row in data:
            if barescriptEvaluateExpression(filterExpr, objectAssign(objectCopy(row), variables)):
                arrayPush(result, row)
            endif
        endfor
    else:
        for row in data:
            if barescriptEvaluateExpression(filterExpr, row):
                arrayPush(result, row)
            endif
        endfor
    endif

    return result
endfunction


# $function: dataAggregate
# $group: data.bare
# $doc: Aggregate a data array. For example:
# $doc:
# $doc: ```bare-script
# $doc: include <data.bare>
# $doc:
# $doc: data = [{'city': 'NY', 'temp': 65}, {'city': 'NY', 'temp': 70}, {'city': 'SF', 'temp': 60}]
# $doc: averages = dataAggregate(data, { \
# $doc:     'categories': ['city'], \
# $doc:     'measures': [{'field': 'temp', 'function': 'average', 'name': 'avgTemp'}] \
# $doc: })
# $doc: # averages is [{'avgTemp': 67.5, 'city': 'NY'}, {'avgTemp': 60, 'city': 'SF'}]
# $doc: ```
# $arg data: The data array
# $arg aggregation: The [aggregation model](model.html#var.vName='DataAggregation')
# $return: The aggregated data array
function dataAggregate(data, aggregation):
    # Validate the aggregation model
    aggregation = schemaValidate(dataAggregationTypes, 'DataAggregation', aggregation)
    if aggregation == null:
        systemLogDebug('data.bare: dataAggregate - invalid aggregation model')
        return null
    endif
    categories = objectGet(aggregation, 'categories')
    measures = objectGet(aggregation, 'measures')

    # Precompute per-measure metadata: [outputName, inputFieldKey, function]
    measureMeta = []
    for measure in measures:
        measureFieldKey = objectGet(measure, 'field')
        arrayPush(measureMeta, [ \
            objectGet(measure, 'name', measureFieldKey), \
            measureFieldKey, \
            objectGet(measure, 'function') \
        ])
    endfor

    # Create the aggregate rows
    categoryRows = {}
    for row in data:
        # Compute the category key
        if categories != null:
            categoryValues = []
            for categoryField in categories:
                arrayPush(categoryValues, objectGet(row, categoryField))
            endfor
            rowKey = jsonStringify(categoryValues)
        else:
            categoryValues = null
            rowKey = ''
        endif

        # Get or create the aggregate row
        aggregateRow = objectGet(categoryRows, rowKey)
        if !aggregateRow:
            aggregateRow = {}
            objectSet(categoryRows, rowKey, aggregateRow)
            if categories != null:
                for categoryField, ixCat in categories:
                    objectSet(aggregateRow, categoryField, arrayGet(categoryValues, ixCat))
                endfor
            endif
            for meta in measureMeta:
                if objectGet(aggregateRow, arrayGet(meta, 0)) == null:
                    objectSet(aggregateRow, arrayGet(meta, 0), [])
                endif
            endfor
        endif

        # Accumulate measure values
        for meta in measureMeta:
            measureValue = objectGet(row, arrayGet(meta, 1))
            if measureValue != null:
                arrayPush(objectGet(aggregateRow, arrayGet(meta, 0)), measureValue)
            endif
        endfor
    endfor

    # Compute the measure aggregate values
    aggregateRows = []
    for categoryRowsKey in objectKeys(categoryRows):
        aggregateRow = objectGet(categoryRows, categoryRowsKey)
        arrayPush(aggregateRows, aggregateRow)
        for meta in measureMeta:
            measureName = arrayGet(meta, 0)
            measureFunc = arrayGet(meta, 2)
            measureValues = objectGet(aggregateRow, measureName)
            if !measureValues:
                objectSet(aggregateRow, measureName, null)
            elif measureFunc == 'count':
                objectSet(aggregateRow, measureName, arrayLength(measureValues))
            elif measureFunc == 'max':
                maxVal = arrayGet(measureValues, 0)
                for val in measureValues:
                    maxVal = if(val > maxVal, val, maxVal)
                endfor
                objectSet(aggregateRow, measureName, maxVal)
            elif measureFunc == 'min':
                minVal = arrayGet(measureValues, 0)
                for val in measureValues:
                    minVal = if(val < minVal, val, minVal)
                endfor
                objectSet(aggregateRow, measureName, minVal)
            elif measureFunc == 'sum':
                objectSet(aggregateRow, measureName, dataAggregateSum(measureValues))
            elif measureFunc == 'stddev':
                avgVal = dataAggregateSum(measureValues) / arrayLength(measureValues)
                sumSqDiff = 0
                for val in measureValues:
                    sumSqDiff = sumSqDiff + (val - avgVal) ** 2
                endfor
                objectSet(aggregateRow, measureName, mathSqrt(sumSqDiff / arrayLength(measureValues)))
            else:
                # measureFunc == 'average'
                objectSet(aggregateRow, measureName, dataAggregateSum(measureValues) / arrayLength(measureValues))
            endif
        endfor
    endfor

    return aggregateRows
endfunction


# Helper to sum an array of numbers
function dataAggregateSum(values):
    sumVal = 0
    for val in values:
        sumVal = sumVal + val
    endfor
    return sumVal
endfunction


# The data aggregation model
dataAggregationTypes = schemaParse( \
    'group "data.bare"', \
    '', \
    '', \
    '# The data aggregation model', \
    'struct DataAggregation', \
    '', \
    '    # The aggregation category fields', \
    '    optional string[len > 0] categories', \
    '', \
    '    # The aggregation measures', \
    '    DataAggregationMeasure[len > 0] measures', \
    '', \
    '', \
    '# The aggregation measure model', \
    'struct DataAggregationMeasure', \
    '', \
    '    # The aggregation measure field', \
    '    string field', \
    '', \
    '    # The aggregation function', \
    '    DataAggregationFunction function', \
    '', \
    '    # The aggregated-measure field name', \
    '    optional string name', \
    '', \
    '', \
    '# The aggregation function enumeration', \
    'enum DataAggregationFunction', \
    '', \
    '    # The average of the measure values', \
    '    average', \
    '', \
    '    # The count of the measure values', \
    '    count', \
    '', \
    '    # The greatest of the measure values', \
    '    max', \
    '', \
    '    # The least of the measure values', \
    '    min', \
    '', \
    '    # The standard deviation of the measure values', \
    '    stddev', \
    '', \
    '    # The sum of the measure values', \
    '    sum' \
)


# $function: dataSort
# $group: data.bare
# $doc: Sort a data array in place. For example:
# $doc:
# $doc: ```bare-script
# $doc: include <data.bare>
# $doc:
# $doc: data = [{'city': 'NY', 'temp': 65}, {'city': 'SF', 'temp': 60}, {'city': 'NY', 'temp': 70}]
# $doc: dataSort(data, [['city'], ['temp', true]])
# $doc: # data is [{'city': 'NY', 'temp': 70}, {'city': 'NY', 'temp': 65}, {'city': 'SF', 'temp': 60}]
# $doc: ```
# $arg data: The data array
# $arg sorts: The array of sort tuples. Each tuple is a one- or two-element array, \[field\] or
# $arg sorts: \[field, descending\]. "field" is the field name to sort by. "descending" is an
# $arg sorts: optional boolean - if true, the field is sorted in descending order (default is
# $arg sorts: ascending).
# $return: The sorted data array
function dataSort(data, sorts):
    # Split the sort tuples into their fields and descending flags
    fields = []
    descendings = []
    for sort in sorts:
        arrayPush(fields, arrayGet(sort, 0))
        arrayPush(descendings, arrayLength(sort) >= 2 && arrayGet(sort, 1))
    endfor
    return arraySort(data, systemPartial(dataSortCompare, fields, descendings))
endfunction


# Helper function for dataSort
function dataSortCompare(fields, descendings, row1, row2):
    for field, ixField in fields:
        result = systemCompare(objectGet(row1, field), objectGet(row2, field))
        if result != 0:
            return if(arrayGet(descendings, ixField), -result, result)
        endif
    endfor
    return 0
endfunction


# $function: dataTop
# $group: data.bare
# $doc: Keep the top rows for each category
# $arg data: The data array
# $arg [count = 1]: The number of rows to keep
# $arg [categoryFields = null]: The category fields
# $return: The top data array
function dataTop(data, count, categoryFields):
    count = if(count != null, count, 1)

    # Bucket rows by category
    categoryRows = {}
    categoryOrder = []
    for row in data:
        if categoryFields != null:
            categoryValues = []
            for field in categoryFields:
                arrayPush(categoryValues, objectGet(row, field))
            endfor
            categoryKey = jsonStringify(categoryValues)
        else:
            categoryKey = ''
        endif

        categoryRow = objectGet(categoryRows, categoryKey)
        if categoryRow == null:
            categoryRow = []
            objectSet(categoryRows, categoryKey, categoryRow)
            arrayPush(categoryOrder, categoryKey)
        endif
        arrayPush(categoryRow, row)
    endfor

    # Take only the top rows per category
    result = []
    for categoryKey in categoryOrder:
        categoryKeyRows = objectGet(categoryRows, categoryKey)
        categoryKeyLength = arrayLength(categoryKeyRows)
        ixRow = 0
        while ixRow < count && ixRow < categoryKeyLength:
            arrayPush(result, arrayGet(categoryKeyRows, ixRow))
            ixRow = ixRow + 1
        endwhile
    endfor

    return result
endfunction
