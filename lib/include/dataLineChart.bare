include <dataUtil.bare>
include <draw.bare>
include <schema.bare>
include <schemaParser.bare>


# The line chart model
dataLineChartTypes = schemaParse( \
    'group "dataLineChart.bare"', \
    '', \
    '', \
    '# A line chart model', \
    'struct DataLineChart', \
    '', \
    '    # The chart title', \
    '    optional string title', \
    '', \
    '    # The chart width', \
    '    optional int width', \
    '', \
    '    # The chart height', \
    '    optional int height', \
    '', \
    '    # The numeric formatting precision. The default is computed from the axis tick step.', \
    '    optional int(>= 0) precision', \
    '', \
    '    # The datetime format. The default is computed from the axis tick step.', \
    '    optional DataLineChartDatetimeFormat datetime', \
    '', \
    "    # The line chart's X-axis field", \
    '    string x', \
    '', \
    "    # The line chart's Y-axis fields", \
    '    string[len > 0] y', \
    '', \
    '    # The color encoding field', \
    '    optional string color', \
    '', \
    '    # The color encoding value order', \
    '    optional string[len > 0] colorOrder', \
    '', \
    '    # The X-axis scale (default is "linear")', \
    '    optional DataLineChartAxisScale xScale', \
    '', \
    '    # The Y-axis scale (default is "linear")', \
    '    optional DataLineChartAxisScale yScale', \
    '', \
    '    # The X-axis numeric tick label format (default is automatic)', \
    '    optional DataLineChartNumberFormat xFormat', \
    '', \
    '    # The Y-axis numeric tick label format (default is automatic)', \
    '    optional DataLineChartNumberFormat yFormat', \
    '', \
    '    # The X-axis minimum value (default is computed from the data)', \
    '    optional any xMin', \
    '', \
    '    # The X-axis maximum value (default is computed from the data)', \
    '    optional any xMax', \
    '', \
    '    # The Y-axis minimum value (default is computed from the data)', \
    '    optional any yMin', \
    '', \
    '    # The Y-axis maximum value (default is computed from the data)', \
    '    optional any yMax', \
    '', \
    '    # The X-axis annotations', \
    '    optional DataLineChartAxisAnnotation[len > 0] xLines', \
    '', \
    '    # The Y-axis annotations', \
    '    optional DataLineChartAxisAnnotation[len > 0] yLines', \
    '', \
    '', \
    '# An axis scale', \
    'enum DataLineChartAxisScale', \
    '', \
    '    # A linear axis scale', \
    '    linear', \
    '', \
    '    # A base-10 logarithmic axis scale. Non-positive values are excluded from the chart.', \
    '    log', \
    '', \
    '', \
    '# A numeric tick label format', \
    'enum DataLineChartNumberFormat', \
    '', \
    '    # Plain decimal notation (e.g. "12000000")', \
    '    decimal', \
    '', \
    '    # SI prefix notation (e.g. "12M"). Values outside the prefix range use exponential notation.', \
    '    si', \
    '', \
    '    # Exponential notation (e.g. "1.2e7")', \
    '    exponential', \
    '', \
    '', \
    '# An axis annotation', \
    'struct DataLineChartAxisAnnotation', \
    '', \
    '    # The axis value', \
    '    any value', \
    '', \
    '    # The annotation label', \
    '    optional string label', \
    '', \
    '', \
    '# A datetime format', \
    'enum DataLineChartDatetimeFormat', \
    '', \
    '    # ISO datetime year format', \
    '    year', \
    '', \
    '    # ISO datetime month format', \
    '    month', \
    '', \
    '    # ISO datetime day format', \
    '    day' \
)


# $function: dataLineChartValidate
# $group: dataLineChart.bare
# $doc: Validate a line chart model
# $arg lineChart: The [line chart model](model.html#var.vName='DataLineChart')
# $return: The validated [line chart model](model.html#var.vName='DataLineChart')
function dataLineChartValidate(lineChart):
    return schemaValidate(dataLineChartTypes, 'DataLineChart', lineChart)
endfunction


# $function: dataLineChartValidateEx
# $group: dataLineChart.bare
# $doc: Validate a line chart model with programmatic error reporting
# $arg lineChart: The [line chart model](model.html#var.vName='DataLineChart')
# $return: On success, an object with the "result" key set to the validated [line chart model](model.html#var.vName='DataLineChart').
# $return: On failure, an object with the "error" key set to the validation error message and the
# $return: "memberFqn" key set to the fully-qualified member name (or null).
function dataLineChartValidateEx(lineChart):
    return schemaValidateEx(dataLineChartTypes, 'DataLineChart', lineChart)
endfunction


# Line chart defaults
dataLineChartDefaultWidth = 640
dataLineChartDefaultHeight = 320


# The categorical color palette - semi-precious stone tones: lapis, carnelian, malachite, garnet
# and amethyst. Color appears in two places in a line chart, both 3 pixels wide: the chart lines
# themselves and the legend's line samples. Color difference shrinks with mark size - by the model
# of Stone, Szafir and Setlur ("An Engineering Model for Color Difference as a Function of Size",
# CIC 2014), extended here to a thin mark by taking the equal-area square of the mark truncated at
# the extent of chromatic summation. The legend sample is the smaller of the two and is what a
# reader matches a line against, so it sets the size: 0.21 degrees, where a lightness difference is
# worth 2.2 times a yellow-blue one of the same magnitude. Five is the most colors that fit at that
# size once color-vision deficiency and the 3:1 contrast minimum for non-text graphics are
# accounted for - a sixth costs 31% of the margin, which is why the sixth series takes a dash
# pattern instead. Within those five the colors are placed as far apart as they will go while
# staying deep and saturated enough to read as stone rather than as screen primaries: no two are
# closer than 1.78 noticeable differences under normal, deuteranope or protanope vision, against
# 1.66 for the palette they replace and 0.11 for Tableau's Classic 10, whose green and red are all
# but identical to a deuteranope. Each keeps a distinct color name and no two are within 4 of each
# other in lightness. Tritanopia is the one deficiency this palette does not solve - garnet and
# amethyst converge there, since purple loses its blue and reads as red - but separating them costs
# the stone character, and no widely used categorical palette handles it either.
dataLineChartCategoricalColors = [ \
    '#1f77b4', \
    '#ff7f0e', \
    '#2ca02c', \
    '#d62728', \
    '#9467bd' \
]


# The line dash patterns. Color is the series encoding - a dash pattern is a second one, so it is
# held back until the colors are used up. Series past the fifth repeat the colors with the next
# pattern, giving twenty-five series before any two are drawn alike.
dataLineChartLineDashArrays = [ \
    'none', \
    '12,6', \
    '3,5', \
    '16,5,3,5', \
    '8,5,3,5' \
]


# Line chart constants (all numbers in pixels)
dataLineChartCoordPrecision = 3
dataLineChartChartFontDefaultSizePx = 16
dataLineChartChartBackgroundColor = 'white'
dataLineChartAxisColor = 'black'
dataLineChartAxisTickLineColor = 'lightgray'
dataLineChartAxisLineWidth = 1
dataLineChartAxisTickWidth = 1
dataLineChartAxisTickLength = 5
dataLineChartAxisSubtickLength = 3
dataLineChartAnnotationBackgroundColor = '#ffffffa0'
dataLineChartAnnotationTextColor = 'black'
dataLineChartAnnotationLineColor = 'black'
dataLineChartAnnotationLineWidth = 2
dataLineChartChartLineWidth = 3
dataLineChartAxisSpaceFraction = 0.4
dataLineChartPlotSpaceFraction = 0.5
dataLineChartEllipsis = '...'
dataLineChartClampEpsilon = 1e-9



# $function: dataLineChart
# $group: dataLineChart.bare
# $doc: Render a line chart
# $arg data: The data array
# $arg lineChart: The [line chart model](model.html#var.vName='DataLineChart')
# $arg options: Optional (default is null). The line chart options object with the following optional members:
# $arg options: - **fontSize** - The font size, in pixels
function dataLineChart(data, lineChart, options):
    if dataLineChartElements(data, lineChart, options) != null:
        drawRender()
    endif
endfunction


# $function: dataLineChartElements
# $group: dataLineChart.bare
# $doc: Render a line chart as an element model
# $arg data: The data array
# $arg lineChart: The [line chart model](model.html#var.vName='DataLineChart')
# $arg options: Optional (default is null). The line chart options object with the following optional members:
# $arg options: - **fontSize** - The font size, in pixels
# $return: The line chart [element model](https://github.com/craigahobbs/element-model#readme)
function dataLineChartElements(data, lineChart, options):
    chartWidth = objectGet(lineChart, 'width', dataLineChartDefaultWidth)
    chartHeight = objectGet(lineChart, 'height', dataLineChartDefaultHeight)
    drawNew(chartWidth, chartHeight)
    if drawLineChart(data, lineChart, 0, 0, chartWidth, chartHeight, options) == null:
        return null
    endif

    # Name the chart for assistive technology, which otherwise reads its tick labels one by one.
    # A chart composed into a drawing of its own is named by whoever owns that drawing.
    drawAriaLabel(dataLineChartAccessibleLabel(lineChart))
    return drawElements()
endfunction


# Helper function to compose a chart's accessible name - the chart's own title when it has one,
# otherwise a description of what the chart plots
function dataLineChartAccessibleLabel(lineChart):
    chartTitle = objectGet(lineChart, 'title')
    if chartTitle != null:
        return chartTitle
    endif
    return 'Line chart of ' + arrayJoin(objectGet(lineChart, 'y'), ', ') + ' by ' + objectGet(lineChart, 'x')
endfunction


# $function: drawLineChart
# $group: dataLineChart.bare
# $doc: Draw a line chart within the current drawing
# $arg data: The data array
# $arg lineChart: The [line chart model](model.html#var.vName='DataLineChart')
# $arg x: The X-coordinate, in pixels, of the left side of the chart
# $arg y: The Y-coordinate, in pixels, of the top of the chart
# $arg width: The width of the chart, in pixels
# $arg height: The height of the chart, in pixels
# $arg options: Optional (default is null). The line chart options object with the following optional members:
# $arg options: - **fontSize** - The font size, in pixels
# $return: true if the chart is drawn, null if the data contains no chartable points
function drawLineChart(data, lineChart, x, y, width, height, options):
    xField = objectGet(lineChart, 'x')
    yFields = objectGet(lineChart, 'y')
    colorField = objectGet(lineChart, 'color')
    colorOrder = objectGet(lineChart, 'colorOrder')
    chartPrecision = objectGet(lineChart, 'precision')
    chartDatetime = objectGet(lineChart, 'datetime')
    xIsLog = objectGet(lineChart, 'xScale') == 'log'
    yIsLog = objectGet(lineChart, 'yScale') == 'log'
    xFormat = objectGet(lineChart, 'xFormat')
    yFormat = objectGet(lineChart, 'yFormat')

    # Determine the font size
    fontSize = if(options != null, objectGet(options, 'fontSize'))
    if !fontSize:
        documentFontSize = systemGlobalGet('documentFontSize')
        fontSize = if(documentFontSize, documentFontSize(), dataLineChartChartFontDefaultSizePx)
    endif

    # Sort the rows by the X field
    arraySort(data, systemPartial(dataLineChartSortCompare, xField))

    # Generate the line points - [{label, color, points}, ...]
    linePoints = []
    xMin = null
    yMin = null
    xMax = null
    yMax = null
    if colorField != null:
        # Determine the set of color encoding values. The rows are sorted by the X field, so the
        # first X value that contributes a point is the minimum and the last is the maximum. A
        # single y-field - the common case - is walked without the per-row field loop, and only a
        # row that contributes a point pays for formatting its color value. A string color value
        # formats to itself, so the format call is skipped for it.
        colorValueSet = {}
        pointsMap = {}
        if arrayLength(yFields) == 1:
            singleField = arrayGet(yFields, 0)
            for row in data:
                xRow = objectGet(row, xField)
                yRow = objectGet(row, singleField)
                if xRow != null && yRow != null && (!xIsLog || xRow > 0) && (!yIsLog || yRow > 0):
                    colorRaw = objectGet(row, colorField)
                    rowKey = if(systemType(colorRaw) == 'string', colorRaw, \
                        dataUtilFormatValue(colorRaw, chartPrecision, chartDatetime))
                    objectSet(colorValueSet, rowKey, true)
                    rowPoints = objectGet(pointsMap, rowKey)
                    if rowPoints == null:
                        rowPoints = []
                        objectSet(pointsMap, rowKey, rowPoints)
                    endif
                    arrayPush(rowPoints, [xRow, yRow])
                    xMin = if(xMin == null, xRow, xMin)
                    yMin = if(yMin == null, yRow, if(yRow < yMin, yRow, yMin))
                    xMax = xRow
                    yMax = if(yMax == null, yRow, if(yRow > yMax, yRow, yMax))
                endif
            endfor
        else:
            for row in data:
                xRow = objectGet(row, xField)
                colorRaw = objectGet(row, colorField)
                colorValue = if(systemType(colorRaw) == 'string', colorRaw, \
                    dataUtilFormatValue(colorRaw, chartPrecision, chartDatetime))
                for yField in yFields:
                    rowKey = yField + ', ' + colorValue
                    yRow = objectGet(row, yField)
                    if xRow != null && yRow != null && (!xIsLog || xRow > 0) && (!yIsLog || yRow > 0):
                        objectSet(colorValueSet, rowKey, true)
                        rowPoints = objectGet(pointsMap, rowKey)
                        if rowPoints == null:
                            rowPoints = []
                            objectSet(pointsMap, rowKey, rowPoints)
                        endif
                        arrayPush(rowPoints, [xRow, yRow])
                        xMin = if(xMin == null, xRow, xMin)
                        yMin = if(yMin == null, yRow, if(yRow < yMin, yRow, yMin))
                        xMax = xRow
                        yMax = if(yMax == null, yRow, if(yRow > yMax, yRow, yMax))
                    endif
                endfor
            endfor
        endif

        # Sort color values
        if colorOrder != null:
            colorValues = arraySort(objectKeys(colorValueSet), systemPartial(dataLineChartColorOrderCompare, colorOrder))
        else:
            colorValues = arraySort(objectKeys(colorValueSet))
        endif

        # Add the points
        for colorValue, ixColorValue in colorValues:
            points = objectGet(pointsMap, colorValue)
            arrayPush(linePoints, { \
                'label': colorValue, \
                'color': dataLineChartSeriesColor(ixColorValue), \
                'dash': dataLineChartSeriesDash(ixColorValue), \
                'points': points \
            })
        endfor
    else:
        # Create a line for each y-field. The rows are walked once rather than once per y-field, so
        # the X field is read and validated a single time for each row however many lines there are.
        fieldPoints = []
        for yField in yFields:
            arrayPush(fieldPoints, [])
        endfor
        # The X range counts only rows that contributed a point, so a chart whose y-fields are all
        # missing still reports no data. The rows are sorted by the X field, so the first such X
        # value is the minimum and the last is the maximum. A single y-field - the common case - is
        # walked without the per-row field loop.
        if arrayLength(yFields) == 1:
            singleField = arrayGet(yFields, 0)
            singlePoints = arrayGet(fieldPoints, 0)
            for row in data:
                xRow = objectGet(row, xField)
                if xRow == null || (xIsLog && xRow <= 0):
                    continue
                endif
                yRow = objectGet(row, singleField)
                if yRow != null && (!yIsLog || yRow > 0):
                    arrayPush(singlePoints, [xRow, yRow])
                    yMin = if(yMin == null, yRow, if(yRow < yMin, yRow, yMin))
                    yMax = if(yMax == null, yRow, if(yRow > yMax, yRow, yMax))
                    xMin = if(xMin == null, xRow, xMin)
                    xMax = xRow
                endif
            endfor
        else:
            for row in data:
                xRow = objectGet(row, xField)
                if xRow == null || (xIsLog && xRow <= 0):
                    continue
                endif

                rowHasPoint = false
                for yField, ixField in yFields:
                    yRow = objectGet(row, yField)
                    if yRow != null && (!yIsLog || yRow > 0):
                        arrayPush(arrayGet(fieldPoints, ixField), [xRow, yRow])
                        yMin = if(yMin == null, yRow, if(yRow < yMin, yRow, yMin))
                        yMax = if(yMax == null, yRow, if(yRow > yMax, yRow, yMax))
                        rowHasPoint = true
                    endif
                endfor

                if rowHasPoint:
                    xMin = if(xMin == null, xRow, xMin)
                    xMax = xRow
                endif
            endfor
        endif

        # Add a line for each y-field that has points
        for yField, ixField in yFields:
            points = arrayGet(fieldPoints, ixField)
            if points:
                arrayPush(linePoints, { \
                    'label': yField, \
                    'color': dataLineChartSeriesColor(ixField), \
                    'dash': dataLineChartSeriesDash(ixField), \
                    'points': points \
                })
            endif
        endfor
    endif
    linePointsReversed = arrayReverse(arrayCopy(linePoints))

    # No data?
    if xMin == null:
        systemLogDebug('dataLineChart.bare - No data')
        return null
    endif

    # Compute the axis annotations - each is an array of [value, label] pairs that may extend the axis range
    yAxisAnnotations = dataLineChartAxisAnnotations(objectGet(lineChart, 'yLines'))
    xAxisAnnotations = dataLineChartAxisAnnotations(objectGet(lineChart, 'xLines'))
    for valueLabel in yAxisAnnotations:
        annotationValue = arrayGet(valueLabel, 0)
        if !yIsLog || annotationValue > 0:
            yMin = mathMin(yMin, annotationValue)
            yMax = mathMax(yMax, annotationValue)
        endif
    endfor
    for valueLabel in xAxisAnnotations:
        annotationValue = arrayGet(valueLabel, 0)
        if !xIsLog || annotationValue > 0:
            xMin = mathMin(xMin, annotationValue)
            xMax = mathMax(xMax, annotationValue)
        endif
    endfor

    # An explicit axis bound replaces the computed one. It is applied after the annotations so that
    # a bound the caller asked for is not widened by an annotation outside it.
    xBounds = dataLineChartAxisBounds(xMin, xMax, objectGet(lineChart, 'xMin'), objectGet(lineChart, 'xMax'))
    yBounds = dataLineChartAxisBounds(yMin, yMax, objectGet(lineChart, 'yMin'), objectGet(lineChart, 'yMax'))
    xMinFixed = arrayGet(xBounds, 0)
    xMaxFixed = arrayGet(xBounds, 1)
    yMinFixed = arrayGet(yBounds, 0)
    yMaxFixed = arrayGet(yBounds, 1)
    xMin = if(xMinFixed != null, xMinFixed, xMin)
    xMax = if(xMaxFixed != null, xMaxFixed, xMax)
    yMin = if(yMinFixed != null, yMinFixed, yMin)
    yMax = if(yMaxFixed != null, yMaxFixed, yMax)

    # Chart title calculations
    chartTitle = objectGet(lineChart, 'title')
    chartBorderSize = fontSize
    chartTitleFontSize = 1.1 * fontSize
    chartTitleHeight = if(chartTitle != null, 1.5 * chartTitleFontSize, 0)

    # Axis calculations
    axisTitleFontSize = fontSize
    axisLabelFontSize = fontSize
    yAxisTitle = if(arrayLength(yFields) == 1, arrayGet(yFields, 0))
    yAxisTitleWidth = if(yAxisTitle != null, 1.8 * axisTitleFontSize, 0)
    xAxisTitleHeight = 1.8 * axisTitleFontSize
    yAxisTickGap = 0.75 * dataLineChartAxisTickLength
    xAxisTickGap = 0.75 * dataLineChartAxisTickLength

    # Vertical chart area calculations
    xAxisY = y + height - chartBorderSize - xAxisTitleHeight - \
        (axisLabelFontSize - xAxisTickGap + dataLineChartAxisTickLength)
    chartTop = y + chartBorderSize + chartTitleHeight + 0.5 * dataLineChartChartLineWidth
    chartBottom = xAxisY - 0.5 * dataLineChartAxisLineWidth - 0.5 * dataLineChartChartLineWidth

    # Compute the Y-axis - a Y-axis tick label is one line of text, so its maximum count is known up front
    yAxis = dataLineChartAxis(yIsLog, yFormat, yMin, yMax, \
        mathMax(2, mathFloor((chartBottom - chartTop) / (2.5 * axisLabelFontSize))), chartPrecision, chartDatetime)
    yAxis = dataLineChartAxisClamp(yAxis, yMinFixed, yMaxFixed)
    yAxisLabelWidth = 0
    for yTickPair in objectGet(yAxis, 'ticks'):
        labelWidth = drawTextWidth(arrayGet(yTickPair, 1), axisLabelFontSize)
        yAxisLabelWidth = if(labelWidth > yAxisLabelWidth, labelWidth, yAxisLabelWidth)
    endfor
    # The Y-axis is placed to leave room for its title and tick labels, but never so far right that
    # the plot area is squeezed away, nor so far left that the tick labels run off the chart
    yAxisLabelSpace = yAxisLabelWidth + yAxisTickGap + dataLineChartAxisTickLength
    yAxisSpace = chartBorderSize + yAxisTitleWidth + yAxisLabelSpace
    yAxisOffset = mathMin(mathMax(mathMin(yAxisSpace, dataLineChartAxisSpaceFraction * width), yAxisLabelSpace), \
        dataLineChartPlotSpaceFraction * width)
    yAxisX = x + yAxisOffset
    yAxisTitleFits = yAxisOffset >= yAxisSpace

    # Color legend calculations
    colorLegendFontSize = fontSize
    colorLegendGap = 0.5 * colorLegendFontSize
    colorLegendLabelHeight = colorLegendFontSize
    colorLegendLabelGap = 0.35 * colorLegendLabelHeight
    colorLegendSampleLength = 2 * colorLegendLabelHeight
    colorLegendSampleWidth = colorLegendSampleLength + 0.4 * colorLegendLabelHeight
    # The legend reads top-to-bottom with the lines, so it is ordered by where each line ends rather
    # than by the color encoding order, which orders the colors
    colorLegendPoints = arraySort(arrayCopy(linePoints), dataLineChartLegendCompare)
    colorLegendLabelWidth = 0
    for linePoint in linePoints:
        labelWidth = drawTextWidth(objectGet(linePoint, 'label'), colorLegendFontSize)
        colorLegendLabelWidth = if(labelWidth > colorLegendLabelWidth, labelWidth, colorLegendLabelWidth)
    endfor
    # The legend is placed to leave room for its labels, but never so far left that the plot area is
    # squeezed away, nor so far right that the labels run off the chart
    colorLegendWidth = colorLegendSampleWidth + colorLegendLabelWidth
    colorLegendX = if(arrayLength(yFields) == 1 && colorField == null, null, \
        mathMax(x + width - chartBorderSize - colorLegendWidth, x + dataLineChartPlotSpaceFraction * width) \
    )
    colorLegendLabelFit = if(colorLegendX != null, x + width - colorLegendX - colorLegendSampleWidth)

    # Horizontal chart area calculations
    chartLeft = yAxisX + 0.5 * dataLineChartAxisLineWidth + 0.5 * dataLineChartChartLineWidth
    chartRight = if(colorLegendX != null, colorLegendX - colorLegendGap, x + width - chartBorderSize)

    # Compute the X-axis - the tick count is reduced until the tick labels fit without overlapping
    xAxisMaxCount = mathMax(2, mathFloor((chartRight - chartLeft) / \
        (drawTextWidth('00000', axisLabelFontSize) + axisLabelFontSize)))
    xAxis = dataLineChartAxis(xIsLog, xFormat, xMin, xMax, xAxisMaxCount, chartPrecision, chartDatetime)
    while xAxisMaxCount > 2 && !dataLineChartAxisLabelsFit(xAxis, chartLeft, chartRight, axisLabelFontSize):
        xAxisMaxCount = xAxisMaxCount - 1
        xAxis = dataLineChartAxis(xIsLog, xFormat, xMin, xMax, xAxisMaxCount, chartPrecision, chartDatetime)
    endwhile
    xAxis = dataLineChartAxisClamp(xAxis, xMinFixed, xMaxFixed)

    # Label the annotations that have no label of their own with their axis's tick label format
    dataLineChartAxisAnnotationLabels(yAxis, yAxisAnnotations, chartPrecision, chartDatetime)
    dataLineChartAxisAnnotationLabels(xAxis, xAxisAnnotations, chartPrecision, chartDatetime)

    # Axis label limits
    xAxisLabelLeft = chartLeft + 0.5 * axisLabelFontSize
    xAxisLabelRight = chartRight - 0.5 * axisLabelFontSize
    yAxisLabelTop = chartTop + 0.5 * axisLabelFontSize
    yAxisLabelBottom = chartBottom - 0.5 * axisLabelFontSize

    # Compute the axis tick mark coordinates - [coordinate, label] pairs
    yTickCoords = dataLineChartAxisTickCoords(yAxis, chartBottom, chartTop)
    xTickCoords = dataLineChartAxisTickCoords(xAxis, chartLeft, chartRight)

    # The axis positions are fixed from here on, so each is rounded to a chart coordinate once
    yAxisXCoord = dataLineChartCoord(yAxisX)
    xAxisYCoord = dataLineChartCoord(xAxisY)

    # Draw the chart background
    drawStyle('none', 0, dataLineChartChartBackgroundColor)
    drawRect(x, y, width, height)

    # Draw the tick mark grid lines
    drawStyle(dataLineChartAxisTickLineColor, dataLineChartAxisTickWidth, 'none')
    for yTickCoord in yTickCoords:
        yPoint = arrayGet(yTickCoord, 0)
        if yPoint > yAxisLabelTop && yPoint < yAxisLabelBottom:
            drawMove(yAxisXCoord, dataLineChartCoord(yPoint))
            drawHLine(dataLineChartCoord(chartRight))
        endif
    endfor
    for xTickCoord in xTickCoords:
        xPoint = arrayGet(xTickCoord, 0)
        if xPoint > xAxisLabelLeft && xPoint < xAxisLabelRight:
            drawMove(dataLineChartCoord(xPoint), xAxisYCoord)
            drawVLine(dataLineChartCoord(chartTop))
        endif
    endfor

    # Draw the axis lines and tick marks
    drawStyle(dataLineChartAxisColor, dataLineChartAxisLineWidth, 'none')
    drawMove(yAxisXCoord, dataLineChartCoord(chartTop - 0.5 * dataLineChartAxisTickWidth))
    drawVLine(xAxisYCoord)
    drawHLine(dataLineChartCoord(chartRight + 0.5 * dataLineChartAxisTickWidth))
    drawStyle(dataLineChartAxisColor, dataLineChartAxisTickWidth, 'none')
    for yTickCoord in yTickCoords:
        drawMove(yAxisXCoord, dataLineChartCoord(arrayGet(yTickCoord, 0)))
        drawHLine(dataLineChartCoord(yAxisX - dataLineChartAxisTickLength))
    endfor
    for ySubtick in objectGet(yAxis, 'subticks'):
        ySubtickPoint = dataLineChartAxisCoord(yAxis, ySubtick, chartBottom, chartTop)
        drawMove(yAxisXCoord, dataLineChartCoord(ySubtickPoint))
        drawHLine(dataLineChartCoord(yAxisX - dataLineChartAxisSubtickLength))
    endfor
    for xTickCoord in xTickCoords:
        drawMove(dataLineChartCoord(arrayGet(xTickCoord, 0)), xAxisYCoord)
        drawVLine(dataLineChartCoord(xAxisY + dataLineChartAxisTickLength))
    endfor
    for xSubtick in objectGet(xAxis, 'subticks'):
        xSubtickPoint = dataLineChartAxisCoord(xAxis, xSubtick, chartLeft, chartRight)
        drawMove(dataLineChartCoord(xSubtickPoint), xAxisYCoord)
        drawVLine(dataLineChartCoord(xAxisY + dataLineChartAxisSubtickLength))
    endfor

    # Draw the chart lines. Clipping is only possible when the caller pinned an axis bound - an
    # automatic axis spans the data, so every point is inside the chart area.
    chartClip = xMinFixed != null || xMaxFixed != null || yMinFixed != null || yMaxFixed != null
    xAxisBase = objectGet(xAxis, 'base')
    yAxisBase = objectGet(yAxis, 'base')
    xAxisRange = objectGet(xAxis, 'range')
    yAxisRange = objectGet(yAxis, 'range')
    xPointScale = if(xAxisRange == 0, 0, (chartRight - chartLeft) / xAxisRange)
    yPointScale = if(yAxisRange == 0, 0, (chartTop - chartBottom) / yAxisRange)
    for linePoint in linePointsReversed:
        drawStyle(objectGet(linePoint, 'color'), dataLineChartChartLineWidth, 'none', objectGet(linePoint, 'dash'))
        linePointPoints = objectGet(linePoint, 'points')
        nPoints = arrayLength(linePointPoints)
        if nPoints == 1:
            point = arrayGet(linePointPoints, 0)
            xPoint = chartLeft + (if(xIsLog, mathLog(arrayGet(point, 0), 10), arrayGet(point, 0)) - xAxisBase) * xPointScale
            yPoint = chartBottom + (if(yIsLog, mathLog(arrayGet(point, 1), 10), arrayGet(point, 1)) - yAxisBase) * yPointScale
            # The marker is centered on the point, so it is drawn whole or not at all - clipping it
            # would render a point at the edge of the axis as a half-width mark
            if xPoint >= chartLeft && xPoint <= chartRight && yPoint >= chartTop && yPoint <= chartBottom:
                drawMove(dataLineChartCoord(xPoint - 0.5 * dataLineChartChartLineWidth), dataLineChartCoord(yPoint))
                drawLine(dataLineChartCoord(xPoint + 0.5 * dataLineChartChartLineWidth), dataLineChartCoord(yPoint))
            endif
        elif !chartClip:
            # Nothing to clip - every point is inside the chart area, so the line is one sub-path
            point = arrayGet(linePointPoints, 0)
            xPoint = chartLeft + (if(xIsLog, mathLog(arrayGet(point, 0), 10), arrayGet(point, 0)) - xAxisBase) * xPointScale
            yPoint = chartBottom + (if(yIsLog, mathLog(arrayGet(point, 1), 10), arrayGet(point, 1)) - yAxisBase) * yPointScale
            drawMove(mathRound(xPoint, dataLineChartCoordPrecision), mathRound(yPoint, dataLineChartCoordPrecision))
            ixPoint = 1
            while ixPoint < nPoints:
                point = arrayGet(linePointPoints, ixPoint)
                xPoint = chartLeft + (if(xIsLog, mathLog(arrayGet(point, 0), 10), arrayGet(point, 0)) - xAxisBase) * xPointScale
                yPoint = chartBottom + (if(yIsLog, mathLog(arrayGet(point, 1), 10), arrayGet(point, 1)) - yAxisBase) * yPointScale
                drawLine(mathRound(xPoint, dataLineChartCoordPrecision), mathRound(yPoint, dataLineChartCoordPrecision))
                ixPoint = ixPoint + 1
            endwhile
        else:
            # Each segment is clipped to the chart area - an explicit axis range can put data outside it
            xPrevious = null
            yPrevious = null
            xLast = null
            yLast = null
            ixPoint = 0
            while ixPoint < nPoints:
                point = arrayGet(linePointPoints, ixPoint)
                xPoint = chartLeft + (if(xIsLog, mathLog(arrayGet(point, 0), 10), arrayGet(point, 0)) - xAxisBase) * xPointScale
                yPoint = chartBottom + (if(yIsLog, mathLog(arrayGet(point, 1), 10), arrayGet(point, 1)) - yAxisBase) * yPointScale
                if ixPoint != 0:
                    segment = dataLineChartClipSegment( \
                        xPrevious, yPrevious, xPoint, yPoint, chartLeft, chartTop, chartRight, chartBottom)
                    if segment != null:
                        xStart = arrayGet(segment, 0)
                        yStart = arrayGet(segment, 1)
                        # Continue the current sub-path when this segment starts where the last one ended
                        if xLast != xStart || yLast != yStart:
                            drawMove(mathRound(xStart, dataLineChartCoordPrecision), \
                                mathRound(yStart, dataLineChartCoordPrecision))
                        endif
                        xLast = arrayGet(segment, 2)
                        yLast = arrayGet(segment, 3)
                        drawLine(mathRound(xLast, dataLineChartCoordPrecision), \
                            mathRound(yLast, dataLineChartCoordPrecision))
                    endif
                endif
                xPrevious = xPoint
                yPrevious = yPoint
                ixPoint = ixPoint + 1
            endwhile
        endif
    endfor

    # Annotation label calculations
    annotationLabelFontSize = axisLabelFontSize
    annotationLabelMargin = 0.25 * annotationLabelFontSize
    annotationLabelHeight = annotationLabelFontSize + 2 * annotationLabelMargin
    annotationLabelOffsetX = 0.2 * annotationLabelFontSize
    annotationLabelOffsetY = 0.1 * annotationLabelFontSize

    # Compute the annotation coordinates - [coordinate, label, label-x, label-y, label-width, text-x, text-anchor] tuples
    yAnnotationCoords = []
    for yAxisAnnotation in yAxisAnnotations:
        yLabel = arrayGet(yAxisAnnotation, 1)
        yPoint = dataLineChartAxisCoord(yAxis, arrayGet(yAxisAnnotation, 0), chartBottom, chartTop)
        isUnder = yPoint < 0.5 * (chartTop + chartBottom)
        labelWidth = 2 * annotationLabelMargin + drawTextWidth(yLabel, annotationLabelFontSize)
        labelY = if(isUnder, \
            yPoint + dataLineChartAnnotationLineWidth + annotationLabelOffsetY, \
            yPoint - dataLineChartAnnotationLineWidth - annotationLabelOffsetY - annotationLabelHeight)
        arrayPush(yAnnotationCoords, [yPoint, yLabel, chartLeft + annotationLabelOffsetX, labelY, labelWidth, \
            chartLeft + annotationLabelOffsetX + annotationLabelMargin, 'start'])
    endfor
    xAnnotationCoords = []
    for xAxisAnnotation in xAxisAnnotations:
        xLabel = arrayGet(xAxisAnnotation, 1)
        xPoint = dataLineChartAxisCoord(xAxis, arrayGet(xAxisAnnotation, 0), chartLeft, chartRight)
        isLeft = xPoint > 0.5 * (chartLeft + chartRight)
        labelWidth = 2 * annotationLabelMargin + drawTextWidth(xLabel, annotationLabelFontSize)
        labelOffset = 0.5 * dataLineChartAnnotationLineWidth + annotationLabelOffsetX
        arrayPush(xAnnotationCoords, [xPoint, xLabel, \
            if(isLeft, xPoint - labelOffset - labelWidth, xPoint + labelOffset), \
            chartBottom - annotationLabelOffsetY - annotationLabelHeight, labelWidth, \
            if(isLeft, xPoint - labelOffset - annotationLabelMargin, xPoint + labelOffset + annotationLabelMargin), \
            if(isLeft, 'end', 'start')])
    endfor

    # Draw the annotation lines
    drawStyle(dataLineChartAnnotationLineColor, dataLineChartAnnotationLineWidth, 'none')
    for yAnnotationCoord in yAnnotationCoords:
        drawMove(yAxisXCoord, dataLineChartCoord(arrayGet(yAnnotationCoord, 0)))
        drawHLine(dataLineChartCoord(chartRight))
    endfor
    for xAnnotationCoord in xAnnotationCoords:
        drawMove(dataLineChartCoord(arrayGet(xAnnotationCoord, 0)), xAxisYCoord)
        drawVLine(dataLineChartCoord(chartTop))
    endfor

    # Draw the annotation label backgrounds - the Y and X annotations are drawn as one set
    annotationCoords = arrayExtend(arrayCopy(yAnnotationCoords), xAnnotationCoords)
    drawStyle('none', 0, dataLineChartAnnotationBackgroundColor)
    for annotationCoord in annotationCoords:
        if arrayGet(annotationCoord, 1) != '':
            drawRect(dataLineChartCoord(arrayGet(annotationCoord, 2)), dataLineChartCoord(arrayGet(annotationCoord, 3)), \
                dataLineChartCoord(arrayGet(annotationCoord, 4)), dataLineChartCoord(annotationLabelHeight))
        endif
    endfor

    # Draw the color legend line samples - a segment of the line itself, so that a reader who cannot
    # tell the colors apart can still match a legend entry to its line by dash pattern
    if colorLegendX != null:
        for linePoint, ixLinePoint in colorLegendPoints:
            drawStyle(objectGet(linePoint, 'color'), dataLineChartChartLineWidth, 'none', objectGet(linePoint, 'dash'))
            sampleY = chartTop + ixLinePoint * (colorLegendLabelHeight + colorLegendLabelGap) + \
                0.5 * colorLegendLabelHeight
            drawMove(dataLineChartCoord(colorLegendX), dataLineChartCoord(sampleY))
            drawHLine(dataLineChartCoord(colorLegendX + colorLegendSampleLength))
        endfor
    endif

    # Draw the chart title
    chartTitleFit = chartRight - chartLeft
    if chartTitle != null:
        drawTextStyle(chartTitleFontSize, dataLineChartAxisColor, true)
        drawText(dataLineChartLabelFit(chartTitle, chartTitleFontSize, chartTitleFit), \
            dataLineChartCoord(0.5 * (chartLeft + chartRight)), dataLineChartCoord(y + chartBorderSize), \
            'middle', 'hanging')
    endif

    # Draw the axis titles
    drawTextStyle(axisTitleFontSize, dataLineChartAxisColor, true)
    if yAxisTitle != null && yAxisTitleFits:
        drawText(dataLineChartLabelFit(yAxisTitle, axisTitleFontSize, chartBottom - chartTop), \
            dataLineChartCoord(x + chartBorderSize), dataLineChartCoord(0.5 * (chartTop + chartBottom)), \
            'middle', 'hanging', -90)
    endif
    drawText(dataLineChartLabelFit(xField, axisTitleFontSize, chartTitleFit), \
        dataLineChartCoord(0.5 * (chartLeft + chartRight)), dataLineChartCoord(y + height - chartBorderSize), \
        'middle', 'auto')

    # Draw the axis tick mark labels
    drawTextStyle(axisLabelFontSize, dataLineChartAxisColor)
    for yTickCoord in yTickCoords:
        yPoint = arrayGet(yTickCoord, 0)
        drawText(arrayGet(yTickCoord, 1), dataLineChartCoord(yAxisX - dataLineChartAxisTickLength - yAxisTickGap), \
            dataLineChartCoord(yPoint), 'end', \
            if(yPoint > yAxisLabelBottom, 'auto', if(yPoint < yAxisLabelTop, 'hanging', 'middle')))
    endfor
    for xTickCoord in xTickCoords:
        xPoint = arrayGet(xTickCoord, 0)
        drawText(arrayGet(xTickCoord, 1), dataLineChartCoord(xPoint), \
            dataLineChartCoord(xAxisY + dataLineChartAxisTickLength + xAxisTickGap), \
            if(xPoint < xAxisLabelLeft, 'start', if(xPoint > xAxisLabelRight, 'end', 'middle')), 'hanging')
    endfor

    # Draw the annotation labels
    drawTextStyle(annotationLabelFontSize, dataLineChartAnnotationTextColor)
    for annotationCoord in annotationCoords:
        annotationLabel = arrayGet(annotationCoord, 1)
        if annotationLabel != '':
            drawText(annotationLabel, dataLineChartCoord(arrayGet(annotationCoord, 5)), \
                dataLineChartCoord(arrayGet(annotationCoord, 3) + annotationLabelMargin + 0.5 * annotationLabelFontSize), \
                arrayGet(annotationCoord, 6), 'middle')
        endif
    endfor

    # Draw the color legend labels
    if colorLegendX != null:
        drawTextStyle(colorLegendFontSize, dataLineChartAxisColor)
        for linePoint, ixLinePoint in colorLegendPoints:
            drawText(dataLineChartLabelFit(objectGet(linePoint, 'label'), colorLegendFontSize, colorLegendLabelFit), \
                dataLineChartCoord(colorLegendX + colorLegendSampleWidth), \
                dataLineChartCoord(chartTop + ixLinePoint * (colorLegendLabelHeight + colorLegendLabelGap) + \
                    0.5 * colorLegendLabelHeight), \
                'start', 'middle')
        endfor
    endif

    return true
endfunction


# Helper function to get a series' color
function dataLineChartSeriesColor(ixSeries):
    return arrayGet(dataLineChartCategoricalColors, ixSeries % arrayLength(dataLineChartCategoricalColors))
endfunction


# Helper function to get a series' line dash pattern
function dataLineChartSeriesDash(ixSeries):
    ixDash = mathFloor(ixSeries / arrayLength(dataLineChartCategoricalColors))
    return arrayGet(dataLineChartLineDashArrays, ixDash % arrayLength(dataLineChartLineDashArrays))
endfunction


# Helper function to fit a label within a width, ending it with an ellipsis when it does not fit.
# Only category labels are fitted this way - a truncated number would read as a different number.
function dataLineChartLabelFit(label, fontSize, maxWidth):
    if drawTextWidth(label, fontSize) <= maxWidth:
        return label
    endif
    labelCount = mathFloor(maxWidth / drawTextWidth('0', fontSize)) - stringLength(dataLineChartEllipsis)
    return if(labelCount > 0, stringSlice(label, 0, labelCount) + dataLineChartEllipsis, '')
endfunction


# Helper function to round a chart coordinate
function dataLineChartCoord(value):
    return mathRound(value, dataLineChartCoordPrecision)
endfunction


# Helper function to test whether an axis's tick mark labels fit without overlapping. A label is
# centered on its tick mark, except near the axis ends where it is anchored inside the chart - so an
# end label reaches half a label further toward its neighbor.
function dataLineChartAxisLabelsFit(axis, coordMin, coordMax, fontSize):
    labelLimitMin = coordMin + 0.5 * fontSize
    labelLimitMax = coordMax - 0.5 * fontSize
    labelGap = 0.5 * fontSize
    labelEnd = null
    for tickPair in objectGet(axis, 'ticks'):
        tickCoord = dataLineChartAxisCoord(axis, arrayGet(tickPair, 0), coordMin, coordMax)
        labelWidth = drawTextWidth(arrayGet(tickPair, 1), fontSize)
        labelStart = if(tickCoord < labelLimitMin, tickCoord, \
            if(tickCoord > labelLimitMax, tickCoord - labelWidth, tickCoord - 0.5 * labelWidth))
        if labelEnd != null && (labelStart - labelEnd) < labelGap:
            return false
        endif
        labelEnd = labelStart + labelWidth
    endfor
    return true
endfunction


# Helper function to validate an axis's explicit bounds against its computed range. A bound pair
# that is not strictly increasing - a minimum at or above the maximum, whether both were given or
# only one - leaves the axis no range to scale by, which would divide every chart coordinate by
# zero. Such a pair is ignored and the computed range kept.
function dataLineChartAxisBounds(minValue, maxValue, minFixed, maxFixed):
    if minFixed == null && maxFixed == null:
        return [null, null]
    endif
    if if(minFixed != null, minFixed, minValue) < if(maxFixed != null, maxFixed, maxValue):
        return [minFixed, maxFixed]
    endif
    systemLogDebug('dataLineChart.bare - Ignoring an axis range that is not increasing')
    return [null, null]
endfunction


# Helper function to hold an axis to its explicit bounds. An axis spans the range it is given, so this
# usually changes nothing - but the tick mark fallback rounds the range outward when too few tick step
# boundaries fall within it, and an axis the caller asked to run from 0 to 100 must end at 0 and 100.
# So the bounds are re-applied afterwards and the tick marks outside them are dropped. The tick step
# was computed from the bounded range, so at most the outermost tick on each side goes.
function dataLineChartAxisClamp(axis, minFixed, maxFixed):
    if minFixed == null && maxFixed == null:
        return axis
    endif
    axisMin = if(minFixed != null, minFixed, objectGet(axis, 'min'))
    axisMax = if(maxFixed != null, maxFixed, objectGet(axis, 'max'))
    return dataLineChartAxisNew(axisMin, axisMax, objectGet(axis, 'log'), objectGet(axis, 'label'), \
        dataLineChartAxisClampValues(objectGet(axis, 'ticks'), axisMin, axisMax), \
        dataLineChartAxisClampValues(objectGet(axis, 'subticks'), axisMin, axisMax))
endfunction


# Helper function to drop the values outside an axis's range. Tick marks are [value, label] pairs
# and sub-tick marks are bare values, so both shapes are accepted. The comparison goes through the
# axis parameter so that it reads the same for numbers and for datetimes.
function dataLineChartAxisClampValues(valueLabels, axisMin, axisMax):
    clamped = []
    for valueLabel in valueLabels:
        value = if(systemType(valueLabel) == 'array', arrayGet(valueLabel, 0), valueLabel)
        valueParameter = dataUtilValueParameter(value, axisMin, axisMax)
        if valueParameter >= -dataLineChartClampEpsilon && valueParameter <= 1 + dataLineChartClampEpsilon:
            arrayPush(clamped, valueLabel)
        endif
    endfor
    return clamped
endfunction


# Helper function to clip a chart line segment to the chart area, so that data outside an explicit
# axis range does not draw over the axes, the labels, or the legend. This is the parametric
# (Liang-Barsky) clip, done in chart coordinates so it serves linear, logarithmic and datetime axes
# alike. Returns the clipped [x0, y0, x1, y1], or null when the segment is entirely outside.
function dataLineChartClipSegment(x0, y0, x1, y1, left, top, right, bottom):
    # Both endpoints inside is the common case, and needs none of the work below
    if x0 >= left && x0 <= right && y0 >= top && y0 <= bottom && \
       x1 >= left && x1 <= right && y1 >= top && y1 <= bottom:
        return [x0, y0, x1, y1]
    endif

    # The four edges are tested inline - as a loop over an array of pairs this allocated five arrays
    # per call and was half of the chart's statement count. Each axis contributes the parameter at
    # which the segment enters the slab and the one at which it leaves.
    deltaX = x1 - x0
    deltaY = y1 - y0
    clipMin = 0
    clipMax = 1
    if deltaX > 0:
        clipMin = mathMax(clipMin, (left - x0) / deltaX)
        clipMax = mathMin(clipMax, (right - x0) / deltaX)
    elif deltaX < 0:
        clipMin = mathMax(clipMin, (right - x0) / deltaX)
        clipMax = mathMin(clipMax, (left - x0) / deltaX)
    elif x0 < left || x0 > right:
        return null
    endif
    if deltaY > 0:
        clipMin = mathMax(clipMin, (top - y0) / deltaY)
        clipMax = mathMin(clipMax, (bottom - y0) / deltaY)
    elif deltaY < 0:
        clipMin = mathMax(clipMin, (bottom - y0) / deltaY)
        clipMax = mathMin(clipMax, (top - y0) / deltaY)
    elif y0 < top || y0 > bottom:
        return null
    endif
    if clipMin > clipMax:
        return null
    endif
    return [x0 + clipMin * deltaX, y0 + clipMin * deltaY, x0 + clipMax * deltaX, y0 + clipMax * deltaY]
endfunction


# Helper function to map an axis's tick marks onto the chart, as [coordinate, label] pairs
function dataLineChartAxisTickCoords(axis, coordMin, coordMax):
    tickCoords = []
    for tickPair in objectGet(axis, 'ticks'):
        arrayPush(tickCoords, \
            [dataLineChartAxisCoord(axis, arrayGet(tickPair, 0), coordMin, coordMax), arrayGet(tickPair, 1)])
    endfor
    return tickCoords
endfunction


# Helper function to compute an axis's chart coordinate for an axis value
function dataLineChartAxisCoord(axis, value, coordMin, coordMax):
    # An automatic axis always has a range - a constant series is expanded around its value
    axisValue = if(objectGet(axis, 'log'), mathLog(value, 10), value)
    return coordMin + ((axisValue - objectGet(axis, 'base')) / objectGet(axis, 'range')) * (coordMax - coordMin)
endfunction


# Helper function to test whether an axis is drawn on a logarithmic scale. A caller may ask for one
# on any axis, but only a positive numeric range can carry it.
function dataLineChartIsLog(isLog, minValue):
    return isLog && systemType(minValue) == 'number' && minValue > 0
endfunction


# Helper function to create an axis model - the axis range, the [value, label] tick pairs, and the sub-tick values
function dataLineChartAxisNew(minValue, maxValue, isLog, label, ticks, subticks):
    isLog = dataLineChartIsLog(isLog, minValue)
    axisBase = if(isLog, mathLog(minValue, 10), minValue)
    axisRange = if(isLog, mathLog(maxValue, 10) - axisBase, maxValue - minValue)
    return { \
        'min': minValue, \
        'max': maxValue, \
        'log': isLog, \
        'base': axisBase, \
        'range': axisRange, \
        'label': label, \
        'ticks': ticks, \
        'subticks': subticks \
    }
endfunction


# Helper function to compute an axis's tick marks and range
function dataLineChartAxis(isLog, format, minValue, maxValue, maxCount, precision, datetime):
    # A constant series has no range of its own. Expand it around the value so the data is drawn
    # within the chart rather than flat along its edge, where it would read as the axis minimum.
    if minValue == maxValue:
        if dataLineChartIsLog(isLog, minValue):
            minValue = minValue / 10
            maxValue = maxValue * 10
        elif systemType(minValue) == 'datetime':
            # A datetime supports "+ milliseconds" but not "- milliseconds"
            minValue = minValue + -dataLineChartSingleValueDuration
            maxValue = maxValue + dataLineChartSingleValueDuration
        else:
            singleValueDelta = if(minValue == 0, 1, mathAbs(minValue))
            minValue = minValue - singleValueDelta
            maxValue = maxValue + singleValueDelta
        endif
    endif

    # Compute the automatic tick marks for the axis type
    if dataLineChartIsLog(isLog, minValue):
        return dataLineChartAxisLog(format, minValue, maxValue, maxCount, precision)
    elif systemType(minValue) == 'datetime':
        return dataLineChartAxisDatetime(minValue, maxValue, maxCount, precision, datetime)
    endif
    return dataLineChartAxisLinear(format, minValue, maxValue, maxCount, precision)
endfunction


# Helper function to take the tick step boundaries that fall within an axis's range. A tick step
# boundary is not a value the axis is expected to open on, and rounding out to one can leave most of
# a tick step empty - half a year, for a six-month step - so an automatic axis spans the data. Fewer
# than two boundaries fall within it when a narrow chart selects a tick step as long as the data
# range; the axis then uses the rounded-out range, which is labeled at both ends. Returns the axis's
# [minimum, maximum, tick values].
function dataLineChartAxisTickValues(boundsTicks, minValue, maxValue):
    tickValues = []
    for boundsTick in boundsTicks:
        if boundsTick >= minValue && boundsTick <= maxValue:
            arrayPush(tickValues, boundsTick)
        endif
    endfor
    if arrayLength(tickValues) < 2:
        return [arrayGet(boundsTicks, 0), arrayGet(boundsTicks, arrayLength(boundsTicks) - 1), boundsTicks]
    endif
    return [minValue, maxValue, tickValues]
endfunction


# Helper function to compute a linear axis's automatic tick marks
function dataLineChartAxisLinear(format, minValue, maxValue, maxCount, precision):
    # Compute the "nice" tick step - one, two, or five times a power of ten
    stepInfo = dataLineChartNiceStep((maxValue - minValue) / maxCount)
    step = arrayGet(stepInfo, 0)
    stepPrecision = mathMax(0, -arrayGet(stepInfo, 1))

    # Walk the tick step boundaries, from the one at or below the minimum value to the one at or
    # above the maximum value, so that every tick interval is a whole tick step
    boundsMin = mathRound(mathFloor(mathRound(minValue / step, dataLineChartRoundDigits)) * step, stepPrecision)
    boundsMax = mathRound(mathCeil(mathRound(maxValue / step, dataLineChartRoundDigits)) * step, stepPrecision)
    boundsTicks = []
    ixTick = 0
    boundsCount = mathRound((boundsMax - boundsMin) / step) + 1
    while ixTick < boundsCount:
        arrayPush(boundsTicks, mathRound(boundsMin + ixTick * step, stepPrecision))
        ixTick = ixTick + 1
    endwhile

    axisValues = dataLineChartAxisTickValues(boundsTicks, minValue, maxValue)
    axisMin = arrayGet(axisValues, 0)
    axisMax = arrayGet(axisValues, 1)
    tickValues = arrayGet(axisValues, 2)

    # Compute the tick label format - an evenly-spaced axis scales every label by the same power of
    # ten, the one of the largest-magnitude tick mark
    labelSignificant = if(precision != null, -precision, arrayGet(stepInfo, 1))
    magnitudeExponent = dataLineChartValueExponent(mathMax( \
        mathAbs(arrayGet(tickValues, 0)), mathAbs(arrayGet(tickValues, arrayLength(tickValues) - 1))))
    labelKind = dataLineChartLabelKind(format, magnitudeExponent, magnitudeExponent, labelSignificant)
    axisLabel = dataLineChartLabelNew(labelKind, dataLineChartLabelExponent(labelKind, magnitudeExponent), \
        labelSignificant, precision, null)

    # Compute the tick labels. Evenly-spaced tick marks need no sub-tick marks - the eye interpolates
    # between them - so the axis carries none.
    axisTicks = []
    for tickValue in tickValues:
        arrayPush(axisTicks, [tickValue, dataLineChartAxisLabel(axisLabel, tickValue)])
    endfor
    return dataLineChartAxisNew(axisMin, axisMax, false, axisLabel, axisTicks, [])
endfunction


# Helper function to compute a logarithmic axis's automatic tick marks
function dataLineChartAxisLog(format, minValue, maxValue, maxCount, precision):
    # Round the axis range outward to the nearest decades
    decadeMin = mathFloor(mathLog(minValue, 10) + dataLineChartLogEpsilon)
    decadeMax = mathCeil(mathLog(maxValue, 10) - dataLineChartLogEpsilon)
    decadeCount = mathMax(1, decadeMax - decadeMin)

    # Tick marks span whole decades. Prefer a step that divides the decade count evenly, so that the last
    # tick is the axis maximum; when that renders too few tick marks, extend the range by less than a step.
    decadeStep = mathMax(1, mathCeil(decadeCount / maxCount))
    divisorStep = decadeStep
    while (decadeCount % divisorStep) != 0:
        divisorStep = divisorStep + 1
    endwhile
    if decadeCount / divisorStep + 1 >= mathMax(2, mathFloor(maxCount / 2) + 1):
        decadeStep = divisorStep
    endif
    decadeCount = decadeStep * mathCeil(decadeCount / decadeStep)
    decadeMax = decadeMin + decadeCount
    axisMin = 10 ** decadeMin
    axisMax = 10 ** decadeMax

    # Determine the tick and sub-tick mantissas - a short axis labels the 1, 2, and 5 of each decade
    if decadeStep != 1:
        tickMantissas = [1]
        subtickMantissas = []
    elif 3 * decadeCount <= maxCount:
        tickMantissas = [1, 2, 5]
        subtickMantissas = [3, 4, 6, 7, 8, 9]
    else:
        tickMantissas = [1]
        subtickMantissas = [2, 3, 4, 5, 6, 7, 8, 9]
    endif

    # Compute the tick label format - a logarithmic axis spans decades, so each label is scaled by its
    # own power of ten
    labelKind = dataLineChartLabelKind(format, decadeMin, decadeMax, decadeMin)
    axisLabel = dataLineChartLabelNew(labelKind, null, if(precision != null, -precision), precision, null)

    # Compute the tick values, the tick labels, and the sub-tick values
    axisTicks = []
    axisSubticks = []
    decade = decadeMin
    while decade <= decadeMax:
        decadeValue = 10 ** decade
        for tickMantissa in tickMantissas:
            tickValue = tickMantissa * decadeValue
            if tickValue > axisMax:
                break
            endif
            arrayPush(axisTicks, [tickValue, dataLineChartAxisLabel(axisLabel, tickValue)])
        endfor
        if decade != decadeMax:
            for subtickMantissa in subtickMantissas:
                arrayPush(axisSubticks, subtickMantissa * decadeValue)
            endfor
        endif
        decade = decade + decadeStep
    endwhile
    return dataLineChartAxisNew(axisMin, axisMax, true, axisLabel, axisTicks, axisSubticks)
endfunction


# Helper function to compute a datetime axis's automatic tick marks
function dataLineChartAxisDatetime(minValue, maxValue, maxCount, precision, datetime):
    # Select the smallest calendar tick step that renders at most the maximum tick count
    stepUnit = null
    stepCount = null
    rangeMilliseconds = maxValue - minValue
    for stepInfo in dataLineChartDatetimeSteps:
        if rangeMilliseconds / arrayGet(stepInfo, 2) <= maxCount:
            stepUnit = arrayGet(stepInfo, 0)
            stepCount = arrayGet(stepInfo, 1)
            break
        endif
    endfor

    # Longer ranges step by a "nice" number of years
    if stepUnit == null:
        yearStepInfo = dataLineChartNiceStep(rangeMilliseconds / (maxCount * dataLineChartMillisecondsPerYear))
        stepUnit = 'year'
        stepCount = mathMax(1, mathRound(arrayGet(yearStepInfo, 0)))
    endif

    # Walk the tick step boundaries, from the one at or before the minimum value to the one at or
    # after the maximum value, so that every tick interval is a whole tick step
    tickDatetime = if(datetime != null, datetime, objectGet(dataLineChartDatetimeFormats, stepUnit))
    boundsMin = dataLineChartDatetimeFloor(minValue, stepUnit, stepCount)
    boundsTicks = []
    boundsValue = boundsMin
    while true:
        arrayPush(boundsTicks, boundsValue)
        if boundsValue >= maxValue:
            break
        endif
        boundsValue = dataLineChartDatetimeAdd(boundsValue, stepUnit, stepCount)
    endwhile

    axisValues = dataLineChartAxisTickValues(boundsTicks, minValue, maxValue)
    axisMin = arrayGet(axisValues, 0)
    axisMax = arrayGet(axisValues, 1)
    tickValues = arrayGet(axisValues, 2)

    # Label the tick marks - each label drops the leading components its predecessor already showed
    axisTicks = []
    tickPrevious = null
    for tickValue in tickValues:
        tickLabel = dataUtilFormatValue(tickValue, precision, tickDatetime)
        arrayPush(axisTicks, [tickValue, dataLineChartLabelContext(tickLabel, tickPrevious)])
        tickPrevious = tickLabel
    endfor
    return dataLineChartAxisNew(axisMin, axisMax, false, \
        dataLineChartLabelNew('default', null, null, precision, tickDatetime), axisTicks, [])
endfunction


# The automatic datetime axis tick steps - [unit, step, approximate milliseconds] tuples
dataLineChartDatetimeSteps = [ \
    ['millisecond', 1, 1], \
    ['millisecond', 2, 2], \
    ['millisecond', 5, 5], \
    ['millisecond', 10, 10], \
    ['millisecond', 20, 20], \
    ['millisecond', 50, 50], \
    ['millisecond', 100, 100], \
    ['millisecond', 200, 200], \
    ['millisecond', 500, 500], \
    ['second', 1, 1000], \
    ['second', 2, 2000], \
    ['second', 5, 5000], \
    ['second', 10, 10000], \
    ['second', 15, 15000], \
    ['second', 30, 30000], \
    ['minute', 1, 60000], \
    ['minute', 2, 120000], \
    ['minute', 5, 300000], \
    ['minute', 10, 600000], \
    ['minute', 15, 900000], \
    ['minute', 30, 1800000], \
    ['hour', 1, 3600000], \
    ['hour', 2, 7200000], \
    ['hour', 3, 10800000], \
    ['hour', 6, 21600000], \
    ['hour', 12, 43200000], \
    ['day', 1, 86400000], \
    ['day', 2, 172800000], \
    ['day', 7, 604800000], \
    ['day', 14, 1209600000], \
    ['month', 1, 2629800000], \
    ['month', 3, 7889400000], \
    ['month', 6, 15778800000] \
]


# The automatic datetime axis label format by tick step unit
dataLineChartDatetimeFormats = {'year': 'year', 'month': 'month', 'day': 'day'}


# Automatic axis tick constants
dataLineChartMillisecondsPerYear = 31557600000
dataLineChartSingleValueDuration = 86400000
dataLineChartLogEpsilon = 1e-9
dataLineChartRoundDigits = 9


# The SI prefix by power of ten
dataLineChartSIPrefixes = { \
    '-15': 'f', \
    '-12': 'p', \
    '-9': 'n', \
    '-6': 'u', \
    '-3': 'm', \
    '0': '', \
    '3': 'k', \
    '6': 'M', \
    '9': 'G', \
    '12': 'T', \
    '15': 'P' \
}


# Automatic numeric tick label constants - the powers of ten at which plain decimal notation is
# replaced by SI prefix notation (large values) or exponential notation (small values)
dataLineChartCompactExponent = 6
dataLineChartExponentialExponent = -5


# Helper function to compute a positive value's power of ten
function dataLineChartValueExponent(value):
    if value == 0:
        return 0
    endif
    return mathFloor(mathLog(value, 10) + dataLineChartLogEpsilon)
endfunction


# Helper function to get the SI prefix for a value's power of ten, or null if there is none
function dataLineChartSIPrefix(valueExponent):
    return objectGet(dataLineChartSIPrefixes, stringNew(3 * mathFloor(valueExponent / 3)))
endfunction


# Helper function to choose a numeric axis's tick label notation - "decimal", "si", or "exponential".
# minExponent and maxExponent are the powers of ten of the axis's smallest and largest label
# magnitudes, and significantExponent is the power of ten of a label's least significant digit.
function dataLineChartLabelKind(format, minExponent, maxExponent, significantExponent):
    if format != null:
        return format
    endif

    # Large values use SI prefixes, but only when the prefixes cover the whole axis
    if maxExponent >= dataLineChartCompactExponent:
        if dataLineChartSIPrefix(minExponent) != null && dataLineChartSIPrefix(maxExponent) != null:
            return 'si'
        endif
        return 'exponential'
    elif significantExponent <= dataLineChartExponentialExponent:
        return 'exponential'
    endif
    return 'decimal'
endfunction


# Helper function to compute the power of ten factored out of a tick label
function dataLineChartLabelExponent(kind, valueExponent):
    return if(kind == 'si', 3 * mathFloor(valueExponent / 3), valueExponent)
endfunction


# Helper function to create an axis's tick label format. "kind" is "default" (the chart's precision
# and datetime format), "decimal", "si", or "exponential". "exponent" is the power of ten factored out
# of every label, or null to scale each label by its own; "significant" is the power of ten of a
# label's least significant digit, or null for the value's own.
function dataLineChartLabelNew(kind, exponent, significant, precision, datetime):
    return { \
        'kind': kind, \
        'exponent': exponent, \
        'significant': significant, \
        'precision': precision, \
        'datetime': datetime \
    }
endfunction


# The separators between a datetime label's components
dataLineChartLabelSeparators = '-T:'


# Helper function to drop the leading context a tick label repeats from the previous label - the
# shared year in "2024-01", "2024-07", or the shared date in "2024-06-12", "2024-06-12T06:00". The
# label keeps everything after the last separator the two share.
function dataLineChartLabelContext(label, previous):
    # A label that reverts to a coarser form - a date after a time of day - starts its own context
    if previous == null || stringLength(label) < stringLength(previous):
        return label
    endif

    # Count the leading characters the two labels share
    ixShared = 0
    sharedMax = mathMin(stringLength(label), stringLength(previous))
    while ixShared < sharedMax && stringCharAt(label, ixShared) == stringCharAt(previous, ixShared):
        ixShared = ixShared + 1
    endwhile

    # The shared context ends at a separator - either the next character, or the last one within it
    if ixShared < stringLength(label) && \
       stringIndexOf(dataLineChartLabelSeparators, stringCharAt(label, ixShared)) != -1:
        return stringSlice(label, ixShared + 1)
    endif
    ixSeparator = ixShared - 1
    while ixSeparator >= 0:
        if stringIndexOf(dataLineChartLabelSeparators, stringCharAt(label, ixSeparator)) != -1:
            return stringSlice(label, ixSeparator + 1)
        endif
        ixSeparator = ixSeparator - 1
    endwhile
    return label
endfunction


# Helper function to format an axis tick label
function dataLineChartAxisLabel(label, value):
    # An axis with no shared power of ten scales each label by its own
    kind = objectGet(label, 'kind')
    labelExponent = objectGet(label, 'exponent')
    significantExponent = objectGet(label, 'significant')
    if labelExponent == null || significantExponent == null:
        valueExponent = dataLineChartValueExponent(mathAbs(value))
        labelExponent = if(labelExponent != null, labelExponent, dataLineChartLabelExponent(kind, valueExponent))
        significantExponent = if(significantExponent != null, significantExponent, valueExponent)
    endif
    return dataLineChartLabel(value, kind, labelExponent, significantExponent)
endfunction


# Helper function to format an axis annotation label. An annotation names a value of its own rather
# than a tick mark: a plain decimal or datetime annotation is formatted at the chart's precision, and
# a compacted one keeps up to three significant digits - but no more decimals than the value needs.
function dataLineChartAxisAnnotationLabel(label, value, precision, datetime):
    kind = objectGet(label, 'kind')
    if kind == 'default' || kind == 'decimal':
        return dataUtilFormatValue(value, precision, datetime)
    endif
    valueExponent = dataLineChartValueExponent(mathAbs(value))
    labelExponent = objectGet(label, 'exponent')
    labelExponent = if(labelExponent != null, labelExponent, dataLineChartLabelExponent(kind, valueExponent))
    labelDecimals = dataLineChartLabelDecimals(value / 10 ** labelExponent, \
        mathMax(0, labelExponent - valueExponent + 2))
    return dataLineChartLabel(value, kind, labelExponent, labelExponent - labelDecimals)
endfunction


# Helper function to compute the fewest decimals that represent a scaled value exactly, up to a maximum
function dataLineChartLabelDecimals(scaledValue, maxDecimals):
    labelDecimals = 0
    while labelDecimals < maxDecimals && numberParseFloat(numberToFixed(scaledValue, labelDecimals)) != scaledValue:
        labelDecimals = labelDecimals + 1
    endwhile
    return labelDecimals
endfunction


# Helper function to format a numeric tick label. labelExponent is the power of ten factored out of
# the value, and significantExponent is the power of ten of the value's least significant digit.
function dataLineChartLabel(value, kind, labelExponent, significantExponent):
    if kind == 'decimal':
        return dataUtilFormatValue(value, mathMax(0, -significantExponent), null, false)
    endif

    # A scaled zero has no magnitude to name
    if value == 0:
        return '0'
    endif
    scaledText = numberToFixed(value / 10 ** labelExponent, mathMax(0, labelExponent - significantExponent))
    if labelExponent == 0:
        return scaledText
    endif
    siPrefix = if(kind == 'si', dataLineChartSIPrefix(labelExponent))
    return if(siPrefix != null, scaledText + siPrefix, scaledText + 'e' + labelExponent)
endfunction


# Helper function to compute the "nice" tick step at or above a raw step - the [step, exponent] tuple
function dataLineChartNiceStep(rawStep):
    exponent = mathFloor(mathLog(rawStep, 10))
    magnitude = 10 ** exponent
    residual = rawStep / magnitude
    if residual > 5:
        return [10 * magnitude, exponent + 1]
    elif residual > 2:
        return [5 * magnitude, exponent]
    elif residual > 1:
        return [2 * magnitude, exponent]
    endif
    return [magnitude, exponent]
endfunction


# Helper function to round a datetime down to a tick step boundary
function dataLineChartDatetimeFloor(value, unit, step):
    year = datetimeYear(value)
    if unit == 'year':
        return datetimeNew(mathFloor(year / step) * step, 1, 1)
    endif
    month = datetimeMonth(value)
    if unit == 'month':
        return datetimeNew(year, mathFloor((month - 1) / step) * step + 1, 1)
    endif
    day = datetimeDay(value)
    if unit == 'day':
        return datetimeNew(year, month, day)
    endif
    hour = datetimeHour(value)
    if unit == 'hour':
        return datetimeNew(year, month, day, mathFloor(hour / step) * step)
    endif
    minute = datetimeMinute(value)
    if unit == 'minute':
        return datetimeNew(year, month, day, hour, mathFloor(minute / step) * step)
    endif
    second = datetimeSecond(value)
    if unit == 'second':
        return datetimeNew(year, month, day, hour, minute, mathFloor(second / step) * step)
    endif
    return datetimeNew(year, month, day, hour, minute, second, mathFloor(datetimeMillisecond(value) / step) * step)
endfunction


# Helper function to add a tick step to a datetime
function dataLineChartDatetimeAdd(value, unit, step):
    year = datetimeYear(value)
    month = datetimeMonth(value)
    day = datetimeDay(value)
    hour = datetimeHour(value)
    minute = datetimeMinute(value)
    second = datetimeSecond(value)
    millisecond = datetimeMillisecond(value)
    if unit == 'year':
        year = year + step
    elif unit == 'month':
        month = month + step
    elif unit == 'day':
        day = day + step
    elif unit == 'hour':
        hour = hour + step
    elif unit == 'minute':
        minute = minute + step
    elif unit == 'second':
        second = second + step
    else:
        millisecond = millisecond + step
    endif
    return datetimeNew(year, month, day, hour, minute, second, millisecond)
endfunction


# Helper function to compute an axis's annotations - the array of [value, label] pairs. An annotation
# with no label of its own is labeled later, once the axis's tick label format is known.
function dataLineChartAxisAnnotations(lines):
    axisAnnotations = []
    for annotation in if(lines != null, lines, []):
        arrayPush(axisAnnotations, [objectGet(annotation, 'value'), objectGet(annotation, 'label')])
    endfor
    return axisAnnotations
endfunction


# Helper function to label an axis's unlabeled annotations with the axis's tick label format
function dataLineChartAxisAnnotationLabels(axis, annotations, precision, datetime):
    axisLabel = objectGet(axis, 'label')
    for annotation in annotations:
        if arrayGet(annotation, 1) == null:
            arraySet(annotation, 1, dataLineChartAxisAnnotationLabel(axisLabel, arrayGet(annotation, 0), precision, datetime))
        endif
    endfor
endfunction


# Helper sort comparison function for data rows by X field
function dataLineChartSortCompare(xField, row1, row2):
    return systemCompare(objectGet(row1, xField), objectGet(row2, xField))
endfunction


# Helper sort comparison function to order legend entries by where their lines end, topmost first
function dataLineChartLegendCompare(linePoint1, linePoint2):
    points1 = objectGet(linePoint1, 'points')
    points2 = objectGet(linePoint2, 'points')
    return systemCompare( \
        arrayGet(arrayGet(points2, arrayLength(points2) - 1), 1), \
        arrayGet(arrayGet(points1, arrayLength(points1) - 1), 1) \
    )
endfunction


# Helper sort comparison function for color order
function dataLineChartColorOrderCompare(colorOrder, cv1, cv2):
    ix1 = arrayIndexOf(colorOrder, cv1)
    ix2 = arrayIndexOf(colorOrder, cv2)
    if ix1 != -1 && ix2 != -1:
        return if(ix1 < ix2, -1, 1)
    elif ix1 == -1 && ix2 == -1:
        return if(cv1 < cv2, -1, 1)
    endif
    return if(ix1 != -1, -1, 1)
endfunction
