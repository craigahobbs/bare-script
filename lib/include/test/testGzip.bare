    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemLogDebug', ['gzip.bare: gzipUncompress - Invalid compressed data']], \
        ['systemLogDebug', ['gzip.bare: gzipUncompress - Invalid compressed data']], \
        ['systemLogDebug', ['gzip.bare: gzipUncompress - Invalid compressed data']], \
        ['systemLogDebug', ['gzip.bare: gzipUncompress - Invalid compressed data']], \
        ['systemLogDebug', ['gzip.bare: gzipUncompress - Invalid compressed data']], \
        ['systemLogDebug', ['gzip.bare: gzipUncompress - Invalid compressed data']], \
        ['systemLogDebug', ['gzip.bare: gzipUncompress - Invalid compressed data']], \
        ['systemLogDebug', ['gzip.bare: gzipUncompress - Invalid compressed data']] \
    ])
endfunction
