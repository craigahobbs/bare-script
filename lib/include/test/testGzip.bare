function testGzipUncompressHeaderFlags():
    unittestDeepEqual(gzipUncompress(testGzipBytes([ \
        31, 139, 8, 1, 0, 0, 0, 0, 0, 255, 3, 0, 0, 0, 0, 0, 0, 0, 0, 0 \
    ])), [])
    unittestDeepEqual(gzipUncompress(testGzipBytes([ \
        31, 139, 8, 4, 0, 0, 0, 0, 0, 255, 2, 0, 65, 66, 3, 0, 0, 0, 0, 0, 0, 0, 0, 0 \
    ])), [])
    unittestDeepEqual(gzipUncompress(testGzipBytes([ \
        31, 139, 8, 16, 0, 0, 0, 0, 0, 255, 104, 105, 0, 3, 0, 0, 0, 0, 0, 0, 0, 0, 0 \
    ])), [])
    unittestDeepEqual(gzipUncompress(testGzipBytes([ \
        31, 139, 8, 2, 0, 0, 0, 0, 0, 255, 144, 201, 3, 0, 0, 0, 0, 0, 0, 0, 0, 0 \
    ])), [])
    unittestDeepEqual(gzipUncompress(testGzipBytes([ \
        31, 139, 8, 31, 0, 0, 0, 0, 0, 255, 2, 0, 88, 89, 110, 0, 99, 0, 16, 191, 3, 0, \
        0, 0, 0, 0, 0, 0, 0, 0 \
    ])), [])
endfunction
unittestRunTest('testGzipUncompressHeaderFlags')


