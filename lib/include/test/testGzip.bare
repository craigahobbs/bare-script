include '../base64.bare'
include '../gzip.bare'
include '../unittest.bare'
include '../unittestMock.bare'


function testGzipBytes(values):
    bytes = []
    for value in values:
        arrayPush(bytes, value)
    endfor
    return bytes
endfunction


function testGzipRange(start, end):
    bytes = []
    value = start
    while value < end:
        arrayPush(bytes, value)
        value = value + 1
    endwhile
    return bytes
endfunction


function testGzipRepeat(byte, count):
    return arrayNewSize(count, byte)
endfunction


# Write a Huffman table's code for a symbol
function testGzipHuffmanWrite(writer, table, symbol):
    gzipWriteBits(writer, arrayGet(arrayGet(table, 3), symbol), arrayGet(arrayGet(table, 4), symbol))
endfunction


function testGzipRoundTrip(bytes):
    encoded = gzipCompress(bytes)
    unittestEqual(systemType(encoded), 'array')
    unittestDeepEqual(gzipUncompress(encoded), bytes)
endfunction


function testGzipWrap(deflateBytes):
    bytes = [31, 139, 8, 0, 0, 0, 0, 0, 0, 255]
    arrayExtend(bytes, deflateBytes)
    arrayExtend(bytes, [0, 0, 0, 0, 0, 0, 0, 0])
    return gzipUncompress(bytes)
endfunction


function testGzipBitsToBytes(bitString):
    bytes = []
    length = stringLength(bitString)
    ix = 0
    while ix < length:
        value = 0
        k = 0
        while k < 8 && ix + k < length:
            if stringCharAt(bitString, ix + k) == '1':
                value = value + (1 << k)
            endif
            k = k + 1
        endwhile
        arrayPush(bytes, value)
        ix = ix + 8
    endwhile
    return bytes
endfunction


#
# Round-trip
#


function testGzipCompressEmpty():
    testGzipRoundTrip([])
endfunction
unittestRunTest('testGzipCompressEmpty')


function testGzipCompressHello():
    testGzipRoundTrip(stringEncode('hello'))
endfunction
unittestRunTest('testGzipCompressHello')


function testGzipCompressString():
    unittestDeepEqual(gzipCompress('hello'), gzipCompress(stringEncode('hello')))
    unittestDeepEqual(gzipUncompress(gzipCompress('ünïcödé', 1)), stringEncode('ünïcödé'))
    unittestDeepEqual(gzipUncompress(gzipCompress('')), [])
endfunction
unittestRunTest('testGzipCompressString')


function testGzipCompressOneByte():
    testGzipRoundTrip([0])
    testGzipRoundTrip([255])
    testGzipRoundTrip([97])
endfunction
unittestRunTest('testGzipCompressOneByte')


function testGzipCompressTwoBytes():
    testGzipRoundTrip([1, 2])
endfunction
unittestRunTest('testGzipCompressTwoBytes')


function testGzipCompressThreeBytes():
    testGzipRoundTrip([1, 2, 3])
endfunction
unittestRunTest('testGzipCompressThreeBytes')


function testGzipCompressAllBytes():
    testGzipRoundTrip(testGzipRange(0, 256))
endfunction
unittestRunTest('testGzipCompressAllBytes')


function testGzipCompressRepeats():
    testGzipRoundTrip(testGzipRepeat(0, 64))
    testGzipRoundTrip(testGzipRepeat(97, 300))
    testGzipRoundTrip(stringEncode(stringRepeat('{"lineNumber":1}', 50)))
endfunction
unittestRunTest('testGzipCompressRepeats')


function testGzipCompressMatch():
    testGzipRoundTrip(stringEncode('abcabcabcabc'))
    testGzipRoundTrip(stringEncode('The quick brown fox jumps over the lazy dog. ' + \
        'The quick brown fox jumps over the lazy dog.'))
endfunction
unittestRunTest('testGzipCompressMatch')


function testGzipCompressLevel():
    bytes = stringEncode(stringRepeat('{"lineNumber":1}', 50))
    unittestDeepEqual(gzipCompress(bytes), gzipCompress(bytes, 6))
    unittestDeepEqual(gzipUncompress(gzipCompress(bytes, 0)), bytes)
    unittestDeepEqual(gzipUncompress(gzipCompress(bytes, 1)), bytes)
    unittestDeepEqual(gzipUncompress(gzipCompress(bytes, 9)), bytes)
    unittestEqual(arrayLength(gzipCompress(bytes, 0)) > arrayLength(gzipCompress(bytes, 9)), true)
    unittestEqual(arrayGet(gzipCompress([1], 1), 8), 4)
    unittestEqual(arrayGet(gzipCompress([1], 9), 8), 2)
    unittestEqual(arrayGet(gzipCompress([1], 6), 8), 0)
endfunction
unittestRunTest('testGzipCompressLevel')


function testGzipCompressLevel0():
    unittestDeepEqual(gzipUncompress(gzipCompress([], 0)), [])
    unittestDeepEqual(gzipUncompress(gzipCompress(stringEncode('hello'), 0)), stringEncode('hello'))
    unittestDeepEqual(gzipUncompress(gzipCompress(arrayNewSize(65536, 0), 0)), arrayNewSize(65536, 0))
endfunction
unittestRunTest('testGzipCompressLevel0')


function testGzipCompressLarge():
    # Stored blocks of 200000 bytes - four blocks, and a deflate stream larger than an array spread allows
    bytes = arrayNewSize(200000, 0)
    gzipBytes = gzipCompress(bytes, 0)
    unittestEqual(arrayLength(gzipBytes), 200038)
    unittestDeepEqual(gzipUncompress(gzipBytes), bytes)
endfunction
unittestRunTest('testGzipCompressLarge')


function testGzipCompressBlockTypes():
    # Text with skewed symbol frequencies compresses to a dynamic Huffman block
    text = ''
    number = 0
    while number < 1000:
        text = text + number + ' '
        number = number + 1
    endwhile
    bytes = stringEncode(text)
    compressed = gzipCompress(bytes)
    unittestEqual(arrayGet(compressed, 10) & 6, 4)
    unittestDeepEqual(gzipUncompress(compressed), bytes)
    unittestEqual(arrayLength(compressed) < arrayLength(bytes) / 2, true)

    # A tiny input compresses to a static Huffman block
    compressed = gzipCompress('hello')
    unittestEqual(arrayGet(compressed, 10) & 6, 2)
    compressed = gzipCompress([])
    unittestEqual(arrayGet(compressed, 10) & 6, 2)

    # A run of one byte - no distance symbol but one
    bytes = testGzipRepeat(97, 300)
    compressed = gzipCompress(bytes)
    unittestDeepEqual(gzipUncompress(compressed), bytes)

    # Incompressible input is stored
    bytes = testGzipRange(0, 256)
    compressed = gzipCompress(bytes)
    unittestEqual(arrayGet(compressed, 10) & 6, 0)
    unittestDeepEqual(gzipUncompress(compressed), bytes)
    unittestEqual(arrayLength(compressed), 256 + 5 + 18)
endfunction
unittestRunTest('testGzipCompressBlockTypes')


function testGzipHuffmanLengths():
    # Fibonacci frequencies make a tree deeper than the limit - the lengths are limited and the code complete
    freqs = []
    fib1 = 1
    fib2 = 1
    while arrayLength(freqs) < 40:
        arrayPush(freqs, fib1)
        fib2 = fib1 + fib2
        fib1 = fib2 - fib1
    endwhile
    for maxBits in [15, 7]:
        lengths = gzipHuffmanLengths(freqs, maxBits)
        kraft = 0
        for length in lengths:
            unittestEqual(length >= 1 && length <= maxBits, true)
            kraft = kraft + 2 ** -length
        endfor
        unittestEqual(kraft, 1)
    endfor

    # Unlimited depth
    unittestDeepEqual(gzipHuffmanLengths([1, 1, 2, 4, 8], 15), [4, 4, 3, 2, 1])

    # At least two symbols get a code so that the code is complete
    unittestDeepEqual(gzipHuffmanLengths([0, 0, 5, 0], 15), [1, 0, 1, 0])
    unittestDeepEqual(gzipHuffmanLengths([0, 0, 0], 15), [1, 1, 0])
    unittestDeepEqual(gzipHuffmanLengths([3, 0, 1], 15), [1, 0, 1])

    # Ties are broken by symbol
    unittestDeepEqual(gzipHuffmanLengths([1, 1, 1, 1], 15), [2, 2, 2, 2])
    unittestDeepEqual(gzipHuffmanLengths([1, 1, 2], 15), [2, 2, 1])
    unittestDeepEqual(gzipHuffmanLengths([2, 1, 1], 15), [1, 2, 2])
endfunction
unittestRunTest('testGzipHuffmanLengths')


function testGzipRunLengthSymbols():
    unittestDeepEqual(gzipRunLengthSymbols([]), [])
    unittestDeepEqual(gzipRunLengthSymbols([5]), [[5, 0, 0]])
    unittestDeepEqual(gzipRunLengthSymbols([5, 5]), [[5, 0, 0], [5, 0, 0]])
    unittestDeepEqual(gzipRunLengthSymbols([5, 5, 5, 5]), [[5, 0, 0], [16, 0, 2]])
    unittestDeepEqual(gzipRunLengthSymbols(arrayNewSize(8, 5)), [[5, 0, 0], [16, 3, 2], [5, 0, 0]])
    unittestDeepEqual(gzipRunLengthSymbols(arrayNewSize(11, 5)), [[5, 0, 0], [16, 3, 2], [16, 1, 2]])
    unittestDeepEqual(gzipRunLengthSymbols([0, 0]), [[0, 0, 0], [0, 0, 0]])
    unittestDeepEqual(gzipRunLengthSymbols(arrayNewSize(3, 0)), [[17, 0, 3]])
    unittestDeepEqual(gzipRunLengthSymbols(arrayNewSize(10, 0)), [[17, 7, 3]])
    unittestDeepEqual(gzipRunLengthSymbols(arrayNewSize(11, 0)), [[18, 0, 7]])
    unittestDeepEqual(gzipRunLengthSymbols(arrayNewSize(138, 0)), [[18, 127, 7]])
    unittestDeepEqual(gzipRunLengthSymbols(arrayNewSize(139, 0)), [[18, 127, 7], [0, 0, 0]])
    unittestDeepEqual(gzipRunLengthSymbols(arrayNewSize(141, 0)), [[18, 127, 7], [17, 0, 3]])
    unittestDeepEqual(gzipRunLengthSymbols(arrayNewSize(150, 0)), [[18, 127, 7], [18, 1, 7]])
    unittestDeepEqual(gzipRunLengthSymbols([1, 0, 0, 0, 0, 2, 2, 2, 2, 2, 3]), \
        [[1, 0, 0], [17, 1, 3], [2, 0, 0], [16, 1, 2], [3, 0, 0]])
endfunction
unittestRunTest('testGzipRunLengthSymbols')


