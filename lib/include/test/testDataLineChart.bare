function testDataLineChartAxisLinear_fewTicks():
    # Fewer than two tick step boundaries fall within the data - a narrow chart selects a tick step
    # as long as the data range - so the axis falls back to the rounded-out range
    unittestDeepEqual(dataLineChartAxis(false, null, 12, 18, 2, null, null), { \
        'base': 10, \
        'label': {'datetime': null, 'exponent': 1, 'kind': 'decimal', 'precision': null, 'significant': 0}, \
        'log': false, \
        'max': 20, \
        'min': 10, \
        'range': 10, \
        'subticks': [], \
        'ticks': [[10, '10'], [15, '15'], [20, '20']] \
    })
endfunction
