unittestRunTest('testDataLineChartElements_colorFieldMultipleFields')

function testDataLineChartElements_colorFieldMultipleFieldsOrder():
    # Twelve color values - two more than the palette has colors, so the last two take the first two
    # colors with the next dash pattern
    data = [ \
        {'A': 1, 'B': 1, 'C': 'b'}, \
        {'A': 1, 'B': 1, 'C': 'a'}, \
        {'A': 1, 'B': 1, 'C': 'c'}, \
        {'A': 1, 'B': 1, 'C': 'd'}, \
        {'A': 1, 'B': 1, 'C': 'g'}, \
        {'A': 1, 'B': 1, 'C': 'e'}, \
        {'A': 1, 'B': 1, 'C': 'f'}, \
        {'A': 1, 'B': 1, 'C': 'h'}, \
        {'A': 1, 'B': 1, 'C': 'i'}, \
        {'A': 1, 'B': 1, 'C': 'j'}, \
        {'A': 1, 'B': 1, 'C': 'k'}, \
        {'A': 1, 'B': 1, 'C': 'l'} \
    ]
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['B'], 'color': 'C', 'colorOrder': ['d', 'b', 'f']})
    unittestDeepEqual(dataLineChartElements(data, lineChart), { \
        'attr': {'aria-label': 'Line chart of B by A', 'height': 320, 'role': 'img', 'width': 640}, \
        'elem': [ \
            { \
