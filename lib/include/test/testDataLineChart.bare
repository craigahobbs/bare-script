#
# dataLineChartAxisBounds tests
#


function testDataLineChartAxisBounds():
    # No explicit bounds
    unittestDeepEqual(dataLineChartAxisBounds(1, 10, null, null), [null, null])

    # An increasing pair is kept, whether one bound is given or both
    unittestDeepEqual(dataLineChartAxisBounds(1, 10, 0, 100), [0, 100])
    unittestDeepEqual(dataLineChartAxisBounds(1, 10, 0, null), [0, null])
    unittestDeepEqual(dataLineChartAxisBounds(1, 10, null, 100), [null, 100])
endfunction
unittestRunTest('testDataLineChartAxisBounds')


function testDataLineChartAxisBounds_notIncreasing():
    # A pair that is not strictly increasing leaves the axis no range to scale by, so it is ignored.
    # Each ignored pair is reported, so the logs are mocked and asserted rather than printed.
    unittestMockAll()

    unittestDeepEqual(dataLineChartAxisBounds(1, 10, 5, 5), [null, null])
    unittestDeepEqual(dataLineChartAxisBounds(1, 10, 50, 10), [null, null])

    # One bound is enough to invert the pair against the computed range
    unittestDeepEqual(dataLineChartAxisBounds(1, 10, 100, null), [null, null])
    unittestDeepEqual(dataLineChartAxisBounds(1, 10, null, 0), [null, null])

    notIncreasing = ['systemLogDebug', ['dataLineChart.bare - Ignoring an axis range that is not increasing']]
    unittestDeepEqual(unittestMockEnd(), [notIncreasing, notIncreasing, notIncreasing, notIncreasing])
endfunction
unittestRunTest('testDataLineChartAxisBounds_notIncreasing')


function testDataLineChartElements_axisRangeNotIncreasing():
    # The chart still renders, scaled to the data, rather than dividing by a zero axis range
    unittestMockAll()
    data = [ \
        {'A': 1, 'B': 10}, \
        {'A': 2, 'B': 30} \
    ]
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['B'], 'yMin': 5, 'yMax': 5})
    unittestDeepEqual(dataLineChartElements(data, lineChart), \
        dataLineChartElements(data, dataLineChartValidate({'x': 'A', 'y': ['B']})))
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemLogDebug', ['dataLineChart.bare - Ignoring an axis range that is not increasing']] \
    ])
endfunction
unittestRunTest('testDataLineChartElements_axisRangeNotIncreasing')
