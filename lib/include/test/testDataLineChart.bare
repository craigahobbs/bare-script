function testDataLineChartElements_logScaleNonPositive():
    # Non-positive values cannot be plotted on a logarithmic axis - they are excluded from the chart
    data = [ \
        {'A': 0, 'B': 2}, \
        {'A': 1, 'B': 2}, \
        {'A': 10, 'B': 0}, \
        {'A': 10, 'B': 400}, \
        {'A': 100, 'B': 30000} \
    ]
    dataExpected = [ \
        {'A': 1, 'B': 2}, \
        {'A': 10, 'B': 400}, \
        {'A': 100, 'B': 30000} \
    ]
    lineChart = dataLineChartValidate({ \
        'x': 'A', \
        'y': ['B'], \
        'xScale': 'log', \
        'yScale': 'log', \
        'width': 320, \
        'height': 200 \
    })
    unittestDeepEqual( \
        dataLineChartElements(data, lineChart), \
        dataLineChartElements(dataExpected, lineChart) \
    )
endfunction
unittestRunTest('testDataLineChartElements_logScaleNonPositive')

function testDataLineChartElements_logScaleSubticks():
