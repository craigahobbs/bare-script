function testDataLineChartElements_colorField():
    # The last row's value is below the first's, so the Y-axis minimum moves after the first point
    data = [ \
        {'A': 1, 'B': 1, 'C': 'abc'}, \
        {'B': 3, 'C': 'abc'}, \
        {'A': 3, 'B': 2, 'C': 'abc'}, \
        {'A': 1, 'B': 2, 'C': 'def'}, \
        {'A': 2, 'C': 'def'}, \
        {'A': 3, 'B': 0} \
    ]
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['B'], 'color': 'C'})
    unittestDeepEqual(dataLineChartElements(data, lineChart), { \
