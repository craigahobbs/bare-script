function testDataLineChart_optionFontSize():
    unittestMockAll()
    data = [ \
        {'A': 1, 'B': 5}, \
        {'A': 5, 'B': 1} \
    ]
    lineChart = dataLineChartValidate({ \
        'x': 'A', \
        'y': ['B'] \
    })
    unittestEqual(dataLineChart(data, lineChart, {'fontSize': 12}), null)
    unittestDeepEqual(unittestMockEnd(), [ \
        [ \
            'elementModelRender', \
