function testDataLineChartElements_linesNoLabel():
    data = [ \
        {'A': 1, 'B': 5}, \
        {'A': 5, 'B': 1} \
    ]
    lineChart = dataLineChartValidate({ \
        'x': 'A', \
        'y': ['B'], \
        'xLines': [{'value': 4, 'label': ''}], \
        'yLines': [{'value': 4, 'label': ''}] \
