function testDataLineChartElements_lines():
    data = [ \
        {'A': 1, 'B': 5}, \
        {'A': 5, 'B': 1} \
    ]
    lineChart = dataLineChartValidate({ \
        'x': 'A', \
        'y': ['B'], \
        'xLines': [{'value': 1}, {'value': 4, 'label': 'x-value'}], \
        'yLines': [{'value': 1}, {'value': 4, 'label': 'y-value'}] \
    })
