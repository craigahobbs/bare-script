function testDataLineChartElements_colorFieldMultipleFields():
    data = [ \
        {'A': 1, 'B': 5, 'C': 2, 'D': 'abc'}, \
        {'A': 5, 'B': 1, 'C': 4, 'D': 'abc'}, \
        {'A': 1, 'B': 4, 'C': 6, 'D': 'def'}, \
        {'A': 5, 'B': 2, 'C': 3, 'D': 'def'} \
    ]
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['B', 'C'], 'color': 'D'})
    unittestDeepEqual(dataLineChartElements(data, lineChart), { \
        'attr': {'aria-label': 'Line chart of B, C by A', 'height': 320, 'role': 'img', 'width': 640}, \
