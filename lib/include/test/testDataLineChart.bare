function testDataLineChartElements_colorFieldEmptyValue():
    # A color value with no valid points is excluded from the chart and legend
    data = [ \
        {'A': 1, 'B': 2, 'C': 'u'}, \
        {'A': 2, 'B': 4, 'C': 'u'}, \
        {'A': 1, 'B': null, 'C': 'v'}, \
        {'A': 2, 'B': null, 'C': 'v'} \
    ]
    dataExpected = [ \
        {'A': 1, 'B': 2, 'C': 'u'}, \
        {'A': 2, 'B': 4, 'C': 'u'} \
    ]
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['B'], 'color': 'C'})
    unittestDeepEqual( \
        dataLineChartElements(data, lineChart), \
        dataLineChartElements(dataExpected, lineChart) \
    )
endfunction
unittestRunTest('testDataLineChartElements_colorFieldEmptyValue')

function testDataLineChartElements_emptyYField():
    # A y-field with no valid points is excluded from the chart and legend
    data = [ \
        {'A': 1, 'B': 2}, \
        {'A': 2, 'B': 4} \
    ]
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['B', 'C'], 'width': 120, 'height': 90})
    unittestDeepEqual(dataLineChartElements(data, lineChart), { \
