function testDataLineChartElements_noData():
    unittestMockAll()
    data = []
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['B']})
    unittestEqual(dataLineChartElements(data, lineChart), null)
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemLogDebug', ['dataLineChart.bare - No data']] \
    ])
endfunction
unittestRunTest('testDataLineChartElements_noData')


function testDataLineChartElements_missingField():
    unittestMockAll()
    data = [ \
        {'A': 1, 'B': 5}, \
        {'A': 5, 'B': 1} \
    ]
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['C']})
    unittestEqual(dataLineChartElements(data, lineChart), null)
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemLogDebug', ['dataLineChart.bare - No data']] \
    ])
endfunction
unittestRunTest('testDataLineChartElements_missingField')


#
# drawLineChart tests
#


function testDrawLineChart():
    # drawLineChart draws within the current drawing at the given position and size
    data = [ \
        {'A': 1, 'B': 5}, \
        {'A': 5, 'B': 1} \
    ]
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['B'], 'width': 320, 'height': 200})

    # The chart drawn at the drawing's origin is the chart's drawing content
    drawNew(320, 200)
    unittestEqual(drawLineChart(data, lineChart, 0, 0, 320, 200), true)
    composed = drawElements()
    standalone = dataLineChartElements(data, lineChart)
    unittestDeepEqual(objectGet(composed, 'elem'), objectGet(standalone, 'elem'))

    # A standalone chart names itself for assistive technology - a chart composed into a drawing is
    # named by whoever owns that drawing
    unittestDeepEqual(objectGet(composed, 'attr'), {'width': 320, 'height': 200})
    unittestDeepEqual(objectGet(standalone, 'attr'), \
        {'width': 320, 'height': 200, 'role': 'img', 'aria-label': 'Line chart of B by A'})

    # The chart drawn at an offset is the same chart, translated
    drawNew(340, 220)
    unittestEqual(drawLineChart(data, lineChart, 20, 20, 320, 200), true)
    offsetElements = objectGet(drawElements(), 'elem')
    unittestEqual(arrayLength(offsetElements), arrayLength(objectGet(dataLineChartElements(data, lineChart), 'elem')))
    unittestEqual(objectGet(objectGet(arrayGet(offsetElements, 0), 'attr'), 'x'), 20)
endfunction
unittestRunTest('testDrawLineChart')


function testDrawLineChart_noData():
    unittestMockAll()
    drawNew(320, 200)
    unittestEqual(drawLineChart([], dataLineChartValidate({'x': 'A', 'y': ['B']}), 0, 0, 320, 200), null)
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemLogDebug', ['dataLineChart.bare - No data']] \
    ])
endfunction
unittestRunTest('testDrawLineChart_noData')


