        {'A': 1, 'B': 1, 'C': 'abc'}, \
        {'B': 3, 'C': 'abc'}, \
        {'A': 3, 'B': 2, 'C': 'abc'}, \
        {'A': 1, 'B': 2, 'C': 'def'}, \
        {'A': 2, 'C': 'def'}, \
        {'A': 3, 'B': 3} \
