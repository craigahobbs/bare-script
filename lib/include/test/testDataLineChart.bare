function testDataLineChartElements_datetime():
    # The datetime tick step, tick labels, and axis range are computed from the calendar
    data = [ \
        {'A': datetimeNew(2024, 1, 1), 'B': 10}, \
        {'A': datetimeNew(2024, 2, 1), 'B': 20}, \
        {'A': datetimeNew(2024, 3, 1), 'B': 15} \
    ]
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['B'], 'width': 320, 'height': 200})
    unittestDeepEqual(dataLineChartElements(data, lineChart), { \
