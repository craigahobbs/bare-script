function testDataLineChart_noData():
    # Nothing is rendered when there is nothing to chart
    unittestMockAll()
    unittestEqual(dataLineChart([], dataLineChartValidate({'x': 'A', 'y': ['B']})), null)
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemLogDebug', ['dataLineChart.bare - No data']] \
    ])
endfunction
unittestRunTest('testDataLineChart_noData')


