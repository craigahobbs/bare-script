function testDataLineChartElements_labelsFit():
    # The tick count is reduced until the tick labels fit without overlapping - a month of daily data
    # in a narrow chart falls back to a month tick step. June has no daylight-saving transition, so
    # the tick coordinates are the same in every time zone.
    data = []
    ixDay = 0
    while ixDay < 30:
        arrayPush(data, {'A': datetimeNew(2024, 6, 1 + ixDay), 'B': 100 + ixDay})
        ixDay = ixDay + 1
    endwhile
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['B'], 'width': 320, 'height': 200})
    unittestDeepEqual(dataLineChartElements(data, lineChart), { \
        'attr': {'aria-label': 'Line chart of B by A', 'height': 200, 'role': 'img', 'width': 320}, \
        'elem': [ \
            { \
                'attr': { \
                    'fill': 'white', \
                    'height': 200, \
                    'rx': null, \
                    'ry': null, \
                    'stroke': 'none', \
                    'stroke-dasharray': 'none', \
                    'stroke-width': '0.00000000', \
                    'width': 320, \
                    'x': 0, \
                    'y': 0 \
                }, \
                'svg': 'rect' \
            }, \
            { \
                'attr': { \
                    'd': 'M 82.35000000 54.26000000 H 304.00000000', \
                    'fill': 'none', \
                    'stroke': 'lightgray', \
                    'stroke-dasharray': 'none', \
                    'stroke-width': 1 \
                }, \
                'svg': 'path' \
            }, \
            { \
                'attr': { \
