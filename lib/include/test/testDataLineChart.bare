function testDataLineChartElements_multipleYNulls():
    # The X-axis range spans all y-fields' points - a y-field with trailing nulls must not clamp the maximum
    data = [ \
        {'A': 1, 'B': 2, 'C': 5}, \
        {'A': 2, 'B': 4, 'C': null}, \
        {'A': 3, 'B': 6, 'C': null} \
    ]
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['B', 'C'], 'width': 120, 'height': 90})
    unittestDeepEqual(dataLineChartElements(data, lineChart), { \
