function testDataLineChartAxisLinear():
    # The axis spans the data - the tick marks are the "nice" tick step boundaries within it
    unittestDeepEqual(dataLineChartAxis(false, null, 3.2, 47.8, 5, null, null), { \
        'base': 3.2, \
        'label': {'datetime': null, 'exponent': 1, 'kind': 'decimal', 'precision': null, 'significant': 1}, \
        'log': false, \
        'max': 47.8, \
        'min': 3.2, \
        'range': 44.599999999999994, \
        'subticks': [], \
        'ticks': [[10, '10'], [20, '20'], [30, '30'], [40, '40']] \
    })
endfunction
