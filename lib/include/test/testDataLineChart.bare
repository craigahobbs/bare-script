function testDataLineChartElements_autoTicks():
    # The automatic tick marks are the "nice" tick step boundaries within the data range
    data = [ \
        {'A': 1, 'B': 5}, \
        {'A': 5, 'B': 1} \
    ]
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['B'], 'width': 320, 'height': 200})
    unittestDeepEqual(dataLineChartElements(data, lineChart), { \
        'attr': {'aria-label': 'Line chart of B by A', 'height': 200, 'role': 'img', 'width': 320}, \
        'elem': [ \
            { \
                'attr': { \
