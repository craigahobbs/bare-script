function testDataLineChartAxisLog_decadeStep():
    # A long logarithmic axis steps by a divisor of the decade count so the last tick is the axis maximum
    unittestDeepEqual(dataLineChartAxis(true, null, 0.001, 10000000, 3, null, null), { \
        'base': -2.9999999999999996, \
        'label': {'datetime': null, 'exponent': null, 'kind': 'si', 'precision': null, 'significant': null}, \
