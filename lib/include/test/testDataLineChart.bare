        'ticks': [[0.1, '0.1'], [1, '1'], [10, '10'], [100, '100']] \
    })
endfunction
unittestRunTest('testDataLineChartAxisSingle_log')

#
# Numeric tick label format tests
#


function testDataLineChartAxisLabel_si():
    # Large values switch from plain decimal to SI prefix notation
    unittestDeepEqual(dataLineChartAxis(false, null, 0, 12000000, 6, null, null), { \
        'base': 0, \
        'label': {'datetime': null, 'exponent': 6, 'kind': 'si', 'precision': null, 'significant': 6}, \
        'log': false, \
        'max': 12000000, \
        'min': 0, \
        'range': 12000000, \
        'subticks': [], \
        'ticks': [ \
            [0, '0'], \
            [2000000, '2M'], \
            [4000000, '4M'], \
            [6000000, '6M'], \
            [8000000, '8M'], \
            [10000000, '10M'], \
            [12000000, '12M'] \
        ] \
    })
endfunction
unittestRunTest('testDataLineChartAxisLabel_si')


function testDataLineChartAxisLabel_exponential():
    # Small values switch from plain decimal to exponential notation
    unittestDeepEqual(dataLineChartAxis(false, null, 0, 0.000029, 5, null, null), { \
        'base': 0, \
        'label': {'datetime': null, 'exponent': -5, 'kind': 'exponential', 'precision': null, 'significant': -5}, \
        'log': false, \
        'max': 0.000029, \
        'min': 0, \
        'range': 0.000029, \
        'subticks': [], \
        'ticks': [[0, '0'], [0.00001, '1e-5'], [0.00002, '2e-5']] \
    })
endfunction
unittestRunTest('testDataLineChartAxisLabel_exponential')


function testDataLineChartAxisLabel_formatSI():
    unittestDeepEqual(dataLineChartAxis(false, 'si', 0, 1900000, 5, null, null), { \
        'base': 0, \
        'label': {'datetime': null, 'exponent': 6, 'kind': 'si', 'precision': null, 'significant': 5}, \
        'log': false, \
        'max': 1900000, \
        'min': 0, \
        'range': 1900000, \
        'subticks': [], \
        'ticks': [[0, '0'], [500000, '0.5M'], [1000000, '1.0M'], [1500000, '1.5M']] \
    })
endfunction
unittestRunTest('testDataLineChartAxisLabel_formatSI')


function testDataLineChartAxisLabel_formatExponential():
    unittestDeepEqual(dataLineChartAxis(false, 'exponential', 0, 1900000, 5, null, null), { \
        'base': 0, \
        'label': {'datetime': null, 'exponent': 6, 'kind': 'exponential', 'precision': null, 'significant': 5}, \
        'log': false, \
        'max': 1900000, \
        'min': 0, \
        'range': 1900000, \
        'subticks': [], \
        'ticks': [[0, '0'], [500000, '0.5e6'], [1000000, '1.0e6'], [1500000, '1.5e6']] \
    })
endfunction
unittestRunTest('testDataLineChartAxisLabel_formatExponential')


function testDataLineChartAxisLabel_formatDecimal():
    unittestDeepEqual(dataLineChartAxis(false, 'decimal', 0, 1900000, 5, null, null), { \
        'base': 0, \
        'label': {'datetime': null, 'exponent': 6, 'kind': 'decimal', 'precision': null, 'significant': 5}, \
        'log': false, \
        'max': 1900000, \
        'min': 0, \
        'range': 1900000, \
        'subticks': [], \
        'ticks': [[0, '0'], [500000, '500000'], [1000000, '1000000'], [1500000, '1500000']] \
    })
endfunction
unittestRunTest('testDataLineChartAxisLabel_formatDecimal')


function testDataLineChartAxisLabel_logSI():
    # A logarithmic axis spans decades, so each label is scaled by its own power of ten
    unittestDeepEqual(dataLineChartAxis(true, null, 120, 1500000000, 5, null, null), { \
        'base': 2, \
        'label': {'datetime': null, 'exponent': null, 'kind': 'si', 'precision': null, 'significant': null}, \
        'log': true, \
        'max': 10000000000, \
        'min': 100, \
        'range': 8, \
        'subticks': [], \
        'ticks': [[100, '100'], [10000, '10k'], [1000000, '1M'], [100000000, '100M'], [10000000000, '10G']] \
    })
endfunction
unittestRunTest('testDataLineChartAxisLabel_logSI')


function testDataLineChartAxisLabel_logExponential():
    # Values beyond the SI prefix range use exponential notation
    unittestDeepEqual(dataLineChartAxis(true, null, 1, 1e29, 4, null, null), { \
        'base': 0, \
        'label': {'datetime': null, 'exponent': null, 'kind': 'exponential', 'precision': null, 'significant': null}, \
        'log': true, \
        'max': 1e+32, \
        'min': 1, \
        'range': 32, \
        'subticks': [], \
        'ticks': [[1, '1'], [100000000, '1e8'], [10000000000000000, '1e16'], [1e+24, '1e24'], [1e+32, '1e32']] \
    })
endfunction
unittestRunTest('testDataLineChartAxisLabel_logExponential')


function testDataLineChartValueExponent():
    unittestEqual(dataLineChartValueExponent(0), 0)
    unittestEqual(dataLineChartValueExponent(1), 0)
    unittestEqual(dataLineChartValueExponent(999), 2)
    unittestEqual(dataLineChartValueExponent(1000), 3)
    unittestEqual(dataLineChartValueExponent(0.001), -3)
endfunction
unittestRunTest('testDataLineChartValueExponent')


function testDataLineChartSIPrefix():
    unittestEqual(dataLineChartSIPrefix(0), '')
    unittestEqual(dataLineChartSIPrefix(2), '')
    unittestEqual(dataLineChartSIPrefix(3), 'k')
    unittestEqual(dataLineChartSIPrefix(8), 'M')
    unittestEqual(dataLineChartSIPrefix(-1), 'm')
    unittestEqual(dataLineChartSIPrefix(-6), 'u')
    unittestEqual(dataLineChartSIPrefix(18), null)
    unittestEqual(dataLineChartSIPrefix(-18), null)
endfunction
unittestRunTest('testDataLineChartSIPrefix')


function testDataLineChartLabelExponent():
    unittestEqual(dataLineChartLabelExponent('si', 8), 6)
    unittestEqual(dataLineChartLabelExponent('exponential', 8), 8)
    unittestEqual(dataLineChartLabelExponent('decimal', 8), 8)
endfunction
unittestRunTest('testDataLineChartLabelExponent')


function testDataLineChartLabel():
    # A decimal label's precision is the place of its least significant digit
    unittestEqual(dataLineChartLabel(1.5, 'decimal', 0, -2), '1.50')
    unittestEqual(dataLineChartLabel(1.5, 'decimal', 0, 1), '2')

    # A scaled zero has no magnitude to name
    unittestEqual(dataLineChartLabel(0, 'si', 6, 6), '0')
    unittestEqual(dataLineChartLabel(0, 'exponential', 6, 6), '0')

    # A zero label exponent needs no suffix
    unittestEqual(dataLineChartLabel(5, 'si', 0, 0), '5')
    unittestEqual(dataLineChartLabel(5, 'exponential', 0, 0), '5')

    # Values outside the SI prefix range fall back to exponential notation
    unittestEqual(dataLineChartLabel(1.5e6, 'si', 6, 5), '1.5M')
    unittestEqual(dataLineChartLabel(1.5e6, 'exponential', 6, 5), '1.5e6')
    unittestEqual(dataLineChartLabel(1e18, 'si', 18, 18), '1e18')
endfunction
unittestRunTest('testDataLineChartLabel')


function testDataLineChartLabelDecimals():
    unittestEqual(dataLineChartLabelDecimals(15, 2), 0)
    unittestEqual(dataLineChartLabelDecimals(12.5, 2), 1)
    unittestEqual(dataLineChartLabelDecimals(1.25, 2), 2)
    unittestEqual(dataLineChartLabelDecimals(1.23456, 2), 2)
endfunction
unittestRunTest('testDataLineChartLabelDecimals')


function testDataLineChartAxisAnnotationLabel():
    # A plain decimal or datetime annotation keeps the decimals its value needs
    decimalLabel = dataLineChartLabelNew('decimal', 0, 0, null, null)
    unittestEqual(dataLineChartAxisAnnotationLabel(decimalLabel, 2.25, null, null), '2.25')
    defaultLabel = dataLineChartLabelNew('default', null, null, null, 'month')
    unittestEqual(dataLineChartAxisAnnotationLabel(defaultLabel, datetimeNew(2024, 3, 15), null, null), '2024-03-15')

    # An annotation takes no fewer decimals than its axis's tick labels
    tenthsLabel = dataLineChartLabelNew('decimal', 0, -1, null, null)
    unittestEqual(dataLineChartAxisAnnotationLabel(tenthsLabel, 1, null, null), '1.0')
    unittestEqual(dataLineChartAxisAnnotationLabel(tenthsLabel, 1.25, null, null), '1.25')
    precisionLabel = dataLineChartLabelNew('decimal', 0, -4, 4, null)
    unittestEqual(dataLineChartAxisAnnotationLabel(precisionLabel, 1.07, 4, null), '1.0700')

    # A logarithmic axis shares no decimal count - each annotation takes its value's own
    logDecimalLabel = dataLineChartLabelNew('decimal', null, null, null, null)
    unittestEqual(dataLineChartAxisAnnotationLabel(logDecimalLabel, 0.5, null, null), '0.5')
    unittestEqual(dataLineChartAxisAnnotationLabel(logDecimalLabel, 100, null, null), '100')

    # A compacted annotation keeps up to three significant digits, and no more decimals than it needs
    siLabel = dataLineChartLabelNew('si', 6, 6, null, null)
    unittestEqual(dataLineChartAxisAnnotationLabel(siLabel, 15000000, null, null), '15M')
    unittestEqual(dataLineChartAxisAnnotationLabel(siLabel, 12500000, null, null), '12.5M')
    unittestEqual(dataLineChartAxisAnnotationLabel(siLabel, 12345678, null, null), '12.3M')

    # A compacted annotation, too, takes no fewer decimals than its axis's tick labels
    siTenthsLabel = dataLineChartLabelNew('si', 6, 5, null, null)
    unittestEqual(dataLineChartAxisAnnotationLabel(siTenthsLabel, 15000000, null, null), '15.0M')

    # A logarithmic axis scales each annotation by its own power of ten
    logLabel = dataLineChartLabelNew('si', null, null, null, null)
    unittestEqual(dataLineChartAxisAnnotationLabel(logLabel, 4200000, null, null), '4.2M')
    unittestEqual(dataLineChartAxisAnnotationLabel(logLabel, 4200, null, null), '4.2k')
endfunction
unittestRunTest('testDataLineChartAxisAnnotationLabel')

#
# Automatic datetime axis tests
#


# Test helper to get an axis's tick labels
function testDataLineChartAxisLabels(axis):
    labels = []
    for tick in objectGet(axis, 'ticks'):
        arrayPush(labels, arrayGet(tick, 1))
    endfor
    return labels
endfunction


# Test helper to get an axis's tick values
function testDataLineChartAxisValues(axis):
    values = []
    for tick in objectGet(axis, 'ticks'):
        arrayPush(values, arrayGet(tick, 0))
    endfor
    return values
endfunction


function testDataLineChartAxisDatetime():
    # The axis spans the data - the tick marks are the month boundaries within it
    axis = dataLineChartAxis(false, null, datetimeNew(2024, 1, 15), datetimeNew(2024, 5, 20), 6, null, null)
    unittestEqual(objectGet(axis, 'min'), datetimeNew(2024, 1, 15))
    unittestEqual(objectGet(axis, 'max'), datetimeNew(2024, 5, 20))
    unittestDeepEqual(testDataLineChartAxisValues(axis), [ \
        datetimeNew(2024, 2, 1), \
        datetimeNew(2024, 3, 1), \
        datetimeNew(2024, 4, 1), \
        datetimeNew(2024, 5, 1) \
    ])
    unittestDeepEqual(testDataLineChartAxisLabels(axis), ['2024-02', '03', '04', '05'])
    unittestEqual(arrayLength(objectGet(axis, 'subticks')), 0)
endfunction
unittestRunTest('testDataLineChartAxisDatetime')


function testDataLineChartAxisDatetime_pad():
    # A padded datetime axis rounds outward to the tick step boundaries either side of the data
    axis = dataLineChartAxis(false, null, datetimeNew(2024, 1, 15), datetimeNew(2024, 5, 20), 6, null, null, true)
    unittestEqual(objectGet(axis, 'min'), datetimeNew(2024, 1, 1))
    unittestEqual(objectGet(axis, 'max'), datetimeNew(2024, 6, 1))
    unittestDeepEqual(testDataLineChartAxisValues(axis), [ \
        datetimeNew(2024, 1, 1), \
        datetimeNew(2024, 2, 1), \
        datetimeNew(2024, 3, 1), \
        datetimeNew(2024, 4, 1), \
        datetimeNew(2024, 5, 1), \
        datetimeNew(2024, 6, 1) \
    ])
    unittestDeepEqual(testDataLineChartAxisLabels(axis), ['2024-01', '02', '03', '04', '05', '06'])
endfunction
unittestRunTest('testDataLineChartAxisDatetime_pad')


function testDataLineChartAxisDatetime_noGap():
    # An automatic axis does not round out to a tick step boundary - a six-month step rounded down
    # from late December opens the axis the previous July, leaving a fifth of the chart empty
    axis = dataLineChartAxis(false, null, datetimeNew(2023, 12, 28), datetimeNew(2026, 1, 1), 5, null, null)
    unittestEqual(objectGet(axis, 'min'), datetimeNew(2023, 12, 28))
    unittestEqual(objectGet(axis, 'max'), datetimeNew(2026, 1, 1))
    unittestDeepEqual(testDataLineChartAxisValues(axis), [ \
        datetimeNew(2024, 1, 1), \
        datetimeNew(2024, 7, 1), \
        datetimeNew(2025, 1, 1), \
        datetimeNew(2025, 7, 1), \
        datetimeNew(2026, 1, 1) \
    ])
    unittestDeepEqual(testDataLineChartAxisLabels(axis), ['2024-01', '07', '2025-01', '07', '2026-01'])
endfunction
unittestRunTest('testDataLineChartAxisDatetime_noGap')


function testDataLineChartAxisDatetime_fewTicks():
    # Fewer than two tick step boundaries fall within the data - a month step, and a range that fits
    # between two month boundaries - so the axis falls back to the rounded-out range
    axis = dataLineChartAxis(false, null, datetimeNew(2024, 1, 2), datetimeNew(2024, 1, 31), 2, null, null)
    unittestEqual(objectGet(axis, 'min'), datetimeNew(2024, 1, 1))
    unittestEqual(objectGet(axis, 'max'), datetimeNew(2024, 2, 1))
    unittestDeepEqual(testDataLineChartAxisLabels(axis), ['2024-01', '02'])
endfunction
unittestRunTest('testDataLineChartAxisDatetime_fewTicks')


function testDataLineChartAxisDatetime_year():
    # A range of many years steps by a "nice" number of years
    axis = dataLineChartAxis(false, null, datetimeNew(2001, 3, 15), datetimeNew(2024, 11, 20), 6, null, null)
    unittestEqual(objectGet(axis, 'min'), datetimeNew(2001, 3, 15))
    unittestEqual(objectGet(axis, 'max'), datetimeNew(2024, 11, 20))
    unittestDeepEqual(testDataLineChartAxisLabels(axis), ['2005', '2010', '2015', '2020'])
endfunction
unittestRunTest('testDataLineChartAxisDatetime_year')


function testDataLineChartAxisDatetime_day():
    axis = dataLineChartAxis(false, null, datetimeNew(2024, 3, 4), datetimeNew(2024, 3, 8), 6, null, null)
    unittestEqual(objectGet(axis, 'min'), datetimeNew(2024, 3, 4))
    unittestEqual(objectGet(axis, 'max'), datetimeNew(2024, 3, 8))
    unittestDeepEqual(testDataLineChartAxisLabels(axis), ['2024-03-04', '05', '06', '07', '08'])
endfunction
unittestRunTest('testDataLineChartAxisDatetime_day')


function testDataLineChartAxisDatetime_format():
    # An explicit datetime format overrides the format computed from the tick step
    axis = dataLineChartAxis(false, null, datetimeNew(2024, 1, 15), datetimeNew(2024, 5, 20), 6, null, 'year')
    unittestDeepEqual(testDataLineChartAxisLabels(axis), ['2024', '2024', '2024', '2024'])
endfunction
unittestRunTest('testDataLineChartAxisDatetime_format')


function testDataLineChartAxisDatetime_single():
    # A constant datetime axis expands by a day either side
    axis = dataLineChartAxis(false, null, datetimeNew(2024, 6, 12), datetimeNew(2024, 6, 12), 6, null, null)
    unittestEqual(objectGet(axis, 'min'), datetimeNew(2024, 6, 11))
    unittestEqual(objectGet(axis, 'max'), datetimeNew(2024, 6, 13))
    unittestDeepEqual(testDataLineChartAxisLabels(axis), \
        ['2024-06-11', '12:00', '2024-06-12', '12:00', '2024-06-13'])
endfunction
unittestRunTest('testDataLineChartAxisDatetime_single')


#
# dataLineChartNiceStep tests
#


function testDataLineChartNiceStep():
    unittestDeepEqual(dataLineChartNiceStep(1), [1, 0])
    unittestDeepEqual(dataLineChartNiceStep(1.5), [2, 0])
    unittestDeepEqual(dataLineChartNiceStep(3), [5, 0])
    unittestDeepEqual(dataLineChartNiceStep(7), [10, 1])
    unittestDeepEqual(dataLineChartNiceStep(0.015), [0.02, -2])
endfunction
unittestRunTest('testDataLineChartNiceStep')


function testDataLineChartLabelContext():
    # The first label of an axis carries its full context
    unittestEqual(dataLineChartLabelContext('2024-01', null), '2024-01')

    # A label drops the context it shares with the previous label
    unittestEqual(dataLineChartLabelContext('2024-07', '2024-01'), '07')
    unittestEqual(dataLineChartLabelContext('2024-03-05', '2024-03-04'), '05')
    unittestEqual(dataLineChartLabelContext('2024-06-12T06:00', '2024-06-12'), '06:00')
    unittestEqual(dataLineChartLabelContext('2024-06-12T12:00', '2024-06-12T06:00'), '12:00')

    # Nothing is shared up to a separator
    unittestEqual(dataLineChartLabelContext('2025-01', '2024-07'), '2025-01')
    unittestEqual(dataLineChartLabelContext('1970', '1960'), '1970')
    unittestEqual(dataLineChartLabelContext('2024', '2024'), '2024')

    # A label that reverts to a coarser form starts its own context
    unittestEqual(dataLineChartLabelContext('2024-06-13', '2024-06-12T18:00'), '2024-06-13')
endfunction
unittestRunTest('testDataLineChartLabelContext')


#
# dataLineChartDatetimeFloor / dataLineChartDatetimeAdd tests
#


function testDataLineChartDatetimeFloor():
    value = datetimeNew(2023, 7, 15, 13, 24, 36, 456)
    unittestEqual(dataLineChartDatetimeFloor(value, 'year', 5), datetimeNew(2020, 1, 1))
    unittestEqual(dataLineChartDatetimeFloor(value, 'month', 3), datetimeNew(2023, 7, 1))
    unittestEqual(dataLineChartDatetimeFloor(value, 'day', 1), datetimeNew(2023, 7, 15))
    unittestEqual(dataLineChartDatetimeFloor(value, 'hour', 6), datetimeNew(2023, 7, 15, 12))
    unittestEqual(dataLineChartDatetimeFloor(value, 'minute', 15), datetimeNew(2023, 7, 15, 13, 15))
    unittestEqual(dataLineChartDatetimeFloor(value, 'second', 30), datetimeNew(2023, 7, 15, 13, 24, 30))
    unittestEqual(dataLineChartDatetimeFloor(value, 'millisecond', 100), datetimeNew(2023, 7, 15, 13, 24, 36, 400))
endfunction
unittestRunTest('testDataLineChartDatetimeFloor')


function testDataLineChartDatetimeAdd():
    value = datetimeNew(2023, 12, 31, 23, 59, 59, 999)
    unittestEqual(dataLineChartDatetimeAdd(value, 'year', 2), datetimeNew(2025, 12, 31, 23, 59, 59, 999))
    unittestEqual(dataLineChartDatetimeAdd(value, 'month', 1), datetimeNew(2024, 1, 31, 23, 59, 59, 999))
    unittestEqual(dataLineChartDatetimeAdd(value, 'day', 1), datetimeNew(2024, 1, 1, 23, 59, 59, 999))
    unittestEqual(dataLineChartDatetimeAdd(value, 'hour', 1), datetimeNew(2024, 1, 1, 0, 59, 59, 999))
    unittestEqual(dataLineChartDatetimeAdd(value, 'minute', 1), datetimeNew(2024, 1, 1, 0, 0, 59, 999))
    unittestEqual(dataLineChartDatetimeAdd(value, 'second', 1), datetimeNew(2024, 1, 1, 0, 0, 0, 999))
    unittestEqual(dataLineChartDatetimeAdd(value, 'millisecond', 1), datetimeNew(2024, 1, 1))
endfunction
unittestRunTest('testDataLineChartDatetimeAdd')


#
# dataLineChartAxisClamp tests
#


function testDataLineChartAxisClamp_none():
    axis = dataLineChartAxis(false, null, 3.2, 47.8, 5, null, null)
    unittestDeepEqual(dataLineChartAxisClamp(axis, null, null), axis)
endfunction
unittestRunTest('testDataLineChartAxisClamp_none')


function testDataLineChartAxisClamp_min():
    unittestDeepEqual(dataLineChartAxisClamp(dataLineChartAxis(false, null, 3.2, 47.8, 5, null, null), 10, null), { \
        'base': 10, \
        'label': {'datetime': null, 'exponent': 1, 'kind': 'decimal', 'precision': null, 'significant': 1}, \
        'log': false, \
        'max': 47.8, \
        'min': 10, \
        'range': 37.8, \
        'subticks': [], \
        'ticks': [[10, '10'], [20, '20'], [30, '30'], [40, '40']] \
    })
endfunction
unittestRunTest('testDataLineChartAxisClamp_min')


function testDataLineChartAxisClamp_minMax():
    unittestDeepEqual(dataLineChartAxisClamp(dataLineChartAxis(false, null, 12, 88, 5, null, null), 0, 100), { \
        'base': 0, \
        'label': {'datetime': null, 'exponent': 1, 'kind': 'decimal', 'precision': null, 'significant': 1}, \
        'log': false, \
        'max': 100, \
        'min': 0, \
        'range': 100, \
        'subticks': [], \
        'ticks': [[20, '20'], [40, '40'], [60, '60'], [80, '80']] \
    })
endfunction
unittestRunTest('testDataLineChartAxisClamp_minMax')


function testDataLineChartAxisClamp_logSubticks():
    # Sub-tick marks are bare values rather than [value, label] pairs, and are clamped too
    unittestDeepEqual(dataLineChartAxisClamp(dataLineChartAxis(true, null, 3, 90, 8, null, null), 5, 50), { \
        'base': 0.6989700043360187, \
        'label': {'datetime': null, 'exponent': null, 'kind': 'decimal', 'precision': null, 'significant': null}, \
        'log': true, \
        'max': 50, \
        'min': 5, \
        'range': 0.9999999999999998, \
        'subticks': [6, 7, 8, 9, 30, 40], \
        'ticks': [[5, '5'], [10, '10'], [20, '20'], [50, '50']] \
    })
endfunction
unittestRunTest('testDataLineChartAxisClamp_logSubticks')


function testDataLineChartAxisClamp_datetime():
    # The range stays clear of a daylight-saving transition, which the runtimes account for
    # differently and which would make the millisecond range implementation-dependent
    axis = dataLineChartAxis(false, null, datetimeNew(2024, 6, 10), datetimeNew(2024, 9, 20), 5, null, null)
    unittestDeepEqual(dataLineChartAxisClamp(axis, datetimeNew(2024, 7, 1), datetimeNew(2024, 9, 1)), { \
        'base': datetimeNew(2024, 7, 1), \
        'label': {'datetime': 'month', 'exponent': null, 'kind': 'default', 'precision': null, 'significant': null}, \
        'log': false, \
        'max': datetimeNew(2024, 9, 1), \
        'min': datetimeNew(2024, 7, 1), \
        'range': 5356800000, \
        'subticks': [], \
        'ticks': [ \
            [datetimeNew(2024, 7, 1), '2024-07'], \
            [datetimeNew(2024, 8, 1), '08'], \
            [datetimeNew(2024, 9, 1), '09'] \
        ] \
    })
endfunction
unittestRunTest('testDataLineChartAxisClamp_datetime')


#
# dataLineChartClipSegment tests
#


function testDataLineChartClipSegment():
    # Entirely inside - returned unchanged
    unittestDeepEqual(dataLineChartClipSegment(10, 10, 90, 90, 0, 0, 100, 100), [10, 10, 90, 90])

    # Crossing an edge - cut at the boundary
    unittestDeepEqual(dataLineChartClipSegment(50, 50, 50, -50, 0, 0, 100, 100), [50, 50, 50, 0])

    # Spanning the area - cut at both boundaries
    unittestDeepEqual(dataLineChartClipSegment(-10, 50, 110, 50, 0, 0, 100, 100), [0, 50, 100, 50])

    # Spanning it the other way round, so the segment enters at the far edge
    unittestDeepEqual(dataLineChartClipSegment(110, 50, -10, 50, 0, 0, 100, 100), [100, 50, 0, 50])
    unittestDeepEqual(dataLineChartClipSegment(50, 110, 50, -10, 0, 0, 100, 100), [50, 100, 50, 0])
endfunction
unittestRunTest('testDataLineChartClipSegment')


function testDataLineChartClipSegment_outside():
    # Entirely beyond an edge it is not parallel to
    unittestEqual(dataLineChartClipSegment(-30, 10, -10, 90, 0, 0, 100, 100), null)

    # Parallel to an edge and entirely beyond it
    unittestEqual(dataLineChartClipSegment(10, -20, 90, -20, 0, 0, 100, 100), null)
    unittestEqual(dataLineChartClipSegment(-20, 10, -20, 90, 0, 0, 100, 100), null)
endfunction
unittestRunTest('testDataLineChartClipSegment_outside')


function testDataLineChartElements_axisRange():
    # An explicit range holds the axis to it - the tick marks are the nice values inside the range,
    # and the point at 150 is clipped to the top of the chart area rather than drawn above it
    data = [ \
        {'A': 0, 'B': 40}, \
        {'A': 1, 'B': 60}, \
        {'A': 2, 'B': 150}, \
        {'A': 3, 'B': 55} \
    ]
    lineChart = dataLineChartValidate({ \
        'x': 'A', \
        'y': ['B'], \
        'yMin': 0, \
        'yMax': 100, \
        'width': 320, \
        'height': 200 \
    })
    unittestDeepEqual(dataLineChartElements(data, lineChart), { \
        'attr': {'aria-label': 'Line chart of B by A', 'height': 200, 'role': 'img', 'width': 320}, \
        'elem': [ \
            { \
                'attr': { \
