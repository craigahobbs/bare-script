function testDataLineChartElements_labelOverflow():
    # Labels that do not fit are kept on the chart - the Y-axis makes room for its tick labels and
    # gives up its title, and the chart title and category labels are fitted with an ellipsis
    data = [ \
        {'A': 1, 'B': 0, 'C': 'a very long category name indeed'}, \
        {'A': 5, 'B': 250000000, 'C': 'a very long category name indeed'} \
    ]
    lineChart = dataLineChartValidate({ \
        'title': 'a very long chart title that does not fit', \
        'x': 'A', \
        'y': ['B'], \
        'color': 'C', \
        'yFormat': 'decimal', \
        'width': 260, \
        'height': 200 \
    })
    unittestDeepEqual(dataLineChartElements(data, lineChart), { \
        'attr': {'aria-label': 'a very long chart title that does not fit', 'height': 200, 'role': 'img', 'width': 260}, \
