include '../dataLineChart.bare'
include '../unittest.bare'
include '../unittestMock.bare'


#
# dataLineChartValidate tests
#


function testDataLineChartValidate():
    lineChart = {'x': 'A', 'y': ['B']}
    unittestDeepEqual(dataLineChartValidate(lineChart), lineChart)
endfunction
unittestRunTest('testDataLineChartValidate')


function testDataLineChartValidate_error():
    unittestMockAll()
    lineChart = {'x': 1, 'y': ['B']}
    unittestEqual(dataLineChartValidate(lineChart), null)
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemLogDebug', ['schema.bare: Invalid value 1 (type "number") for member "x", expected type "string"']] \
    ])
endfunction
unittestRunTest('testDataLineChartValidate_error')


function testDataLineChartValidateEx():
    lineChart = {'x': 'A', 'y': ['B']}
    unittestDeepEqual(dataLineChartValidateEx(lineChart), {'result': lineChart})
endfunction
unittestRunTest('testDataLineChartValidateEx')


function testDataLineChartValidateEx_error():
    unittestDeepEqual( \
        dataLineChartValidateEx({'x': 1, 'y': ['B']}), \
        {'error': 'Invalid value 1 (type "number") for member "x", expected type "string"', 'memberFqn': 'x'} \
    )
endfunction
unittestRunTest('testDataLineChartValidateEx_error')


function testDataLineChartValidate_scale():
    lineChart = {'x': 'A', 'y': ['B'], 'xScale': 'log', 'yScale': 'linear'}
    unittestDeepEqual(dataLineChartValidate(lineChart), lineChart)
endfunction
unittestRunTest('testDataLineChartValidate_scale')


function testDataLineChartValidate_pad():
    lineChart = {'x': 'A', 'y': ['B'], 'xPad': true, 'yPad': false}
    unittestDeepEqual(dataLineChartValidate(lineChart), lineChart)
endfunction
unittestRunTest('testDataLineChartValidate_pad')


