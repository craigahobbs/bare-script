function testDataLineChartElements_title():
    data = [ \
        {'A': 1, 'B': 5}, \
        {'A': 5, 'B': 1} \
    ]
    lineChart = dataLineChartValidate({ \
        'x': 'A', \
        'y': ['B'], \
        'title': 'Hello!' \
    })
