function testDataLineChartElements_labelsFit():
    # The tick count is reduced until the tick labels fit without overlapping - a month of daily data
    # takes two reductions before its date labels clear one another. June has no daylight-saving
    # transition, so the tick coordinates are the same in every time zone.
    data = []
    ixDay = 0
    while ixDay < 30:
        arrayPush(data, {'A': datetimeNew(2024, 6, 1 + ixDay), 'B': 100 + ixDay})
        ixDay = ixDay + 1
    endwhile
    lineChart = dataLineChartValidate({'x': 'A', 'y': ['B'], 'width': 480, 'height': 200})
    unittestDeepEqual(dataLineChartElements(data, lineChart), { \
        'attr': {'aria-label': 'Line chart of B by A', 'height': 200, 'role': 'img', 'width': 480}, \
        'elem': [ \
