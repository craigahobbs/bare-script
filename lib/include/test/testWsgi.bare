#
# wsgiStatic tests
#


function testWsgiStatic():
    unittestMockAll()
    staticFn = wsgiStatic('Hello')
    unittestDeepEqual(staticFn({'PATH_INFO': '/index.html'}), { \
        'status': '200 OK', \
        'headers': [['Content-Type', 'text/html; charset=utf-8']], \
        'content': 'Hello' \
    })
    unittestDeepEqual(staticFn({}), testWsgiText('200 OK', 'Hello'))

    staticFn = wsgiStatic([1, 2, 3], 'image/png')
    unittestDeepEqual(staticFn({'PATH_INFO': '/index.html'}), { \
        'status': '200 OK', \
        'headers': [['Content-Type', 'image/png']], \
        'content': [1, 2, 3] \
    })

    staticFn = wsgiStatic(null)
    unittestDeepEqual(staticFn({}), testWsgiText('404 Not Found', '404 Not Found'))
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testWsgiStatic')


#
# wsgiStaticRequests tests
#


function testWsgiStaticRequestsCall(request):
    requestFn = objectGet(request, 'function')
    return requestFn({})
endfunction


async function testWsgiStaticRequests():
    unittestMockAll({'systemFetch': { \
        '../frontend/index.html': '<html></html>', \
        '../frontend/logo.png': [137, 80, 78, 71] \
    }})
    requests = wsgiStaticRequests( \
        {'/index.html': 'frontend/index.html', '/': 'frontend/index.html', '/logo.png': 'frontend/logo.png', '/x.bin': 'x.bin'}, \
        '../' \
    )

    # The request objects, in URL path order
    summaries = []
    for request in requests:
        arrayPush(summaries, [objectGet(request, 'method'), objectGet(request, 'path'), objectGet(request, 'docGroup')])
    endfor
    unittestDeepEqual(summaries, [ \
        ['GET', '/', 'Statics'], \
        ['GET', '/index.html', 'Statics'], \
        ['GET', '/logo.png', 'Statics'], \
        ['GET', '/x.bin', 'Statics'] \
    ])

    # Text files are fetched as text, other files as byte value arrays, and a missing file is not found
    htmlResponse = { \
        'status': '200 OK', 'headers': [['Content-Type', 'text/html; charset=utf-8']], 'content': '<html></html>' \
    }
    unittestDeepEqual(testWsgiStaticRequestsCall(arrayGet(requests, 0)), htmlResponse)
    unittestDeepEqual(testWsgiStaticRequestsCall(arrayGet(requests, 1)), htmlResponse)
    unittestDeepEqual( \
        testWsgiStaticRequestsCall(arrayGet(requests, 2)), \
        {'status': '200 OK', 'headers': [['Content-Type', 'image/png']], 'content': [137, 80, 78, 71]} \
    )
    unittestDeepEqual(testWsgiStaticRequestsCall(arrayGet(requests, 3)), testWsgiText('404 Not Found', '404 Not Found'))

    # The static files are fetched in one request
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', [[ \
            {'url': '../frontend/index.html', 'binary': false}, \
            {'url': '../frontend/index.html', 'binary': false}, \
            {'url': '../frontend/logo.png', 'binary': true}, \
            {'url': '../x.bin', 'binary': true} \
        ]]] \
    ])

    # No source prefix
    unittestMockAll({'systemFetch': {'frontend/index.html': '<html></html>'}})
    requests = wsgiStaticRequests({'/index.html': 'frontend/index.html'})
    unittestDeepEqual(testWsgiStaticRequestsCall(arrayGet(requests, 0)), htmlResponse)
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemFetch', [[{'url': 'frontend/index.html', 'binary': false}]]] \
    ])
endfunction
unittestRunTest('testWsgiStaticRequests')


#
# wsgiContentType tests
#


function testWsgiContentType():
    unittestMockAll()
    unittestEqual(wsgiContentType('/index.html'), 'text/html; charset=utf-8')
    unittestEqual(wsgiContentType('/images/logo.PNG', true), 'image/png')
    unittestEqual(wsgiContentType('/file.unknown'), 'text/plain; charset=utf-8')
    unittestEqual(wsgiContentType('/file.unknown', true), 'application/octet-stream')
    unittestEqual(wsgiContentType('/a.b/file'), 'text/plain; charset=utf-8')
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testWsgiContentType')


#
# Documentation application tests
#


async function testWsgiAPIDoc():
    unittestMockAll()
    app = wsgiCreateAPIApplication(testWsgiTypes, {'doc': true, 'requests': [ \
        {'type': 'action', 'name': 'testWsgiDouble', 'path': '/double', 'function': testWsgiDouble}, \
        {'type': 'action', 'name': 'testWsgiSum', 'docGroup': 'Math', 'function': testWsgiSum}, \
        {'type': 'action', 'name': 'testWsgiEmpty', 'wsgi': true, 'function': testWsgiCustom}, \
        {'type': 'request', 'path': '/hello', 'function': wsgiStatic('Hello!')}, \
        {'type': 'request', 'path': '/lines', 'doc': ['Line 1', 'Line 2'], 'function': wsgiStatic('Lines!')} \
    ]})

    # Redirect
    unittestDeepEqual(app(testWsgiEnviron('GET', '/doc')), { \
        'status': '301 Moved Permanently', \
        'headers': [['Content-Type', 'text/plain; charset=utf-8'], ['Location', 'doc/']], \
        'content': '/doc/' \
    })

    # Application HTML - runs the wsgiAPIDoc.bare include library's application
    response = app(testWsgiEnviron('GET', '/doc/'))
    unittestDeepEqual(objectGet(response, 'headers'), [['Content-Type', 'text/html; charset=utf-8']])
    unittestEqual(stringStartsWith(objectGet(response, 'content'), '<!DOCTYPE html>\n'), true)
    unittestEqual(stringIndexOf(objectGet(response, 'content'), 'include <wsgiAPIDoc.bare>\\n\\nwsgiAPIDocMain()') != -1, true)

    # Index
    unittestDeepEqual(app(testWsgiEnviron('GET', '/doc/docIndex')), testWsgiJSON('200 OK', { \
        'title': 'API Documentation', \
        'groups': { \
            'Documentation': ['wsgiAPIDoc', 'wsgiAPIDocIndex', 'wsgiAPIDocRedirect', 'wsgiAPIDocRequest'], \
            'Math': ['testWsgiSum'], \
            'Test': ['testWsgiDouble', 'testWsgiEmpty'], \
            'Uncategorized': ['/hello', '/lines'] \
        } \
    }))
    environ = testWsgiEnviron('GET', '/doc/docIndex')
    objectSet(environ, 'SERVER_NAME', 'localhost')
    unittestEqual(objectGet(jsonParse(objectGet(app(environ), 'content')), 'title'), 'localhost')
    objectSet(environ, 'HTTP_HOST', 'localhost:8080')
    unittestEqual(objectGet(jsonParse(objectGet(app(environ), 'content')), 'title'), 'localhost:8080')

    # Action requests
    unittestDeepEqual(app(testWsgiEnviron('GET', '/doc/docRequest', 'name=testWsgiDouble')), testWsgiJSON('200 OK', { \
        'name': 'testWsgiDouble', \
        'urls': [{'path': '/double'}], \
        'types': schemaGetReferencedTypes(testWsgiTypes, 'testWsgiDouble') \
    }))
    unittestDeepEqual(app(testWsgiEnviron('GET', '/doc/docRequest', 'name=testWsgiEmpty')), testWsgiJSON('200 OK', { \
        'name': 'testWsgiEmpty', \
        'urls': [{'method': 'GET', 'path': '/testWsgiEmpty'}], \
        'types': schemaGetReferencedTypes(testWsgiTypes, 'testWsgiEmpty'), \
        'custom': true \
    }))

    # Non-action requests
    unittestDeepEqual(app(testWsgiEnviron('GET', '/doc/docRequest', 'name=/hello')), testWsgiJSON('200 OK', { \
        'name': '/hello', \
        'urls': [{'path': '/hello'}] \
    }))
    unittestDeepEqual(app(testWsgiEnviron('GET', '/doc/docRequest', 'name=/lines')), testWsgiJSON('200 OK', { \
        'name': '/lines', \
        'urls': [{'path': '/lines'}], \
        'doc': ['Line 1', 'Line 2'] \
    }))
    unittestDeepEqual(app(testWsgiEnviron('GET', '/doc/docRequest', 'name=wsgiAPIDoc')), testWsgiJSON('200 OK', { \
        'name': 'wsgiAPIDoc', \
        'urls': [{'method': 'GET', 'path': '/doc/'}], \
        'doc': ['The API documentation application HTML'] \
    }))

    # Unknown requests
    unknownName = testWsgiJSON('400 Bad Request', {'error': 'UnknownName'})
    unittestDeepEqual(app(testWsgiEnviron('GET', '/doc/docRequest', 'name=unknown')), unknownName)
    unittestDeepEqual(app(testWsgiEnviron('GET', '/doc/docRequest')), unknownName)
    unittestDeepEqual(app(testWsgiEnviron('GET', '/doc/docRequest', 'name.0=a')), unknownName)
    unittestDeepEqual(app(testWsgiEnviron('GET', '/doc/docRequest', '0=a')), unknownName)
    unittestDeepEqual(app(testWsgiEnviron('GET', '/doc/docRequest', 'name=%')), unknownName)
    unittestDeepEqual(unittestMockEnd(), [['systemLogDebug', ["url.bare: Invalid percent-encoding '%'"]]])
endfunction
unittestRunTest('testWsgiAPIDoc')
