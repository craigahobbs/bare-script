unittestRunTest('testSchemaTypeModelValidateStructEmpty')


function testSchemaTypeModelValidateStructInconsistentTypeNameAndDuplicateMember():
    unittestMockAll()
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStructWrong', \
                'members': [ \
                    {'name': 'a', 'type': {'builtin': 'int'}}, \
                    {'name': 'a', 'type': {'builtin': 'string'}} \
                ] \
            } \
        } \
    }
    unittestDeepEqual( \
        schemaTypeModelValidateEx(types), \
        {'errors': [ \
            'Inconsistent type name "MyStructWrong" for "MyStruct"', \
            'Redefinition of "MyStruct" member "a"' \
        ]} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaTypeModelValidateStructInconsistentTypeNameAndDuplicateMember')


