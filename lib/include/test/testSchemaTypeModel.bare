function testSchemaTypeModelValidateCircularTypedef():
    unittestMockAll()

    # Circular typedef chain
    types = { \
        'MyTypedef': { \
            'typedef': { \
                'name': 'MyTypedef', \
                'type': {'user': 'MyTypedef2'} \
            } \
        }, \
        'MyTypedef2': { \
            'typedef': { \
                'name': 'MyTypedef2', \
                'type': {'user': 'MyTypedef'} \
            } \
        } \
    }
    unittestDeepEqual( \
        schemaTypeModelValidateEx(types), \
        {'errors': [ \
            'Circular typedef detected for type "MyTypedef"', \
            'Circular typedef detected for type "MyTypedef2"' \
        ]} \
    )

    # Self-referential typedef with attributes (the reference implementations stack-overflow on this input)
    types = { \
        'MyTypedef': { \
            'typedef': { \
                'name': 'MyTypedef', \
                'type': {'user': 'MyTypedef'}, \
                'attr': {'gt': 0} \
            } \
        } \
    }
    unittestDeepEqual( \
        schemaTypeModelValidateEx(types), \
        {'errors': [ \
            'Circular typedef detected for type "MyTypedef"', \
            'Invalid attribute "> 0" from "MyTypedef"' \
        ]} \
    )

    # Struct whose base is a circular typedef
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStruct', \
                'bases': ['MyTypedef'] \
            } \
        }, \
        'MyTypedef': { \
            'typedef': { \
                'name': 'MyTypedef', \
                'type': {'user': 'MyTypedef'} \
            } \
        } \
    }
    unittestDeepEqual( \
        schemaTypeModelValidateEx(types), \
        {'errors': [ \
            'Invalid struct base type "MyTypedef"', \
            'Circular typedef detected for type "MyTypedef"' \
        ]} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaTypeModelValidateCircularTypedef')


