function testSchemaTypeModelValidateStructMemberAttributesInvalid():
    unittestMockAll()
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStruct', \
                'members': [ \
                    {'name': 'a', 'type': {'builtin': 'int'}, 'attr': {'gt': 0, 'lte': 10, 'lenGT': 0, 'lenLTE': 10}} \
                ] \
            } \
        } \
    }
    unittestDeepEqual( \
        schemaTypeModelValidateEx(types), \
        {'errors': [ \
            'Invalid attribute "len <= 10" from "MyStruct" member "a"', \
