                'bases': ['MyTypedef'] \
            } \
        }, \
        'MyStruct3': { \
            'struct': { \
                'name': 'MyStruct3' \
            } \
        }, \
        'MyTypedef': { \
            'typedef': { \
                'name': 'MyTypedef', \
                'type': {'user': 'MyStruct3'} \
            } \
        } \
    }
    unittestDeepEqual(schemaTypeModelValidate(types), types)
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaTypeModelValidateStructBase')


