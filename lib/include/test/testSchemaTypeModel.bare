include '../schemaTypeModel.bare'
include '../unittest.bare'
include '../unittestMock.bare'


function testSchemaTypeModel():
    unittestMockAll()
    typeModel = schemaTypeModel()
    unittestEqual(objectHas(typeModel, 'Types'), true)
    unittestEqual(objectHas(typeModel, 'Type'), true)
    unittestEqual(objectHas(typeModel, 'Struct'), true)
    unittestEqual(objectHas(typeModel, 'Enum'), true)
    unittestEqual(objectHas(typeModel, 'Typedef'), true)
    unittestEqual(objectHas(typeModel, 'Action'), true)
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaTypeModel')


function testSchemaTypeModelValidate():
    unittestMockAll()
    typeModel = schemaTypeModel()
    validatedTypeModel = schemaTypeModelValidate(typeModel)
    unittestDeepEqual(validatedTypeModel, typeModel)

    # The validated type model is a transformed copy
    unittestEqual(systemIs(validatedTypeModel, typeModel), false)
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaTypeModelValidate')


function testSchemaTypeModelValidateError():
    unittestMockAll()
    types = { \
        'MyStruct': { \
            'struct': { \
                'name': 'MyStruct2' \
            } \
        } \
    }
    unittestDeepEqual( \
        schemaTypeModelValidateEx(types), \
        {'errors': ['Inconsistent type name "MyStruct2" for "MyStruct"']} \
    )

    # The plain form returns null and logs the errors
    unittestEqual(schemaTypeModelValidate(types), null)
    unittestDeepEqual(unittestMockEnd(), [ \
        ['systemLogDebug', ['schemaTypeModel.bare: Inconsistent type name "MyStruct2" for "MyStruct"']] \
    ])
endfunction
unittestRunTest('testSchemaTypeModelValidateError')


function testSchemaTypeModelValidateTypeValidationError():
    unittestMockAll()
    unittestDeepEqual( \
        schemaTypeModelValidateEx({'MyStruct': {'struct': {}}}), \
        {'errors': ['Required member "MyStruct.struct.name" missing']} \
    )
    unittestDeepEqual(unittestMockEnd(), [])
endfunction
unittestRunTest('testSchemaTypeModelValidateTypeValidationError')


