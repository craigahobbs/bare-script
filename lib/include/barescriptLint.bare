# $function: barescriptLintScript
# $group: barescriptLint.bare
# $doc: Lint a BareScript model
# $arg script: The [BareScript model](https://craigahobbs.github.io/bare-script/model/#var.vName='BareScript')
# $arg globals: Optional (default is null). The script's global variables. If provided, the unknown-global
# $arg globals: lint checks are performed.
# $arg asyncFunctions: Optional (default is null). The object of async global function names (name to true).
# $arg asyncFunctions: If provided along with globals, the async lint checks are performed.
# $return: The array of lint warning strings
function barescriptLintScript(script, globals, asyncFunctions):
    warnings = []
    statements = objectGet(script, 'statements')

    # Empty script?
    if arrayLength(statements) == 0:
        barescriptLintWarning(warnings, script, null, 'Empty script')
    endif

    # Variable used before assignment?
    varAssigns = {}
    varUses = {}
    barescriptLintGetVariableAssignmentsAndUses(statements, varAssigns, varUses)
    for varName in arraySort(objectKeys(varAssigns)):
        if objectHas(varUses, varName) && objectGet(varUses, varName) <= objectGet(varAssigns, varName):
            barescriptLintWarning(warnings, script, arrayGet(statements, objectGet(varUses, varName)), \
                'Global variable "' + varName + '" used before assignment')
        endif
    endfor

    # Unknown global variable?
    if globals != null:
        for varName in arraySort(objectKeys(varUses)):
            if !objectHas(varAssigns, varName) && !objectHas(globals, varName) && !objectHas(barescriptLintBuiltinGlobals, varName):
                barescriptLintWarning(warnings, script, arrayGet(statements, objectGet(varUses, varName)), \
                    'Unknown global variable "' + varName + '"')
            endif
        endfor
    endif

    # Iterate global statements
    functionsDefined = {}
    labelsDefined = {}
    labelsUsed = {}
    for statement, ixStatement in statements:
        # Function definition checks
        if objectHas(statement, 'function'):
            statementFunction = objectGet(statement, 'function')
            functionName = objectGet(statementFunction, 'name')

            # Function redefinition?
            if objectHas(functionsDefined, functionName):
                barescriptLintWarning(warnings, script, statement, 'Redefinition of function "' + functionName + '"')
            else:
                objectSet(functionsDefined, functionName, ixStatement)
            endif

            # Variable used before assignment?
            fnVarAssigns = {}
            fnVarUses = {}
            args = objectGet(statementFunction, 'args')
            fnStatements = objectGet(statementFunction, 'statements')
            barescriptLintGetVariableAssignmentsAndUses(fnStatements, fnVarAssigns, fnVarUses)
            fnVarAssignNames = arraySort(objectKeys(fnVarAssigns))
            for varName in fnVarAssignNames:
                # Ignore re-assigned function arguments
                if args != null && arrayIndexOf(args, varName) != -1:
                    continue
                endif
                if objectHas(fnVarUses, varName) && objectGet(fnVarUses, varName) <= objectGet(fnVarAssigns, varName):
                    barescriptLintWarning(warnings, script, arrayGet(fnStatements, objectGet(fnVarUses, varName)), \
                        'Variable "' + varName + '" of function "' + functionName + '" used before assignment')
                endif
            endfor

            # Unused variables?
            for varName in fnVarAssignNames:
                if !objectHas(fnVarUses, varName):
                    barescriptLintWarning(warnings, script, arrayGet(fnStatements, objectGet(fnVarAssigns, varName)), \
                        'Unused variable "' + varName + '" defined in function "' + functionName + '"')
                endif
            endfor

            # Unknown global variable?
            if globals != null:
                for varName in arraySort(objectKeys(fnVarUses)):
                    if !objectHas(fnVarAssigns, varName) && (args == null || arrayIndexOf(args, varName) == -1) && \
                            !objectHas(globals, varName) && !objectHas(barescriptLintBuiltinGlobals, varName):
                        barescriptLintWarning(warnings, script, arrayGet(fnStatements, objectGet(fnVarUses, varName)), \
                            'Unknown global variable "' + varName + '"')
                    endif
                endfor
            endif

            # Function argument checks
            if args != null:
                argsDefined = {}
                for arg in args:
                    # Duplicate argument?
                    if objectHas(argsDefined, arg):
                        barescriptLintWarning(warnings, script, statement, \
                            'Duplicate argument "' + arg + '" of function "' + functionName + '"')
                    else:
                        objectSet(argsDefined, arg, true)

                        # Unused argument?
                        if !objectHas(fnVarUses, arg):
                            barescriptLintWarning(warnings, script, statement, \
                                'Unused argument "' + arg + '" of function "' + functionName + '"')
                        endif
                    endif
                endfor
            endif

            # Iterate function statements
            fnLabelsDefined = {}
            fnLabelsUsed = {}
            isAsyncFunction = objectGet(statementFunction, 'async', false)
            hasAsyncStatement = false
            for fnStatement, ixFnStatement in fnStatements:
                # Any async statements?
                if globals != null && asyncFunctions != null:
                    hasAsyncStatement = hasAsyncStatement || barescriptLintIsAsyncStatement( \
                        fnStatement, globals, asyncFunctions, isAsyncFunction)
                endif

                # Function expression statement checks
                if objectHas(fnStatement, 'expr'):
                    # Pointless function expression statement?
                    fnStatementExpr = objectGet(fnStatement, 'expr')
                    if !objectHas(fnStatementExpr, 'name') && barescriptLintIsPointlessExpression(objectGet(fnStatementExpr, 'expr')):
                        barescriptLintWarning(warnings, script, statement, 'Pointless statement in function "' + functionName + '"')
                    endif

                # Function label statement checks
                elif objectHas(fnStatement, 'label'):
                    # Label redefinition?
                    fnStatementLabel = objectGet(objectGet(fnStatement, 'label'), 'name')
                    if objectHas(fnLabelsDefined, fnStatementLabel):
                        barescriptLintWarning(warnings, script, statement, \
                            'Redefinition of label "' + fnStatementLabel + '" in function "' + functionName + '"')
                    else:
                        objectSet(fnLabelsDefined, fnStatementLabel, ixFnStatement)
                    endif

                # Function jump statement checks
                elif objectHas(fnStatement, 'jump'):
                    fnStatementJumpLabel = objectGet(objectGet(fnStatement, 'jump'), 'label')
                    if !objectHas(fnLabelsUsed, fnStatementJumpLabel):
                        objectSet(fnLabelsUsed, fnStatementJumpLabel, ixFnStatement)
                    endif
                endif
            endfor

            # Unused function labels?
            for label in arraySort(objectKeys(fnLabelsDefined)):
                if !objectHas(fnLabelsUsed, label):
                    barescriptLintWarning(warnings, script, statement, \
                        'Unused label "' + label + '" in function "' + functionName + '"')
                endif
            endfor

            # Unknown function labels?
            for label in arraySort(objectKeys(fnLabelsUsed)):
                if !objectHas(fnLabelsDefined, label):
                    barescriptLintWarning(warnings, script, statement, \
                        'Unknown label "' + label + '" in function "' + functionName + '"')
                endif
            endfor

            # Async function issues?
            if globals != null && asyncFunctions != null:
                if objectGet(statementFunction, 'async') && !hasAsyncStatement:
                    barescriptLintWarning(warnings, script, statement, 'Unecessary async function "' + functionName + '"')
                elif !objectGet(statementFunction, 'async') && hasAsyncStatement:
                    barescriptLintWarning(warnings, script, statement, 'Function "' + functionName + '" requires async')
                endif
            endif

        # Global expression statement checks
        elif objectHas(statement, 'expr'):
            # Pointless global expression statement?
            statementExpr = objectGet(statement, 'expr')
            if !objectHas(statementExpr, 'name') && barescriptLintIsPointlessExpression(objectGet(statementExpr, 'expr')):
                barescriptLintWarning(warnings, script, statement, 'Pointless global statement')
            endif

        # Global label statement checks
        elif objectHas(statement, 'label'):
            # Label redefinition?
            statementLabel = objectGet(objectGet(statement, 'label'), 'name')
            if objectHas(labelsDefined, statementLabel):
                barescriptLintWarning(warnings, script, statement, 'Redefinition of global label "' + statementLabel + '"')
            else:
                objectSet(labelsDefined, statementLabel, ixStatement)
            endif

        # Global jump statement checks
        elif objectHas(statement, 'jump'):
            statementJumpLabel = objectGet(objectGet(statement, 'jump'), 'label')
            if !objectHas(labelsUsed, statementJumpLabel):
                objectSet(labelsUsed, statementJumpLabel, ixStatement)
            endif
        endif
    endfor

    # Unused global labels?
    for label in arraySort(objectKeys(labelsDefined)):
        if !objectHas(labelsUsed, label):
            barescriptLintWarning(warnings, script, arrayGet(statements, objectGet(labelsDefined, label)), \
                'Unused global label "' + label + '"')
        endif
    endfor

    # Unknown global labels?
    for label in arraySort(objectKeys(labelsUsed)):
        if !objectHas(labelsDefined, label):
            barescriptLintWarning(warnings, script, arrayGet(statements, objectGet(labelsUsed, label)), \
                'Unknown global label "' + label + '"')
        endif
    endfor

    return warnings
endfunction


# Builtin global variable names
barescriptLintBuiltinGlobals = {'false': true, 'if': true, 'null': true, 'true': true}


# Helper to format static analysis warnings
function barescriptLintWarning(warnings, script, statement, message):
    scriptName = objectGet(script, 'scriptName', '')
    lineno = if(statement != null, objectGet(objectGet(statement, arrayGet(objectKeys(statement), 0)), 'lineNumber', 1), 1)
    arrayPush(warnings, scriptName + ':' + lineno + ': ' + message)
endfunction


# Helper function to determine if an expression statement's expression is pointless
function barescriptLintIsPointlessExpression(expr):
    if objectHas(expr, 'function'):
        return false
    endif
    exprBinary = objectGet(expr, 'binary')
    if exprBinary != null:
        return barescriptLintIsPointlessExpression(objectGet(exprBinary, 'left')) && \
            barescriptLintIsPointlessExpression(objectGet(exprBinary, 'right'))
    endif
    exprUnary = objectGet(expr, 'unary')
    if exprUnary != null:
        return barescriptLintIsPointlessExpression(objectGet(exprUnary, 'expr'))
    endif
    exprGroup = objectGet(expr, 'group')
    if exprGroup != null:
        return barescriptLintIsPointlessExpression(exprGroup)
    endif
    return true
endfunction


# Helper function to determine if a statement requires async
function barescriptLintIsAsyncStatement(statement, globals, asyncFunctions, isAsyncScope):
    statementExpr = objectGet(statement, 'expr')
    if statementExpr != null:
        return barescriptLintIsAsyncExpression(objectGet(statementExpr, 'expr'), globals, asyncFunctions, isAsyncScope)
    endif
    statementReturn = objectGet(statement, 'return')
    if statementReturn != null:
        return if(objectHas(statementReturn, 'expr'), \
            barescriptLintIsAsyncExpression(objectGet(statementReturn, 'expr'), globals, asyncFunctions, isAsyncScope), false)
    endif
    statementJump = objectGet(statement, 'jump')
    if statementJump != null:
        return if(objectHas(statementJump, 'expr'), \
            barescriptLintIsAsyncExpression(objectGet(statementJump, 'expr'), globals, asyncFunctions, isAsyncScope), false)
    endif
    return objectHas(statement, 'include')
endfunction


# Helper function to determine if an expression requires async
function barescriptLintIsAsyncExpression(expr, globals, asyncFunctions, isAsyncScope):
    exprFunction = objectGet(expr, 'function')
    if exprFunction != null:
        # Builtin function?
        funcName = objectGet(exprFunction, 'name')
        if objectHas(barescriptLintBuiltinGlobals, funcName):
            return false
        endif

        # Is function async? Assume unknown OK for the scope
        isAsync = isAsyncScope
        funcValue = objectGet(globals, funcName)
        if systemType(funcValue) == 'function':
            isAsync = objectHas(asyncFunctions, funcName)
            args = objectGet(exprFunction, 'args')
            if !isAsync && args != null:
                for argExpr in args:
                    # A variable or literal argument is not async - only a nested expression is tested
                    if !objectHas(argExpr, 'variable') && !objectHas(argExpr, 'string') && !objectHas(argExpr, 'number') && \
                            barescriptLintIsAsyncExpression(argExpr, globals, asyncFunctions, isAsyncScope):
                        isAsync = true
                        break
                    endif
                endfor
            endif
        endif
        return isAsync
    endif
    exprBinary = objectGet(expr, 'binary')
    if exprBinary != null:
        return barescriptLintIsAsyncExpression(objectGet(exprBinary, 'left'), globals, asyncFunctions, isAsyncScope) || \
            barescriptLintIsAsyncExpression(objectGet(exprBinary, 'right'), globals, asyncFunctions, isAsyncScope)
    endif
    exprUnary = objectGet(expr, 'unary')
    if exprUnary != null:
        return barescriptLintIsAsyncExpression(objectGet(exprUnary, 'expr'), globals, asyncFunctions, isAsyncScope)
    endif
    exprGroup = objectGet(expr, 'group')
    if exprGroup != null:
        return barescriptLintIsAsyncExpression(exprGroup, globals, asyncFunctions, isAsyncScope)
    endif
    return false
endfunction


# Helper function to set variable assignments/uses for a statements array
function barescriptLintGetVariableAssignmentsAndUses(statements, assigns, uses):
    for statement, ixStatement in statements:
        statementExpr = objectGet(statement, 'expr')
        if statementExpr != null:
            exprName = objectGet(statementExpr, 'name')
            if exprName != null && !objectHas(assigns, exprName):
                objectSet(assigns, exprName, ixStatement)
            endif
            barescriptLintGetExpressionVariableUses(objectGet(statementExpr, 'expr'), uses, ixStatement)
        else:
            # A jump or return statement's expression, if it has one
            statementJumpReturn = objectGet(statement, 'jump')
            statementJumpReturn = if(statementJumpReturn != null, statementJumpReturn, objectGet(statement, 'return'))
            jumpReturnExpr = if(statementJumpReturn != null, objectGet(statementJumpReturn, 'expr'))
            if jumpReturnExpr != null:
                barescriptLintGetExpressionVariableUses(jumpReturnExpr, uses, ixStatement)
            endif
        endif
    endfor
endfunction


# Helper function to set variable uses for an expression
function barescriptLintGetExpressionVariableUses(expr, uses, ixStatement):
    exprFunction = objectGet(expr, 'function')
    if exprFunction != null:
        funcName = objectGet(exprFunction, 'name')
        if !objectHas(uses, funcName):
            objectSet(uses, funcName, ixStatement)
        endif
        args = objectGet(exprFunction, 'args')
        if args != null:
            for argExpr in args:
                # A variable argument is recorded here, a literal is skipped, and a nested expression is walked
                argVariable = objectGet(argExpr, 'variable')
                if argVariable != null:
                    if !objectHas(uses, argVariable):
                        objectSet(uses, argVariable, ixStatement)
                    endif
                elif !objectHas(argExpr, 'string') && !objectHas(argExpr, 'number'):
                    barescriptLintGetExpressionVariableUses(argExpr, uses, ixStatement)
                endif
            endfor
        endif
        return
    endif
    exprVariable = objectGet(expr, 'variable')
    if exprVariable != null:
        if !objectHas(uses, exprVariable):
            objectSet(uses, exprVariable, ixStatement)
        endif
        return
    endif
    exprBinary = objectGet(expr, 'binary')
    if exprBinary != null:
        barescriptLintGetExpressionVariableUses(objectGet(exprBinary, 'left'), uses, ixStatement)
        barescriptLintGetExpressionVariableUses(objectGet(exprBinary, 'right'), uses, ixStatement)
        return
    endif
    exprUnary = objectGet(expr, 'unary')
    if exprUnary != null:
        barescriptLintGetExpressionVariableUses(objectGet(exprUnary, 'expr'), uses, ixStatement)
        return
    endif
    exprGroup = objectGet(expr, 'group')
    if exprGroup != null:
        barescriptLintGetExpressionVariableUses(exprGroup, uses, ixStatement)
    endif
endfunction
