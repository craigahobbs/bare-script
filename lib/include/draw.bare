# Constants
drawDefaultDrawingWidth = 300
drawDefaultDrawingHeight = 200
drawDefaultFontFamily = 'Arial, Helvetica, sans-serif'
drawDefaultFontSize = 12
drawPixelsPerPoint = 4 / 3
drawSVGPrecision = 8


# The default font family's character advance widths, in thousandths of an em, for the printable
# ASCII range - the sixteen characters from space, then from "0", "@", "P", "`", and "p". Each is
# the widest that Arial and Helvetica draw the character, in either the regular or the bold weight,
# rounded up to the next thousandth - so text is measured no narrower than it draws, whichever of
# the family's faces renders it. The oblique faces have the regular ones' widths. This range covers
# the letters, the digits, and every punctuation mark a keyboard types - the parentheses, brackets,
# braces, and the period among them.
drawFontWidths = [ \
    278, 334, 475, 557, 557, 890, 723, 238, 334, 334, 390, 584, 278, 334, 278, 278, \
    557, 557, 557, 557, 557, 557, 557, 557, 557, 557, 334, 334, 584, 584, 584, 611, \
    1016, 723, 723, 723, 723, 667, 611, 778, 723, 278, 557, 723, 611, 834, 723, 778, \
    667, 778, 723, 667, 611, 723, 667, 944, 667, 667, 611, 334, 278, 334, 584, 557, \
    334, 557, 611, 557, 611, 557, 334, 611, 611, 278, 278, 557, 278, 890, 611, 611, \
    611, 611, 390, 557, 334, 611, 557, 778, 557, 557, 500, 390, 280, 390, 584 \
]
drawFontWidthFirst = 32


# The same for the Latin-1 supplement, the sixteen characters from the non-breaking space, then from
# the degree sign, "A-grave", "Eth", "a-grave", and "eth". The soft hyphen measures nothing, so it is
# measured as the hyphen a renderer draws in its place.
drawFontWidthsLatin = [ \
    278, 334, 557, 557, 557, 557, 280, 557, 334, 737, 371, 557, 584, 334, 737, 553, \
    400, 549, 334, 334, 334, 577, 557, 334, 334, 334, 366, 557, 834, 834, 834, 611, \
    723, 723, 723, 723, 723, 723, 1000, 723, 667, 667, 667, 667, 278, 278, 278, 278, \
    723, 723, 778, 778, 778, 778, 778, 584, 778, 723, 723, 723, 723, 667, 667, 611, \
    557, 557, 557, 557, 557, 557, 890, 557, 557, 557, 557, 557, 278, 278, 278, 278, \
    611, 611, 611, 611, 611, 611, 611, 549, 611, 611, 611, 611, 611, 557, 611, 557 \
]
drawFontWidthLatinFirst = 160


# The same again for the characters that turn up in chart titles, labels, and annotations beyond
# those ranges - the typographic punctuation and currency, the mathematical operators and arrows,
# and the Greek letters used as symbols.
drawFontWidthsOther = { \
    '–': 557, '—': 1000, '‘': 278, '’': 278, '‚': 278, '“': 500, '”': 500, '„': 500, \
    '†': 557, '‡': 557, '•': 351, '…': 1000, '‰': 1000, '′': 334, '″': 611, '‹': 334, \
    '›': 334, '€': 745, '™': 1000, \
    '−': 584, '≠': 549, '≤': 549, '≥': 549, '≈': 549, '∞': 713, '∂': 554, '∆': 612, \
    '∑': 713, '∏': 824, '√': 549, '∫': 274, '←': 1000, '↑': 723, '→': 1000, '↓': 723, \
    '↔': 1000, \
    'Α': 723, 'Β': 723, 'Γ': 611, 'Δ': 723, 'Ε': 667, 'Θ': 778, 'Λ': 668, 'Ξ': 650, \
    'Π': 723, 'Σ': 619, 'Φ': 821, 'Ψ': 836, 'Ω': 802, \
    'α': 615, 'β': 611, 'γ': 557, 'δ': 611, 'ε': 557, 'ζ': 461, 'η': 611, 'θ': 612, \
    'κ': 558, 'λ': 557, 'μ': 612, 'ν': 557, 'ξ': 500, 'π': 766, 'ρ': 619, 'σ': 685, \
    'τ': 500, 'φ': 723, 'χ': 576, 'ψ': 754, 'ω': 845 \
}


# The width of a character in none of the above. It stands in for a glyph the font family does not
# have, which a fallback font supplies at a width this library cannot know, so it is set wider than
# anything in the tables: the widest measured across CJK, kana, full-width, emoji, arrow and symbol
# samples is the numero sign, at 1115 in bold, and a run of CJK is shaped about 2% wider than its
# characters measure one at a time.
drawFontWidthOther = 1200


# The character advance widths by character code - the three tables above as one array, so that a
# text is measured with one array read per character code. A code past the end of the array, like
# a code in none of the tables, is measured at the unknown-glyph width.
drawFontWidthTableLength = 0
for char in objectKeys(drawFontWidthsOther):
    drawFontWidthTableLength = mathMax(drawFontWidthTableLength, stringCharCodeAt(char, 0) + 1)
endfor
drawFontWidthTable = arrayNewSize(drawFontWidthTableLength, drawFontWidthOther)
for charWidth, ixChar in drawFontWidths:
    arraySet(drawFontWidthTable, drawFontWidthFirst + ixChar, charWidth)
endfor
for charWidth, ixChar in drawFontWidthsLatin:
    arraySet(drawFontWidthTable, drawFontWidthLatinFirst + ixChar, charWidth)
endfor
for char in objectKeys(drawFontWidthsOther):
    arraySet(drawFontWidthTable, stringCharCodeAt(char, 0), objectGet(drawFontWidthsOther, char))
endfor


# The global drawing state
drawCurrentDrawing = null


# Helper to get or create the global drawing state
function drawGetCurrentDrawing():
    drawing = drawCurrentDrawing
    if drawing == null:
        drawNew()
        drawing = drawCurrentDrawing
    endif
    return drawing
endfunction


# Helper to get the current drawing's path, starting one if there is none. The path primitives
# call this once per segment, so the common case - a drawing with a path in progress - reads the
# drawing state directly rather than through drawGetCurrentDrawing.
function drawGetDrawingPath():
    drawing = drawCurrentDrawing
    drawingPath = if(drawing != null, objectGet(drawing, 'path'))
    if drawingPath == null:
        drawing = drawGetCurrentDrawing()
        svg = objectGet(drawing, 'svg')
        svgElem = objectGet(svg, 'elem')
        arrayPush(svgElem, { \
            'svg': 'path', \
            'attr': { \
                'fill': objectGet(drawing, 'fill'), \
                'stroke': objectGet(drawing, 'stroke'), \
                'stroke-width': objectGet(drawing, 'strokeWidth'), \
                'stroke-dasharray': objectGet(drawing, 'strokeDashArray'), \
                'd': '' \
            } \
        })
        drawingPath = []
        objectSet(drawing, 'path', drawingPath)
    endif
    return drawingPath
endfunction


# Helper to finish the current drawing's path, if there is one, and get the drawing. The shape and
# text primitives call this once per element, so the common case - a drawing with no path in
# progress - reads the drawing state directly rather than through drawGetCurrentDrawing.
function drawFinishDrawingPath():
    drawing = drawCurrentDrawing
    drawingPath = if(drawing != null, objectGet(drawing, 'path'))
    if drawingPath:
        svg = objectGet(drawing, 'svg')
        svgElem = objectGet(svg, 'elem')
        path = arrayGet(svgElem, arrayLength(svgElem) - 1)
        pathAttr = objectGet(path, 'attr')
        objectSet(pathAttr, 'd', arrayJoin(drawingPath, ' '))
        objectSet(drawing, 'path', null)
    elif drawing == null:
        drawing = drawGetCurrentDrawing()
    endif
    return drawing
endfunction


# $function: drawRender
# $group: draw.bare
# $doc: Render the current drawing
function drawRender():
    drawing = drawFinishDrawingPath()
    elementModelRender = systemGlobalGet('elementModelRender')
    elementModelRender({'html': 'p', 'elem': objectGet(drawing, 'svg')})
endfunction


# $function: drawElements
# $group: draw.bare
# $doc: Get the current drawing's SVG element model
# $return: The current drawing's SVG element model
function drawElements():
    drawing = drawFinishDrawingPath()
    return objectGet(drawing, 'svg')
endfunction


# $function: drawArc
# $group: draw.bare
# $doc: Draw an arc curve from the current point to the end point
# $arg rx: The arc ellipse's x-radius
# $arg ry: The arc ellipse's y-radius
# $arg angle: The rotation (in degrees) of the ellipse relative to the x-axis
# $arg largeArcFlag: Either large arc (1) or small arc (0)
# $arg sweepFlag: Either clockwise turning arc (1) or counterclockwise turning arc (0)
# $arg x: The x-coordinate of the end point
# $arg y: The y-coordinate of the end point
function drawArc(rx, ry, angle, largeArcFlag, sweepFlag, x, y):
    drawingPath = drawGetDrawingPath()
    arrayPush( \
        drawingPath, \
        'A ' + numberToFixed(rx, drawSVGPrecision) + ' ' + numberToFixed(ry, drawSVGPrecision) + ' ' +  \
            numberToFixed(angle, drawSVGPrecision) + if(largeArcFlag, ' 1', ' 0') +  if(sweepFlag, ' 1 ', ' 0 ') + \
            numberToFixed(x, drawSVGPrecision) + ' ' + numberToFixed(y, drawSVGPrecision) \
    )
endfunction


# $function: drawAriaLabel
# $group: draw.bare
# $doc: Set the current drawing's accessible name. Assistive technology announces the drawing as a
# $doc: single image with this name, instead of reading the text within it one piece at a time.
# $arg label: The accessible name, or null for none
function drawAriaLabel(label):
    drawing = drawGetCurrentDrawing()
    svg = objectGet(drawing, 'svg')
    svgAttr = objectGet(svg, 'attr')
    objectSet(svgAttr, 'role', if(label != null, 'img'))
    objectSet(svgAttr, 'aria-label', label)
endfunction


# $function: drawCircle
# $group: draw.bare
# $doc: Draw a circle
# $arg cx: The x-coordinate of the center of the circle
# $arg cy: The y-coordinate of the center of the circle
# $arg r: The radius of the circle
function drawCircle(cx, cy, r):
    drawing = drawFinishDrawingPath()
    svg = objectGet(drawing, 'svg')
    arrayPush(objectGet(svg, 'elem'), { \
        'svg': 'circle', \
        'attr': { \
            'fill': objectGet(drawing, 'fill'), \
            'stroke': objectGet(drawing, 'stroke'), \
            'stroke-width': numberToFixed(objectGet(drawing, 'strokeWidth'), drawSVGPrecision), \
            'stroke-dasharray': objectGet(drawing, 'strokeDashArray'), \
            'cx': cx, \
            'cy': cy, \
            'r': r \
        } \
    })
endfunction


# $function: drawClose
# $group: draw.bare
# $doc: Close the current drawing path
function drawClose():
    drawingPath = drawGetDrawingPath()
    arrayPush(drawingPath, 'Z')
endfunction


# $function: drawEllipse
# $group: draw.bare
# $doc: Draw an ellipse
# $arg cx: The x-coordinate of the center of the ellipse
# $arg cy: The y-coordinate of the center of the ellipse
# $arg rx: The x-radius of the ellipse
# $arg ry: The y-radius of the ellipse
function drawEllipse(cx, cy, rx, ry):
    drawing = drawFinishDrawingPath()
    svg = objectGet(drawing, 'svg')
    arrayPush(objectGet(svg, 'elem'), { \
        'svg': 'ellipse', \
        'attr': { \
            'fill': objectGet(drawing, 'fill'), \
            'stroke': objectGet(drawing, 'stroke'), \
            'stroke-width': numberToFixed(objectGet(drawing, 'strokeWidth'), drawSVGPrecision), \
            'stroke-dasharray': objectGet(drawing, 'strokeDashArray'), \
            'cx': cx, \
            'cy': cy, \
            'rx': rx, \
            'ry': ry \
        } \
    })
endfunction


# $function: drawHLine
# $group: draw.bare
# $doc: Draw a horizontal line from the current point to the end point
# $arg x: The x-coordinate of the end point
function drawHLine(x):
    drawingPath = drawGetDrawingPath()
    arrayPush(drawingPath, 'H ' + numberToFixed(x, drawSVGPrecision))
endfunction


# $function: drawHeight
# $group: draw.bare
# $doc: Get the current drawing's height
# $return: The current drawing's height
function drawHeight():
    drawing = drawGetCurrentDrawing()
    return objectGet(drawing, 'height')
endfunction


# $function: drawImage
# $group: draw.bare
# $doc: Draw an image
# $arg x: The x-coordinate of the center of the image
# $arg y: The y-coordinate of the center of the image
# $arg width: The width of the image
# $arg height: The height of the image
# $arg href: The image resource URL
function drawImage(x, y, width, height, href):
    drawing = drawFinishDrawingPath()
    svg = objectGet(drawing, 'svg')
    arrayPush(objectGet(svg, 'elem'), { \
        'svg': 'image', \
        'attr': { \
            'x': x, \
            'y': y, \
            'width': width, \
            'height': height, \
            'href': documentURL(href) \
        } \
    })
endfunction


# $function: drawLine
# $group: draw.bare
# $doc: Draw a line from the current point to the end point
# $arg x: The x-coordinate of the end point
# $arg y: The y-coordinate of the end point
function drawLine(x, y):
    drawingPath = drawGetDrawingPath()
    arrayPush(drawingPath, 'L ' + numberToFixed(x, drawSVGPrecision) + ' ' + numberToFixed(y, drawSVGPrecision))
endfunction


# $function: drawMove
# $group: draw.bare
# $doc: Move the path's drawing point
# $arg x: The x-coordinate of the new drawing point
# $arg y: The y-coordinate of the new drawing point
function drawMove(x, y):
    drawingPath = drawGetDrawingPath()
    arrayPush(drawingPath, 'M ' + numberToFixed(x, drawSVGPrecision) + ' ' + numberToFixed(y, drawSVGPrecision))
endfunction


# $function: drawNew
# $group: draw.bare
# $doc: Create a new drawing. The new drawing becomes the current drawing - all other "draw" functions
# $doc: operate on the current drawing. Call drawRender to render the current drawing.
# $arg width: The width of the drawing
# $arg height: The height of the drawing
function drawNew(width, height):
    width = if(width != null && width > 0, width, drawDefaultDrawingWidth)
    height = if(height != null && height > 0, height, drawDefaultDrawingHeight)
    drawing = { \
        'width': width, \
        'height': height, \
        'stroke': 'black', \
        'strokeWidth': 1, \
        'strokeDashArray': 'none', \
        'fill': 'none', \
        'fontFamily': drawDefaultFontFamily, \
        'fontSizePx': drawDefaultFontSize * drawPixelsPerPoint, \
        'fontFill': 'black', \
        'fontBold': false, \
        'fontItalic': false, \
        'svg': {'svg': 'svg', 'attr': {'width': width, 'height': height}, 'elem': []}, \
        'path': null \
    }
    systemGlobalSet('drawCurrentDrawing', drawing)
endfunction


# $function: drawOnClick
# $group: draw.bare
# $doc: Set the most recent drawing object's on-click event handler
# $arg callback: The on-click event callback function (x, y, width, height)
function drawOnClick(callback):
    drawing = drawGetCurrentDrawing()
    svg = objectGet(drawing, 'svg')
    svgElem = objectGet(svg, 'elem')
    clickElement = if(svgElem, arrayGet(svgElem, arrayLength(svgElem) - 1), svg)
    clickElementAttr = objectGet(clickElement, 'attr')
    objectSet(clickElementAttr, 'style', 'cursor: pointer;')
    objectSet(clickElement, 'callback', {'click': callback})
endfunction


# $function: drawPathRect
# $group: draw.bare
# $doc: Draw a rectangle as a path
# $arg x: The x-coordinate of the top-left of the rectangle
# $arg y: The y-coordinate of the top-left of the rectangle
# $arg width: The width of the rectangle
# $arg height: The height of the rectangle
function drawPathRect(x, y, width, height):
    drawingPath = drawGetDrawingPath()
    arrayPush(drawingPath, 'M ' + numberToFixed(x, drawSVGPrecision) + ' ' + numberToFixed(y, drawSVGPrecision))
    arrayPush(drawingPath, 'H ' + numberToFixed(x + width, drawSVGPrecision))
    arrayPush(drawingPath, 'V ' + numberToFixed(y + height, drawSVGPrecision))
    arrayPush(drawingPath, 'H ' + numberToFixed(x, drawSVGPrecision))
    arrayPush(drawingPath, 'Z')
endfunction


# $function: drawRect
# $group: draw.bare
# $doc: Draw a rectangle
# $arg x: The x-coordinate of the top-left of the rectangle
# $arg y: The y-coordinate of the top-left of the rectangle
# $arg width: The width of the rectangle
# $arg height: The height of the rectangle
# $arg rx: Optional (default is null). The horizontal corner radius of the rectangle.
# $arg ry: Optional (default is null). The vertical corner radius of the rectangle.
function drawRect(x, y, width, height, rx, ry):
    drawing = drawFinishDrawingPath()
    svg = objectGet(drawing, 'svg')
    arrayPush(objectGet(svg, 'elem'), { \
        'svg': 'rect', \
        'attr': { \
            'fill': objectGet(drawing, 'fill'), \
            'rx': rx, \
            'ry': ry, \
            'stroke': objectGet(drawing, 'stroke'), \
            'stroke-width': numberToFixed(objectGet(drawing, 'strokeWidth'), drawSVGPrecision), \
            'stroke-dasharray': objectGet(drawing, 'strokeDashArray'), \
            'x': x, \
            'y': y, \
            'width': width, \
            'height': height \
        } \
    })
endfunction


# $function: drawStyle
# $group: draw.bare
# $doc: Set the current drawing styles
# $arg stroke: Optional (default is 'black'). The stroke color.
# $arg strokeWidth: Optional (default is 1). The stroke width.
# $arg fill: Optional (default is 'none'). The fill color.
# $arg strokeDashArray: Optional (default is 'none'). The stroke
# $arg strokeDashArray: [dash array](https://developer.mozilla.org/en-US/docs/Web/SVG/Attribute/stroke-dasharray#usage_notes).
function drawStyle(stroke, strokeWidth, fill, strokeDashArray):
    drawing = drawGetCurrentDrawing()

    # Apply the style defaults and compare with the current styles - an unchanged style continues the current path
    stroke = if(stroke != null, stroke, 'black')
    strokeWidth = if(strokeWidth != null, strokeWidth, 1)
    fill = if(fill != null, fill, 'none')
    strokeDashArray = if(strokeDashArray != null, strokeDashArray, 'none')
    if stroke != objectGet(drawing, 'stroke') || strokeWidth != objectGet(drawing, 'strokeWidth') || \
       strokeDashArray != objectGet(drawing, 'strokeDashArray') || fill != objectGet(drawing, 'fill'):
        drawFinishDrawingPath()
        objectSet(drawing, 'stroke', stroke)
        objectSet(drawing, 'strokeWidth', strokeWidth)
        objectSet(drawing, 'strokeDashArray', strokeDashArray)
        objectSet(drawing, 'fill', fill)
    endif
endfunction


# $function: drawText
# $group: draw.bare
# $doc: Draw text
# $arg text: The text to draw
# $arg x: The x-coordinate of the text
# $arg y: The y-coordinate of the text
# $arg textAnchor: Optional (default is 'middle'). The
# $arg textAnchor: [text anchor](https://developer.mozilla.org/en-US/docs/Web/SVG/Attribute/text-anchor#usage_notes) style.
# $arg dominantBaseline: Optional (default is 'middle'). The
# $arg dominantBaseline: [dominant baseline](https://developer.mozilla.org/en-US/docs/Web/SVG/Attribute/dominant-baseline#usage_notes)
# $arg dominantBaseline: style.
# $arg rotate: Optional (default is null). The text's clockwise rotation, in degrees, about the text position.
function drawText(text, x, y, textAnchor, dominantBaseline, rotate):
    drawing = drawFinishDrawingPath()
    svg = objectGet(drawing, 'svg')
    arrayPush(objectGet(svg, 'elem'), { \
        'svg': 'text', \
        'attr': { \
            'fill': objectGet(drawing, 'fontFill'), \
            'font-family': objectGet(drawing, 'fontFamily'), \
            'font-size': numberToFixed(objectGet(drawing, 'fontSizePx'), drawSVGPrecision), \
            'text-anchor': if(textAnchor != null, textAnchor, 'middle'), \
            'dominant-baseline': if(dominantBaseline != null, dominantBaseline, 'middle'), \
            'font-weight': if(objectGet(drawing, 'fontBold'), 'bold', 'normal'), \
            'font-style': if(objectGet(drawing, 'fontItalic'), 'italic', 'normal'), \
            'transform': if(rotate, 'rotate(' + rotate + ' ' + x + ' ' + y + ')'), \
            'x': x, \
            'y': y \
        }, \
        'elem': {'text': text} \
    })
endfunction


# $function: drawTextHeight
# $group: draw.bare
# $doc: Compute the text's height to fit the width
# $arg text: The text
# $arg width: The width of the text. If 0, the current font size (in pixels) is returned.
# $return: The text's height, in pixels
function drawTextHeight(text, width):
    drawing = drawGetCurrentDrawing()
    return if(width > 0, 1000 * width / drawTextWidthEm(text), objectGet(drawing, 'fontSizePx'))
endfunction


# $function: drawTextStyle
# $group: draw.bare
# $doc: Set the current text drawing styles
# $arg fontSizePx: Optional (default is null, the default font size). The text font size, in pixels.
# $arg textFill: Optional (default is 'black'). The text fill color.
# $arg bold: Optional (default is false). If true, text is bold.
# $arg italic: Optional (default is false). If true, text is italic.
# $arg fontFamily: Optional (default is null, the default font family). The text font family.
function drawTextStyle(fontSizePx, textFill, bold, italic, fontFamily):
    drawing = drawGetCurrentDrawing()
    objectSet(drawing, 'fontSizePx', if(fontSizePx != null, fontSizePx, drawDefaultFontSize * drawPixelsPerPoint))
    objectSet(drawing, 'fontFill', if(textFill != null, textFill, 'black'))
    objectSet(drawing, 'fontBold', if(bold != null, bold, false))
    objectSet(drawing, 'fontItalic', if(italic != null, italic, false))
    objectSet(drawing, 'fontFamily', if(fontFamily != null, fontFamily, drawDefaultFontFamily))
endfunction


# $function: drawTextWidth
# $group: draw.bare
# $doc: Compute the text's width. The width is the sum of the default font family's character
# $doc: advance widths - printable ASCII, the Latin-1 supplement, and the punctuation, operators,
# $doc: arrows, and Greek letters that chart text uses - taking the wider of the regular and the
# $doc: bold weight for each character, and the width of a glyph from an unknown font for a
# $doc: character in none of those. So text is measured no narrower than it draws, which is what
# $doc: fitting a label to a space needs: kerning only ever draws a pair of characters closer
# $doc: together and is not counted, and each character carries a thousandth of an em of slack for
# $doc: the fraction of a pixel a renderer adds when it quantizes a glyph's advance.
# $arg text: The text
# $arg fontSizePx: The text font size, in pixels
# $return: The text's width, in pixels
function drawTextWidth(text, fontSizePx):
    return 0.001 * fontSizePx * drawTextWidthEm(text)
endfunction


# Helper function to compute a text's width in thousandths of an em. Each character is counted with
# a thousandth of slack, since a renderer rounds a glyph's advance up to its own quantum.
function drawTextWidthEm(text):
    widthEm = 0
    ixChar = 0
    textLength = stringLength(text)
    while ixChar < textLength:
        charCode = stringCharCodeAt(text, ixChar)
        widthEm = widthEm + if(charCode < drawFontWidthTableLength, arrayGet(drawFontWidthTable, charCode), drawFontWidthOther)
        ixChar = ixChar + 1
    endwhile
    return widthEm + textLength
endfunction


# $function: drawVLine
# $group: draw.bare
# $doc: Draw a vertical line from the current point to the end point
# $arg y: The y-coordinate of the end point
function drawVLine(y):
    drawingPath = drawGetDrawingPath()
    arrayPush(drawingPath, 'V ' + numberToFixed(y, drawSVGPrecision))
endfunction


# $function: drawWidth
# $group: draw.bare
# $doc: Get the current drawing's width
# $return: The current drawing's width
function drawWidth():
    drawing = drawGetCurrentDrawing()
    return objectGet(drawing, 'width')
endfunction
