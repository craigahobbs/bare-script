#
# A 32-bit word is two 16-bit halves (high and low), so every intermediate value stays below 2^31 and each result
# is masked to 16 bits - every runtime's bitwise operators then agree (JavaScript's are 32-bit, Python's are not).
# A high half's terms are left unmasked where only its masked sum is kept, since addition carries only upward -
# bits above 15 can't reach the sum's low 16 bits.
#


# $function: hashSHA256
# $group: hash.bare
# $doc: Compute the SHA-256 hash of a byte value array (or a string, as UTF-8)
# $arg bytes: The byte value array (integers 0 to 255) or string
# $return: The 32-byte hash byte value array, or null if the argument is invalid
function hashSHA256(bytes):
    bytes = hashArgumentBytes(bytes, 'hashSHA256', 'bytes')
    if bytes == null:
        return null
    endif
    return hashSHA256Bytes(bytes)
endfunction


# $function: hashHMACSHA256
# $group: hash.bare
# $doc: Compute the HMAC-SHA256 message authentication code of a message (e.g. a JWT HS256 signature)
# $arg key: The key byte value array or string
# $arg message: The message byte value array or string
# $return: The 32-byte message authentication code byte value array, or null if an argument is invalid
function hashHMACSHA256(key, message):
    key = hashArgumentBytes(key, 'hashHMACSHA256', 'key')
    message = hashArgumentBytes(message, 'hashHMACSHA256', 'message')
    if key == null || message == null:
        return null
    endif

    # A key longer than the 64-byte block is hashed, and the key is zero-padded to the block - then the padded key,
    # XORed, prefixes each hash
    if arrayLength(key) > 64:
        key = hashSHA256Bytes(key)
    endif
    innerPad = []
    outerPad = []
    for byte in arrayExtend(arrayCopy(key), arrayNewSize(64 - arrayLength(key), 0)):
        arrayPush(innerPad, byte ^ 54)
        arrayPush(outerPad, byte ^ 92)
    endfor
    arrayExtend(innerPad, message)
    arrayExtend(outerPad, hashSHA256Bytes(innerPad))
    return hashSHA256Bytes(outerPad)
endfunction


# $function: hashEqual
# $group: hash.bare
# $doc: Compare two values (e.g. message authentication codes) in constant time - every byte is compared, so the
# $doc: time taken doesn't reveal how much of a guessed value is right. Verify a signature with
# $doc: `hashEqual(hashHMACSHA256(key, message), signature)` rather than `==`.
# $arg left: The first byte value array or string
# $arg right: The second byte value array or string
# $return: true if the values are equal, false if not, or null if an argument is invalid
function hashEqual(left, right):
    left = hashArgumentBytes(left, 'hashEqual', 'left')
    right = hashArgumentBytes(right, 'hashEqual', 'right')
    if left == null || right == null:
        return null
    endif
    if arrayLength(left) != arrayLength(right):
        return false
    endif
    diff = 0
    for byte, ix in left:
        diff = diff | (byte ^ arrayGet(right, ix))
    endfor
    return diff == 0
endfunction


# $function: hashHex
# $group: hash.bare
# $doc: Format a byte value array (e.g. a hash) as a lowercase hexadecimal string
# $arg bytes: The byte value array or string
# $return: The hexadecimal string, or null if the argument is invalid
function hashHex(bytes):
    bytes = hashArgumentBytes(bytes, 'hashHex', 'bytes')
    if bytes == null:
        return null
    endif
    digits = hashHexDigits
    parts = []
    for byte in bytes:
        arrayPush(parts, arrayGet(digits, byte))
    endfor
    return arrayJoin(parts, '')
endfunction


# Helper to get a byte value array argument (a string is encoded as UTF-8) - logs and returns null if it's invalid
function hashArgumentBytes(value, functionName, argName):
    if systemType(value) == 'string':
        return stringEncode(value)
    endif
    if systemType(value) != 'array' || regexMatch(hashByteArrayRegex, jsonStringify(value)) == null:
        systemLogDebug('hash.bare: ' + functionName + ' - Invalid "' + argName + '" argument')
        return null
    endif
    return value
endfunction


# Helper to compute the SHA-256 hash of a valid byte value array
function hashSHA256Bytes(bytes):
    # Pad the message - a one bit, zeros to 56 bytes modulo 64, and the message's bit length as a 64-bit big-endian
    # integer (computed with arithmetic, since it can exceed the bitwise operators' range)
    length = arrayLength(bytes)
    message = arrayCopy(bytes)
    arrayPush(message, 128)
    arrayExtend(message, arrayNewSize((55 - length % 64 + 64) % 64, 0))
    lengthBytes = arrayNewSize(8, 0)
    bitLength = length * 8
    ix = 7
    while bitLength > 0:
        arraySet(lengthBytes, ix, bitLength % 256)
        bitLength = mathFloor(bitLength / 256)
        ix = ix - 1
    endwhile
    arrayExtend(message, lengthBytes)

    # Process each 64-byte block
    hashHi = arrayCopy(hashInitHi)
    hashLo = arrayCopy(hashInitLo)
    kHi = hashKHi
    kLo = hashKLo
    wHi = arrayNewSize(64, 0)
    wLo = arrayNewSize(64, 0)
    messageLength = arrayLength(message)
    offset = 0
    while offset < messageLength:
        # The message schedule - the block's 16 big-endian words, then 48 words derived from them
        t = 0
        while t < 16:
            ix = offset + t * 4
            arraySet(wHi, t, (arrayGet(message, ix) << 8) | arrayGet(message, ix + 1))
            arraySet(wLo, t, (arrayGet(message, ix + 2) << 8) | arrayGet(message, ix + 3))
            t = t + 1
        endwhile
        while t < 64:
            # sigma0(W[t - 15]) - ROTR 7, ROTR 18, and SHR 3 (the high half, unmasked, feeds only a masked sum)
            xh = arrayGet(wHi, t - 15)
            xl = arrayGet(wLo, t - 15)
            s0h = ((xh >> 7) | (xl << 9)) ^ ((xl >> 2) | (xh << 14)) ^ (xh >> 3)
            s0l = (((xl >> 7) | (xh << 9)) ^ ((xh >> 2) | (xl << 14)) ^ ((xl >> 3) | (xh << 13))) & 65535

            # sigma1(W[t - 2]) - ROTR 17, ROTR 19, and SHR 10 (the high half, unmasked, feeds only a masked sum)
            xh = arrayGet(wHi, t - 2)
            xl = arrayGet(wLo, t - 2)
            s1h = ((xl >> 1) | (xh << 15)) ^ ((xl >> 3) | (xh << 13)) ^ (xh >> 10)
            s1l = (((xh >> 1) | (xl << 15)) ^ ((xh >> 3) | (xl << 13)) ^ ((xl >> 10) | (xh << 6))) & 65535

            # W[t] = sigma1 + W[t - 7] + sigma0 + W[t - 16]
            sum = s1l + arrayGet(wLo, t - 7) + s0l + arrayGet(wLo, t - 16)
            arraySet(wHi, t, (s1h + arrayGet(wHi, t - 7) + s0h + arrayGet(wHi, t - 16) + (sum >> 16)) & 65535)
            arraySet(wLo, t, sum & 65535)
            t = t + 1
        endwhile

        # The 64 compression rounds over the working variables a through h
        ah = arrayGet(hashHi, 0)
        al = arrayGet(hashLo, 0)
        bh = arrayGet(hashHi, 1)
        bl = arrayGet(hashLo, 1)
        ch = arrayGet(hashHi, 2)
        cl = arrayGet(hashLo, 2)
        dh = arrayGet(hashHi, 3)
        dl = arrayGet(hashLo, 3)
        eh = arrayGet(hashHi, 4)
        el = arrayGet(hashLo, 4)
        fh = arrayGet(hashHi, 5)
        fl = arrayGet(hashLo, 5)
        gh = arrayGet(hashHi, 6)
        gl = arrayGet(hashLo, 6)
        hh = arrayGet(hashHi, 7)
        hl = arrayGet(hashLo, 7)
        t = 0
        while t < 64:
            # T1 = h + Sigma1(e) + Ch(e, f, g) + K[t] + W[t], where Sigma1 is ROTR 6, ROTR 11, and ROTR 25, and
            # Ch(e, f, g) = g ^ (e & (f ^ g)). T1's halves are left as raw sums - its carry is added with the
            # carries of e = d + T1 and a = T1 + T2.
            t1h = hh + (((eh >> 6) | (el << 10)) ^ ((eh >> 11) | (el << 5)) ^ ((el >> 9) | (eh << 7))) + \
                (gh ^ (eh & (fh ^ gh))) + arrayGet(kHi, t) + arrayGet(wHi, t)
            t1l = hl + ((((el >> 6) | (eh << 10)) ^ ((el >> 11) | (eh << 5)) ^ ((eh >> 9) | (el << 7))) & 65535) + \
                (gl ^ (el & (fl ^ gl))) + arrayGet(kLo, t) + arrayGet(wLo, t)

            # T2 = Sigma0(a) + Maj(a, b, c), where Sigma0 is ROTR 2, ROTR 13, and ROTR 22, and
            # Maj(a, b, c) = (a & b) | (c & (a | b))
            t2h = (((ah >> 2) | (al << 14)) ^ ((ah >> 13) | (al << 3)) ^ ((al >> 6) | (ah << 10))) + \
                ((ah & bh) | (ch & (ah | bh)))
            t2l = ((((al >> 2) | (ah << 14)) ^ ((al >> 13) | (ah << 3)) ^ ((ah >> 6) | (al << 10))) & 65535) + \
                ((al & bl) | (cl & (al | bl)))

            # Rotate the working variables - e = d + T1 and a = T1 + T2
            hh = gh
            hl = gl
            gh = fh
            gl = fl
            fh = eh
            fl = el
            sum = dl + t1l
            eh = (dh + t1h + (sum >> 16)) & 65535
            el = sum & 65535
            dh = ch
            dl = cl
            ch = bh
            cl = bl
            bh = ah
            bl = al
            sum = t1l + t2l
            ah = (t1h + t2h + (sum >> 16)) & 65535
            al = sum & 65535
            t = t + 1
        endwhile

        # Add the working variables to the hash
        hashSHA256Add(hashHi, hashLo, 0, ah, al)
        hashSHA256Add(hashHi, hashLo, 1, bh, bl)
        hashSHA256Add(hashHi, hashLo, 2, ch, cl)
        hashSHA256Add(hashHi, hashLo, 3, dh, dl)
        hashSHA256Add(hashHi, hashLo, 4, eh, el)
        hashSHA256Add(hashHi, hashLo, 5, fh, fl)
        hashSHA256Add(hashHi, hashLo, 6, gh, gl)
        hashSHA256Add(hashHi, hashLo, 7, hh, hl)
        offset = offset + 64
    endwhile

    # The hash's big-endian bytes
    digest = []
    ix = 0
    while ix < 8:
        wordHi = arrayGet(hashHi, ix)
        wordLo = arrayGet(hashLo, ix)
        arrayPush(digest, wordHi >> 8, wordHi & 255, wordLo >> 8, wordLo & 255)
        ix = ix + 1
    endwhile
    return digest
endfunction


# Helper to add a word to a hash word, modulo 2^32
function hashSHA256Add(hashHi, hashLo, ix, wordHi, wordLo):
    sum = arrayGet(hashLo, ix) + wordLo
    arraySet(hashHi, ix, (arrayGet(hashHi, ix) + wordHi + (sum >> 16)) & 65535)
    arraySet(hashLo, ix, sum & 65535)
endfunction


# Helper to split 32-bit words into their high and low 16-bit halves - with arithmetic, since a word can exceed
# the bitwise operators' range
function hashWordHalves(words, high):
    halves = []
    for word in words:
        arrayPush(halves, if(high, mathFloor(word / 65536), word % 65536))
    endfor
    return halves
endfunction


# The SHA-256 initial hash value - the fractional parts of the square roots of the first 8 primes
hashInit = [ \
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 \
]
hashInitHi = hashWordHalves(hashInit, true)
hashInitLo = hashWordHalves(hashInit, false)


# The SHA-256 round constants - the fractional parts of the cube roots of the first 64 primes
hashK = [ \
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, \
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, \
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, \
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, \
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, \
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, \
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, \
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2 \
]
hashKHi = hashWordHalves(hashK, true)
hashKLo = hashWordHalves(hashK, false)


# The two-digit lowercase hexadecimal strings of the byte values
function hashHexDigitsNew():
    chars = '0123456789abcdef'
    digits = []
    ix = 0
    while ix < 256:
        arrayPush(digits, stringCharAt(chars, ix >> 4) + stringCharAt(chars, ix & 15))
        ix = ix + 1
    endwhile
    return digits
endfunction


hashHexDigits = hashHexDigitsNew()


# The byte value array JSON regular expression
hashByteArrayRegex = regexNew('^\\[(?:(?:[0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(?:,|(?=\\])))*\\]$')
