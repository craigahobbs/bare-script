include <schemaUtil.bare>


# Built-in types
schemaParserBuiltinTypes = { \
    'any': true, \
    'bool': true, \
    'date': true, \
    'datetime': true, \
    'float': true, \
    'int': true, \
    'string': true, \
    'uuid': true \
}
schemaParserBuiltinDeprecated = {'object': 'any'}


# Schema Markdown regex
schemaParserPartId = '(?:[A-Za-z][A-Za-z0-9_]*)'
schemaParserPartAttrGroup = \
    '(?:(?<nullable>nullable)' + \
    '|(?<op><=|<|>|>=|==)\\s*(?<opnum>-?[0-9]+(?:\\.[0-9]+)?)' + \
    '|(?<ltype>len)\\s*(?<lop><=|<|>|>=|==)\\s*(?<lopnum>[0-9]+))'
schemaParserPartAttr = regexReplace(regexNew('\\(\\?<[^>]+>'), schemaParserPartAttrGroup, '(?:')
schemaParserPartAttrs = '(?:' + schemaParserPartAttr + '(?:\\s*,\\s*' + schemaParserPartAttr + ')*)'
schemaParserRegexAttrGroup = regexNew(schemaParserPartAttrGroup)
schemaParserRegexFindAttrs = regexNew(schemaParserPartAttr + '(?:\\s*,\\s*|\\s*$)')
schemaParserRegexLineCont = regexNew('\\\\\\s*$')
schemaParserRegexComment = regexNew('^\\s*(?:#-.*|#(?<doc>.*))?$')
schemaParserRegexGroup = regexNew('^group(?:\\s+"(?<group>.+?)")?\\s*$')
schemaParserRegexAction = regexNew('^action\\s+(?<id>' + schemaParserPartId + ')\\s*$')
schemaParserPartBaseIds = '(?:\\s*\\(\\s*(?<baseIds>' + schemaParserPartId + '(?:\\s*,\\s*' + schemaParserPartId + ')*)\\s*\\)\\s*)'
schemaParserRegexBaseIdsSplit = regexNew('\\s*,\\s*')
schemaParserRegexDefinition = regexNew('^(?<type>struct|union|enum)\\s+(?<id>' + schemaParserPartId + ')' + schemaParserPartBaseIds + '?\\s*$')
schemaParserRegexSection = regexNew('^\\s+(?<type>path|query|input|output|errors)' + schemaParserPartBaseIds + '?\\s*$')
schemaParserRegexSectionPlain = regexNew('^\\s+(?<type>urls)\\s*$')
schemaParserPartTypedef = \
    '(?<type>' + schemaParserPartId + ')' + \
    '(?:\\s*\\(\\s*(?<attrs>' + schemaParserPartAttrs + ')\\s*\\))?' + \
    '(?:' + \
    '(?:\\s*\\[\\s*(?<array>' + schemaParserPartAttrs + '?)\\s*\\])?' + \
    '|' + \
    '(?:' + \
    '\\s*:\\s*(?<dictValueType>' + schemaParserPartId + ')' + \
    '(?:\\s*\\(\\s*(?<dictValueAttrs>' + schemaParserPartAttrs + ')\\s*\\))?' + \
    ')?' + \
    '(?:\\s*\\{\\s*(?<dict>' + schemaParserPartAttrs + '?)\\s*\\})?' + \
    ')' + \
    '\\s+(?<id>' + schemaParserPartId + ')'
schemaParserRegexTypedef = regexNew('^typedef\\s+' + schemaParserPartTypedef + '\\s*$')
schemaParserRegexMember = regexNew('^\\s+(?<optional>optional\\s+)?' + schemaParserPartTypedef + '\\s*$')
schemaParserRegexValue = regexNew('^\\s+(?<id>' + schemaParserPartId + ')\\s*$')
schemaParserRegexValueQuoted = regexNew('^\\s+"(?<id>.*?)"\\s*$')
schemaParserRegexURL = regexNew('^\\s+(?<method>[A-Za-z]+|\\*)(?:\\s+(?<path>\\/\\S*))?')
schemaParserRegexIndent = regexNew('^\\s')


# $function: schemaParse
# $group: schemaParser.bare
# $doc: Parse the [Schema Markdown](https://craigahobbs.github.io/schema-markdown-js/language/) text
# $arg lines...: The [Schema Markdown](https://craigahobbs.github.io/schema-markdown-js/language/)
# $arg lines...: text lines (may contain nested arrays of un-split lines)
# $return: The schema's [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL=''),
# $return: or null if parsing fails
function schemaParse(lines...):
    result = schemaParserParse(lines, {}, '', true)
    if objectHas(result, 'errors'):
        for error in objectGet(result, 'errors'):
            systemLogDebug('schemaParser.bare: ' + error)
        endfor
        return null
    endif
    return objectGet(result, 'result')
endfunction


# $function: schemaParseEx
# $group: schemaParser.bare
# $doc: Parse the [Schema Markdown](https://craigahobbs.github.io/schema-markdown-js/language/) text
# $doc: with options and programmatic error reporting
# $arg lines: The [Schema Markdown](https://craigahobbs.github.io/schema-markdown-js/language/) text
# $arg lines: string, or an array of strings (may contain nested arrays of un-split lines)
# $arg types: Optional. The [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='') to update.
# $arg filename: Optional (default is ""). The file name (for error messages).
# $arg validate: Optional (default is true). If true, validate the type model after parsing.
# $return: On success, an object with the "result" key set to the schema's
# $return: [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='').
# $return: On failure, an object with the "errors" key set to the array of error message strings.
function schemaParseEx(lines, types, filename, validate):
    return schemaParserParse(lines, if(types != null, types, {}), if(filename != null, filename, ''), \
        if(validate != null, validate, true))
endfunction


# Helper function to parse Schema Markdown text lines
function schemaParserParse(lines, types, filename, validate):
    # Current parser state
    errorMap = {}
    filepos = {}
    action = null
    urls = null
    userType = null
    doc = []
    docGroup = null
    linenum = 0

    # Line-split all script text
    lineParts = []
    if systemType(lines) == 'string':
        arrayExtend(lineParts, stringSplitLines(lines))
    elif systemType(lines) == 'array':
        for textPart in arrayFlat(lines):
            if systemType(textPart) != 'string':
                return {'errors': [schemaUtilTruncate('Invalid Schema Markdown text ' + jsonStringify(textPart))]}
            endif
            arrayExtend(lineParts, stringSplitLines(textPart))
        endfor
    else:
        return {'errors': [schemaUtilTruncate('Invalid Schema Markdown text ' + jsonStringify(lines))]}
    endif
    arrayPush(lineParts, '')

    # Process each line
    lineContinuation = []
    for linePart in lineParts:
        linenum = linenum + 1

        # Line continuation?
        linePartNoContinuation = if(stringIndexOf(linePart, '\\') != -1, regexReplace(schemaParserRegexLineCont, linePart, ''), linePart)
        if linePartNoContinuation == linePart && !arrayLength(lineContinuation):
            line = linePart
        else:
            arrayPush(lineContinuation, linePartNoContinuation)
            if linePartNoContinuation != linePart:
                continue
            endif
            line = arrayJoin(lineContinuation, '')
            lineContinuation = []
        endif

        # Match syntax - each regex is guarded by a cheap string test that only skips it when it cannot match
        lineTrimmed = stringTrim(line)
        matchName = 'comment'
        match = if(lineTrimmed == '' || stringStartsWith(lineTrimmed, '#'), regexMatch(schemaParserRegexComment, line))

        # Not a comment or blank line? Try the remaining syntax
        if match == null:
            lineIndented = regexMatch(schemaParserRegexIndent, line) != null
            matchName = 'group'
            match = if(stringStartsWith(line, 'group'), regexMatch(schemaParserRegexGroup, line))
            if match == null:
                matchName = 'action'
                match = if(stringStartsWith(line, 'action'), regexMatch(schemaParserRegexAction, line))
            endif
            if match == null:
                matchName = 'definition'
                match = if(stringStartsWith(line, 'struct') || stringStartsWith(line, 'union') || stringStartsWith(line, 'enum'), \
                    regexMatch(schemaParserRegexDefinition, line))
            endif
            if match == null && action != null && lineIndented:
                matchName = 'section'
                match = regexMatch(schemaParserRegexSection, line)
            endif
            if match == null && action != null && lineIndented:
                matchName = 'sectionPlain'
                match = regexMatch(schemaParserRegexSectionPlain, line)
            endif
            if match == null && userType != null && objectHas(userType, 'enum') && lineIndented:
                matchName = 'value'
                match = regexMatch(schemaParserRegexValue, line)
                if match == null:
                    match = regexMatch(schemaParserRegexValueQuoted, line)
                endif
            endif
            if match == null && userType != null && objectHas(userType, 'struct') && lineIndented:
                matchName = 'member'
                match = regexMatch(schemaParserRegexMember, line)
            endif
            if match == null && urls != null && lineIndented:
                matchName = 'urls'
                match = regexMatch(schemaParserRegexURL, line)
            endif
            if match == null:
                matchName = 'typedef'
                match = if(stringStartsWith(line, 'typedef'), regexMatch(schemaParserRegexTypedef, line))
            endif
            if match == null:
                matchName = null
            endif
        endif

        # Comment?
        if matchName == 'comment':
            docString = objectGet(objectGet(match, 'groups'), 'doc')
            if docString != null:
                arrayPush(doc, if(!stringStartsWith(docString, ' '), docString, stringSlice(docString, 1)))
            endif

        # Struct member?
        elif matchName == 'member':
            matchGroups = objectGet(match, 'groups')
            optional = objectGet(matchGroups, 'optional') != null
            memberName = objectGet(matchGroups, 'id')

            # Add the member
            struct = objectGet(userType, 'struct')
            if !objectHas(struct, 'members'):
                objectSet(struct, 'members', [])
            endif
            memberTypeAttr = schemaParserParseTypedef(matchGroups)
            memberDoc = null
            if arrayLength(doc):
                memberDoc = doc
                doc = []
            endif
            member = { \
                'name': memberName, \
                'type': arrayGet(memberTypeAttr, 0) \
            }
            arrayPush(objectGet(struct, 'members'), member)
            memberAttr = arrayGet(memberTypeAttr, 1)
            if memberAttr != null:
                objectSet(member, 'attr', memberAttr)
            endif
            if memberDoc != null:
                objectSet(member, 'doc', memberDoc)
            endif
            if optional:
                objectSet(member, 'optional', true)
            endif

            # Record the definition's line number
            objectSet(filepos, objectGet(struct, 'name') + '.' + memberName, linenum)

        # Definition?
        elif matchName == 'definition':
            matchGroups = objectGet(match, 'groups')
            definitionString = objectGet(matchGroups, 'type')
            definitionId = objectGet(matchGroups, 'id')
            definitionBaseIds = objectGet(matchGroups, 'baseIds')

            # Type already defined?
            if objectHas(schemaParserBuiltinTypes, definitionId) || objectHas(schemaParserBuiltinDeprecated, definitionId) || \
                    objectHas(types, definitionId):
                schemaParserAddError(errorMap, "Redefinition of type '" + definitionId + "'", filename, linenum)
            endif

            # Clear parser state
            action = null
            urls = null
            definitionDoc = null
            if arrayLength(doc):
                definitionDoc = doc
                doc = []
            endif

            # Struct definition
            if definitionString == 'struct' || definitionString == 'union':
                # Create the new struct type
                struct = {'name': definitionId}
                userType = {'struct': struct}
                objectSet(types, definitionId, userType)
                if definitionDoc != null:
                    objectSet(struct, 'doc', definitionDoc)
                endif
                if docGroup != null:
                    objectSet(struct, 'docGroup', docGroup)
                endif
                if definitionString == 'union':
                    objectSet(struct, 'union', true)
                endif
                if definitionBaseIds != null:
                    objectSet(struct, 'bases', regexSplit(schemaParserRegexBaseIdsSplit, definitionBaseIds))
                endif

            # Enum definition
            else:
                # Create the new enum type
                enum = {'name': definitionId}
                userType = {'enum': enum}
                objectSet(types, definitionId, userType)
                if definitionDoc != null:
                    objectSet(enum, 'doc', definitionDoc)
                endif
                if docGroup != null:
                    objectSet(enum, 'docGroup', docGroup)
                endif
                if definitionBaseIds != null:
                    objectSet(enum, 'bases', regexSplit(schemaParserRegexBaseIdsSplit, definitionBaseIds))
                endif
            endif

            # Record the definition's line number
            objectSet(filepos, definitionId, linenum)

        # Enum value?
        elif matchName == 'value':
            valueString = objectGet(objectGet(match, 'groups'), 'id')

            # Add the enum value
            enum = objectGet(userType, 'enum')
            if !objectHas(enum, 'values'):
                objectSet(enum, 'values', [])
            endif
            enumValue = {'name': valueString}
            arrayPush(objectGet(enum, 'values'), enumValue)
            enumValueDoc = null
            if arrayLength(doc):
                enumValueDoc = doc
                doc = []
            endif
            if enumValueDoc != null:
                objectSet(enumValue, 'doc', enumValueDoc)
            endif

            # Record the definition's line number
            objectSet(filepos, objectGet(enum, 'name') + '.' + valueString, linenum)

        # Typedef?
        elif matchName == 'typedef':
            matchGroups = objectGet(match, 'groups')
            definitionId = objectGet(matchGroups, 'id')

            # Type already defined?
            if objectHas(schemaParserBuiltinTypes, definitionId) || objectHas(schemaParserBuiltinDeprecated, definitionId) || \
                    objectHas(types, definitionId):
                schemaParserAddError(errorMap, "Redefinition of type '" + definitionId + "'", filename, linenum)
            endif

            # Clear parser state
            action = null
            urls = null
            userType = null
            typedefDoc = null
            if arrayLength(doc):
                typedefDoc = doc
                doc = []
            endif

            # Create the typedef
            typedefTypeAttr = schemaParserParseTypedef(matchGroups)
            typedef = { \
                'name': definitionId, \
                'type': arrayGet(typedefTypeAttr, 0) \
            }
            objectSet(types, definitionId, {'typedef': typedef})
            typedefAttr = arrayGet(typedefTypeAttr, 1)
            if typedefAttr != null:
                objectSet(typedef, 'attr', typedefAttr)
            endif
            if typedefDoc != null:
                objectSet(typedef, 'doc', typedefDoc)
            endif
            if docGroup != null:
                objectSet(typedef, 'docGroup', docGroup)
            endif

            # Record the definition's line number
            objectSet(filepos, definitionId, linenum)

        # Documentation group?
        elif matchName == 'group':
            docGroup = objectGet(objectGet(match, 'groups'), 'group')
            docGroup = if(docGroup != null, stringTrim(docGroup))

        # Action?
        elif matchName == 'action':
            actionId = objectGet(objectGet(match, 'groups'), 'id')

            # Action already defined?
            if objectHas(types, actionId):
                schemaParserAddError(errorMap, "Redefinition of action '" + actionId + "'", filename, linenum)
            endif

            # Clear parser state
            urls = null
            userType = null
            actionDoc = null
            if arrayLength(doc):
                actionDoc = doc
                doc = []
            endif

            # Create the new action
            action = {'name': actionId}
            objectSet(types, actionId, {'action': action})
            if actionDoc != null:
                objectSet(action, 'doc', actionDoc)
            endif
            if docGroup != null:
                objectSet(action, 'docGroup', docGroup)
            endif

        # Action section?
        elif matchName == 'section':
            matchGroups = objectGet(match, 'groups')
            sectionString = objectGet(matchGroups, 'type')
            sectionBaseIds = objectGet(matchGroups, 'baseIds')

            # Action section redefinition?
            if objectHas(action, sectionString):
                schemaParserAddError(errorMap, 'Redefinition of action ' + sectionString, filename, linenum)
            endif

            # Clear parser state
            urls = null

            # Set the action section type
            sectionTypeName = objectGet(action, 'name') + '_' + sectionString
            objectSet(action, sectionString, sectionTypeName)
            if sectionString == 'errors':
                enum = {'name': sectionTypeName}
                userType = {'enum': enum}
                objectSet(types, sectionTypeName, userType)
                if sectionBaseIds != null:
                    objectSet(enum, 'bases', regexSplit(schemaParserRegexBaseIdsSplit, sectionBaseIds))
                endif
            else:
                struct = {'name': sectionTypeName}
                userType = {'struct': struct}
                objectSet(types, sectionTypeName, userType)
                if sectionBaseIds != null:
                    objectSet(struct, 'bases', regexSplit(schemaParserRegexBaseIdsSplit, sectionBaseIds))
                endif
            endif

            # Record the definition's line number
            objectSet(filepos, sectionTypeName, linenum)

        # Plain action section?
        elif matchName == 'sectionPlain':
            sectionString = objectGet(objectGet(match, 'groups'), 'type')

            # Action section redefinition?
            if objectHas(action, sectionString):
                schemaParserAddError(errorMap, 'Redefinition of action ' + sectionString, filename, linenum)
            endif

            # Clear parser state
            userType = null

            # Update the parser state - attach urls immediately so a second empty
            # "urls" section is detected as a redefinition (even with no URL lines)
            urls = []
            if !objectHas(action, sectionString):
                objectSet(action, sectionString, urls)
            endif

        # URL?
        elif matchName == 'urls':
            matchGroups = objectGet(match, 'groups')
            method = objectGet(matchGroups, 'method')
            path = objectGet(matchGroups, 'path')

            # Create the action URL object
            actionUrl = {}
            if method != '*':
                objectSet(actionUrl, 'method', method)
            endif
            if path != null:
                objectSet(actionUrl, 'path', path)
            endif

            # Duplicate URL?
            isDuplicate = false
            for url in urls:
                if objectGet(url, 'method') == objectGet(actionUrl, 'method') && objectGet(url, 'path') == objectGet(actionUrl, 'path'):
                    isDuplicate = true
                    break
                endif
            endfor
            if isDuplicate:
                paddedPath = if(objectHas(actionUrl, 'path'), ' ' + objectGet(actionUrl, 'path'), '')
                schemaParserAddError(errorMap, 'Duplicate URL: ' + method + paddedPath, filename, linenum)
            endif

            # Add the URL
            arrayPush(urls, actionUrl)

        # Unrecognized line syntax
        else:
            schemaParserAddError(errorMap, 'Syntax error', filename, linenum)
        endif
    endfor

    # Drop empty action urls arrays (type model requires len > 0 when present)
    for typeName in objectKeys(types):
        userTypeIter = objectGet(types, typeName)
        if objectHas(userTypeIter, 'action'):
            actionType = objectGet(userTypeIter, 'action')
            if objectHas(actionType, 'urls') && arrayLength(objectGet(actionType, 'urls')) == 0:
                objectDelete(actionType, 'urls')
            endif
        endif
    endfor

    # Validate the type model, if requested
    if validate:
        for validationError in schemaValidateTypeModelErrors(types):
            errorTypeName = arrayGet(validationError, 0)
            errorMemberName = arrayGet(validationError, 1)
            errorMessage = arrayGet(validationError, 2)
            errorFilename = filename
            errorLinenum = null
            if errorMemberName != null:
                errorLinenum = objectGet(filepos, errorTypeName + '.' + errorMemberName)
            endif
            if errorLinenum == null:
                errorLinenum = objectGet(filepos, errorTypeName)
            endif
            if errorLinenum == null:
                errorFilename = ''
                errorLinenum = 1
            endif
            schemaParserAddError(errorMap, errorMessage, errorFilename, errorLinenum)
        endfor
    endif

    # Errors?
    errorKeys = objectKeys(errorMap)
    if arrayLength(errorKeys):
        errorTuples = []
        for errorKey in errorKeys:
            arrayPush(errorTuples, objectGet(errorMap, errorKey))
        endfor
        arraySort(errorTuples, schemaParserErrorCompare)
        errors = []
        for errorTuple in errorTuples:
            arrayPush(errors, arrayGet(errorTuple, 2))
        endfor
        return {'errors': errors}
    endif

    return {'result': types}
endfunction


# Helper function to add a parser error to the error map
function schemaParserAddError(errorMap, message, errorFilename, errorLinenum):
    errorMessage = errorFilename + ':' + errorLinenum + ': error: ' + message
    objectSet(errorMap, errorMessage, [errorFilename, errorLinenum, errorMessage])
endfunction


# Helper function to compare [filename, linenum, message] error tuples
function schemaParserErrorCompare(errorA, errorB):
    for valueA, ixValue in errorA:
        compare = systemCompare(valueA, arrayGet(errorB, ixValue))
        if compare != 0:
            return compare
        endif
    endfor
    return 0
endfunction


# Helper function to parse a typedef match - returns a [type-model, attributes-model] tuple
function schemaParserParseTypedef(matchGroups):
    arrayAttrsString = objectGet(matchGroups, 'array')
    dictAttrsString = objectGet(matchGroups, 'dict')

    # Array type?
    if arrayAttrsString != null:
        valueTypeName = objectGet(matchGroups, 'type')
        valueAttr = schemaParserParseAttr(objectGet(matchGroups, 'attrs'))
        arrayType = {'type': schemaParserCreateType(valueTypeName)}
        if valueAttr != null:
            objectSet(arrayType, 'attr', valueAttr)
        endif
        return [{'array': arrayType}, schemaParserParseAttr(arrayAttrsString)]
    endif

    # Dictionary type?
    if dictAttrsString != null:
        valueTypeName = objectGet(matchGroups, 'dictValueType')
        if valueTypeName != null:
            valueAttr = schemaParserParseAttr(objectGet(matchGroups, 'dictValueAttrs'))
            keyTypeName = objectGet(matchGroups, 'type')
            keyAttr = schemaParserParseAttr(objectGet(matchGroups, 'attrs'))
            dictType = { \
                'type': schemaParserCreateType(valueTypeName), \
                'keyType': schemaParserCreateType(keyTypeName) \
            }
            if valueAttr != null:
                objectSet(dictType, 'attr', valueAttr)
            endif
            if keyAttr != null:
                objectSet(dictType, 'keyAttr', keyAttr)
            endif
        else:
            valueTypeName = objectGet(matchGroups, 'type')
            valueAttr = schemaParserParseAttr(objectGet(matchGroups, 'attrs'))
            dictType = {'type': schemaParserCreateType(valueTypeName)}
            if valueAttr != null:
                objectSet(dictType, 'attr', valueAttr)
            endif
        endif
        return [{'dict': dictType}, schemaParserParseAttr(dictAttrsString)]
    endif

    # Non-container type...
    return [schemaParserCreateType(objectGet(matchGroups, 'type')), schemaParserParseAttr(objectGet(matchGroups, 'attrs'))]
endfunction


# Helper function to create a type model
function schemaParserCreateType(typeName):
    if objectHas(schemaParserBuiltinDeprecated, typeName):
        return {'builtin': objectGet(schemaParserBuiltinDeprecated, typeName)}
    endif
    if objectHas(schemaParserBuiltinTypes, typeName):
        return {'builtin': typeName}
    endif
    return {'user': typeName}
endfunction


# Helper function to parse an attributes string - returns an attributes model
function schemaParserParseAttr(attrsString):
    attrs = null
    if attrsString != null:
        for matchFind in regexMatchAll(schemaParserRegexFindAttrs, attrsString):
            if attrs == null:
                attrs = {}
            endif
            matchAttrGroups = objectGet(regexMatch(schemaParserRegexAttrGroup, objectGet(objectGet(matchFind, 'groups'), '0')), 'groups')
            attrOp = objectGet(matchAttrGroups, 'op')
            attrLengthOp = objectGet(matchAttrGroups, 'lop')

            if objectGet(matchAttrGroups, 'nullable') != null:
                objectSet(attrs, 'nullable', true)
            elif attrOp != null:
                attrValue = numberParseFloat(objectGet(matchAttrGroups, 'opnum'))
                if attrOp == '<':
                    objectSet(attrs, 'lt', attrValue)
                elif attrOp == '<=':
                    objectSet(attrs, 'lte', attrValue)
                elif attrOp == '>':
                    objectSet(attrs, 'gt', attrValue)
                elif attrOp == '>=':
                    objectSet(attrs, 'gte', attrValue)
                else:
                    objectSet(attrs, 'eq', attrValue)
                endif
            else:
                # attrLengthOp != null
                attrValue = numberParseInt(objectGet(matchAttrGroups, 'lopnum'))
                if attrLengthOp == '<':
                    objectSet(attrs, 'lenLT', attrValue)
                elif attrLengthOp == '<=':
                    objectSet(attrs, 'lenLTE', attrValue)
                elif attrLengthOp == '>':
                    objectSet(attrs, 'lenGT', attrValue)
                elif attrLengthOp == '>=':
                    objectSet(attrs, 'lenGTE', attrValue)
                else:
                    objectSet(attrs, 'lenEq', attrValue)
                endif
            endif
        endfor
    endif
    return attrs
endfunction
