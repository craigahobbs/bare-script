include <args.bare>
include <barescriptParser.bare>


# $function: baredocCLIMain
# $group: baredocCLI.bare
# $async: true
# $doc: The BareScript documentation tool main entry point
# $return: The exit status code
async function baredocCLIMain():
    # Command line arguments
    args = argsParse(baredocCLIMainArguments)
    if objectGet(args, 'help'):
        markdownPrint(argsHelp(baredocCLIMainArguments))
        return 1
    endif
    output = objectGet(args, 'output')
    files = jsonParse(objectGet(args, 'files'))
    if files == null || systemType(files) != 'array':
        markdownPrint('**Error:** Invalid input file list JSON')
        return 1
    endif

    # Parse each source file
    functions = {}
    errors = []
    for filename in files:
        # Read the source file
        source = systemFetch(filename)
        if source == null:
            arrayPush(errors, 'Failed to load "' + filename + '"')
            continue
        endif

        # Parse documentation comments
        arrayExtend(errors, baredocCLIParse(functions, source, filename))
    endfor

    # Create the library documentation model - sort functions by name
    libraryFunctions = []
    for funcName in arraySort(objectKeys(functions)):
        arrayPush(libraryFunctions, objectGet(functions, funcName))
    endfor
    library = {'functions': libraryFunctions}
    libraryJSON = jsonStringify(library)

    # No library functions?
    if !libraryFunctions:
        arrayPush(errors, 'error: No library functions')
    endif

    # Errors?
    if errors:
        markdownPrint('```', arrayJoin(errors, '\n'), '```')
        return 1
    endif

    # Output to stdout?
    status = 0
    if output == '-':
        systemLog(libraryJSON)
    else:
        # Output to file
        if !systemFetch({'url': output, 'body': libraryJSON}):
            markdownPrint('**Error:** Failed to write "' + output + '"')
            status = 1
        endif
    endif
    return status
endfunction


# baredocCLI application arguments
baredocCLIMainArguments = argsValidate([ \
    {'name': 'files', 'type': 'string', 'default': '[]', 'description': 'The JSON-encoded list of input source code filenames'}, \
    {'name': 'help', 'type': 'bool', 'description': 'Show argument help'}, \
    {'name': 'output', 'type': 'string', 'default': '-', 'description': 'The output file'} \
])


# $function: baredocCLIParse
# $group: baredocCLI.bare
# $doc: Parse source code for baredoc documentation comments
# $arg functions: The map of function name to [function documentation model](model.html#var.vName='BaredocFunction')
# $arg source: The source code string
# $arg filename: The source filename string
# $return: The array of errors
function baredocCLIParse(functions, source, filename):
    errors = []

    # Note the previously-parsed functions - only functions added by this call are validated below
    functionsPrev = objectCopy(functions)

    # Process documentation comments line-by-line
    func = null
    for line, ixLine in stringSplitLines(source):
        # function/group/doc/return documentation keywords?
        matchKey = regexMatch(baredocCLIParseRegexKey, line)
        if matchKey != null:
            groupsKey = objectGet(matchKey, 'groups')
            key = objectGet(groupsKey, 'key')
            text = objectGet(groupsKey, 'text')
            textTrim = stringTrim(text)

            # Keyword used outside of function?
            if key != 'function' && func == null:
                baredocCLIError(errors, filename, ixLine, key + ' keyword outside function')
                continue
            endif

            # Process the keyword
            if key == 'group':
                if textTrim == '':
                    baredocCLIError(errors, filename, ixLine, 'Invalid function group name "' + textTrim + '"')
                    continue
                endif
                if objectHas(func, 'group'):
                    baredocCLIError(errors, filename, ixLine, 'Function "' + objectGet(func, 'name') + '" group redefinition')
                    continue
                endif

                # Set the function group
                objectSet(func, 'group', textTrim)

            elif key == 'doc' || key == 'return':
                # Add the documentation line - don't add leading blank lines
                funcDoc = objectGet(func, key)
                if funcDoc != null || textTrim != '':
                    if funcDoc == null:
                        funcDoc = []
                        objectSet(func, key, funcDoc)
                    endif
                    arrayPush(funcDoc, text)
                endif

            elif key == 'ignore' || key == 'async':
                # Ignore the function? Asynchronous function?
                if textTrim != 'true' && textTrim != 'false':
                    baredocCLIError(errors, filename, ixLine, 'Invalid ' + key + ' value "' + textTrim + '"')
                    continue
                endif
                objectSet(func, key, textTrim == 'true')

            else:
                # key == 'function'
                if textTrim == '':
                    baredocCLIError(errors, filename, ixLine, 'Invalid function name "' + textTrim + '"')
                    continue
                endif
                if objectHas(functions, textTrim):
                    baredocCLIError(errors, filename, ixLine, 'Function "' + textTrim + '" redefinition')
                    continue
                endif

                # Add the function
                func = {'name': textTrim}
                objectSet(functions, textTrim, func)
            endif

            continue
        endif

        # arg keyword?
        matchArg = regexMatch(baredocCLIParseRegexArg, line)
        if matchArg != null:
            groupsArg = objectGet(matchArg, 'groups')
            optionalName = objectGet(groupsArg, 'optionalName')
            name = optionalName || objectGet(groupsArg, 'name')
            text = objectGet(groupsArg, 'text')
            textTrim = stringTrim(text)

            # Keyword used outside of function?
            if func == null:
                baredocCLIError(errors, filename, ixLine, 'Function argument "' + name + '" outside function')
                continue
            endif

            # Get the function argument model, if it exists
            funcArgs = objectGet(func, 'args')
            funcArg = null
            if funcArgs != null:
                for findArg in funcArgs:
                    if objectGet(findArg, 'name') == name:
                        funcArg = findArg
                        break
                    endif
                endfor
            endif

            # Ignore leading argument documentation blank lines (an optional argument line declares the argument)
            if funcArg == null && textTrim == '' && optionalName == null:
                continue
            endif

            # Add the function model arguments member, if necessary
            if funcArgs == null:
                funcArgs = []
                objectSet(func, 'args', funcArgs)
            endif

            # Add the function argument model, if necessary
            if funcArg == null:
                funcArg = {'name': name, 'doc': []}
                arrayPush(funcArgs, funcArg)
            endif

            # Optional argument? Set the optional flag and the default value, if any.
            if optionalName != null:
                objectSet(funcArg, 'optional', true)
                default = objectGet(groupsArg, 'default')
                if default != null:
                    # The default value must be a BareScript literal
                    defaultResult = barescriptParseExpressionEx(default, null, null, true)
                    if !objectHas(defaultResult, 'result') || !baredocCLIIsLiteral(objectGet(defaultResult, 'result')):
                        baredocCLIError(errors, filename, ixLine, 'Invalid default value "' + default + '" for argument "' + name + '"')
                        continue
                    endif
                    objectSet(funcArg, 'default', default)
                endif
            endif

            # Add the function argument documentation line - don't add leading blank lines
            funcArgDoc = objectGet(funcArg, 'doc')
            if textTrim != '' || arrayLength(funcArgDoc) > 0:
                arrayPush(funcArgDoc, text)
            endif
            continue
        endif

        # Unknown or malformed documentation comment?
        matchUnknown = regexMatch(baredocCLIParseRegexUnknown, line)
        if matchUnknown != null:
            groupsUnknown = objectGet(matchUnknown, 'groups')
            unknown = objectGet(groupsUnknown, 'unknown') || objectGet(groupsUnknown, 'keyword')
            baredocCLIError(errors, filename, ixLine, 'Invalid documentation comment "' + unknown + '"')
            continue
        endif
    endfor

    # Validate the function documentation models added by this call
    for funcName in arraySort(objectKeys(functions)):
        if objectHas(functionsPrev, funcName):
            continue
        endif
        funcObj = objectGet(functions, funcName)
        if !objectHas(funcObj, 'group'):
            arrayPush(errors, 'error: Function "' + funcName + '" missing group')
        endif
        if !objectHas(funcObj, 'doc'):
            arrayPush(errors, 'error: Function "' + funcName + '" missing documentation')
        endif
        if objectGet(funcObj, 'ignore'):
            objectDelete(functions, funcName)
        endif
    endfor

    return errors
endfunction


# Helper to test if an expression model is a literal value - a number, string, null, true, or false,
# or an array or object literal of literal values with string keys
function baredocCLIIsLiteral(expr):
    if objectHas(expr, 'number') || objectHas(expr, 'string'):
        return true
    endif
    variable = objectGet(expr, 'variable')
    if variable != null:
        return variable == 'null' || variable == 'true' || variable == 'false'
    endif
    funcName = objectGet(objectGet(expr, 'function'), 'name')
    if funcName != 'arrayNew' && funcName != 'objectNew':
        return false
    endif
    for arg, ixArg in objectGet(objectGet(expr, 'function'), 'args'):
        isKey = funcName == 'objectNew' && ixArg % 2 == 0
        if !if(isKey, objectHas(arg, 'string'), baredocCLIIsLiteral(arg)):
            return false
        endif
    endfor
    return true
endfunction


# Helper to add a source line error
function baredocCLIError(errors, filename, ixLine, message):
    arrayPush(errors, filename + ':' + (ixLine + 1) + ': ' + message)
endfunction


# baredocCLIParse regular expressions
baredocCLIParseRegexKey = regexNew('^\\s*(?:\\/\\/|#)\\s*\\$(?<key>function|group|doc|return|ignore|async):\\s?(?<text>.*)$')
baredocCLIParseRegexArg = regexNew( \
    '^\\s*(?:\\/\\/|#)\\s*\\$arg\\s+' + \
    '(?:(?<name>[A-Za-z_][A-Za-z0-9_]*(?:\\.\\.\\.)?)|' + \
    '\\[\\s*(?<optionalName>[A-Za-z_][A-Za-z0-9_]*(?:\\.\\.\\.)?)(?:\\s*=\\s*(?<default>.*?))?\\s*\\]):' + \
    '\\s?(?<text>.*)$' \
)
baredocCLIParseRegexUnknown = regexNew( \
    '^\\s*(?:\\/\\/|#)\\s*\\$(?:(?<unknown>[^:]+):|(?<keyword>(?:function|group|doc|arg|return|ignore|async)\\b.*)$)' \
)
