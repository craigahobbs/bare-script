    '    # The URL path. If not provided, uses the default URL path of "/<actionName>".', \
    '    optional string path' \
]), 'result')


# $function: schemaTypeModel
# $group: schemaTypeModel.bare
# $doc: Get the [Schema Markdown Type Model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='')
# $return: The [Schema Markdown Type Model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='')
function schemaTypeModel():
    return schemaTypeModelTypes
endfunction


# $function: schemaTypeModelValidate
# $group: schemaTypeModel.bare
# $doc: Validate a [Schema Markdown Type Model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='')
# $arg types: The [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='') to validate
# $return: The validated [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL=''),
# $return: or null if validation fails
function schemaTypeModelValidate(types):
    result = schemaTypeModelValidateEx(types)
    if objectHas(result, 'errors'):
        for error in objectGet(result, 'errors'):
            systemLogDebug('schemaTypeModel.bare: ' + error)
        endfor
        return null
    endif
    return objectGet(result, 'result')
endfunction


# $function: schemaTypeModelValidateEx
# $group: schemaTypeModel.bare
# $doc: Validate a [Schema Markdown Type Model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='')
# $doc: with programmatic error reporting
# $arg types: The [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='') to validate
# $return: On success, an object with the "result" key set to the validated
# $return: [type model](https://craigahobbs.github.io/bare-script/model/#var.vName='Types'&var.vURL='').
# $return: On failure, an object with the "errors" key set to the array of error message strings.
function schemaTypeModelValidateEx(types):
    # Validate with the type model
    validatedResult = schemaValidateEx(schemaTypeModelTypes, 'Types', types)
    if objectHas(validatedResult, 'error'):
        return {'errors': [objectGet(validatedResult, 'error')]}
    endif
    validatedTypes = objectGet(validatedResult, 'result')

    # Do additional type model validation
    errors = schemaValidateTypeModelErrors(validatedTypes)
    if errors:
        # Sort by type name, member name, and message; a null member name sorts as ""
        arraySort(errors, schemaTypeModelErrorCompare)
        errorMessages = []
        for validationError in errors:
            arrayPush(errorMessages, arrayGet(validationError, 2))
        endfor
        return {'errors': errorMessages}
    endif

    return {'result': validatedTypes}
endfunction


# Helper function to compare [typeName, memberName, message] error tuples - null parts sort as ""
function schemaTypeModelErrorCompare(errorA, errorB):
    for valueA, ixValue in errorA:
        valueB = arrayGet(errorB, ixValue)
        compare = systemCompare(if(valueA != null, valueA, ''), if(valueB != null, valueB, ''))
        if compare != 0:
            return compare
        endif
    endfor
    return 0
endfunction
