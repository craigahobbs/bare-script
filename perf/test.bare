include <markdownElements.bare>
include <markdownParser.bare>
include <qrcode.bare>
include <schema.bare>
include <schemaParser.bare>
include <url.bare>


# The performance tests and their iteration counts - the fixed workload a build-to-build comparison needs, and
# the count perfMeasure starts from when "make perf" asks it to time a longer run
perfTests = { \
    'mandelbrot': 1, \
    'schemaParse': 250, \
    'schemaValidate': 250, \
    'markdownParse': 250, \
    'markdownElements': 1000, \
    'qrcodeMatrix': 30, \
    'urlEncode': 2000, \
    'urlDecode': 2000 \
}

async function main():
    language = systemGlobalGet('vLanguage', 'BareScript')
    testArg = systemGlobalGet('vTest')
    timeFloor = systemGlobalGet('vTimeFloor', 0)
    for test in if(testArg != null, [testArg], objectKeys(perfTests)):
        runs = objectGet(perfTests, test)
        if runs == null:
            systemLog('Unknown test "' + test + '"')
            return 1
        endif
        timing = perfMeasure(test, runs, timeFloor)
        systemLog(language + ',' + test + ',' + arrayGet(timing, 0) + ',' + arrayGet(timing, 1))
    endfor
endfunction


# Time "runs" of the test. With a "vTimeFloor" of zero - the default, and what a build-to-build comparison
# needs - that is one timed pass of the fixed count. Given a floor in milliseconds, the count is calibrated
# from a single iteration instead, growing until the timed run reaches the floor, so that the clock - whole
# milliseconds, all a BareScript program can read - measures even the fastest runtime to a fraction of a
# percent. Calibrating up from one rather than down from the fixed count is what keeps the cost the floor
# and not the count: a slow machine, or a slow runtime, settles on fewer iterations rather than taking
# proportionally longer. Returns [iterations, elapsed milliseconds].
async function perfMeasure(test, runs, timeFloor):
    if timeFloor <= 0:
        return [runs, perfRun(test, runs)]
    endif
    iterations = 1
    while true:
        timeMs = perfRun(test, iterations)
        if timeMs >= timeFloor:
            return [iterations, timeMs]
        endif
        iterations = iterations * if(timeMs > 0, mathCeil(1.5 * timeFloor / timeMs), 16)
    endwhile
endfunction


async function perfRun(test, iterations):
    # mandelbrot?
    if test == 'mandelbrot':
        # Compute the "seahorse valley", a computationally dense region on the Mandelbrot set boundary
        timeBegin = datetimeNow()
        ix = 0
        while ix < iterations:
            mandelbrotSet(120, 80, -0.75, 0.1, 0.05, 60)
            ix = ix + 1
        endwhile
        timeEnd = datetimeNow()

    # schemaParse?
    elif test == 'schemaParse':
        # Warmup
        schemaParse(perfSchemaText)

        timeBegin = datetimeNow()
        ix = 0
        while ix < iterations:
            schemaParse(perfSchemaText)
            ix = ix + 1
        endwhile
        timeEnd = datetimeNow()

    # schemaValidate?
    elif test == 'schemaValidate':
        # Warmup
        types = schemaParse(perfSchemaText)
        schemaValidate(types, 'Types', types)

        timeBegin = datetimeNow()
        ix = 0
        while ix < iterations:
            schemaValidate(types, 'Types', types)
            ix = ix + 1
        endwhile
        timeEnd = datetimeNow()

    # markdownParse?
    elif test == 'markdownParse':
        # Warmup
        markdownText = systemFetch('../README.md')
        markdownParse(markdownText)

        timeBegin = datetimeNow()
        ix = 0
        while ix < iterations:
            markdownParse(markdownText)
            ix = ix + 1
        endwhile
        timeEnd = datetimeNow()

    # markdownElements?
    elif test == 'markdownElements':
        # Warmup
        markdownText = systemFetch('../README.md')
        markdownModel = markdownParse(markdownText)
        markdownElements(markdownModel)

        timeBegin = datetimeNow()
        ix = 0
        while ix < iterations:
            markdownElements(markdownModel)
            ix = ix + 1
        endwhile
        timeEnd = datetimeNow()

    # qrcodeMatrix?
    elif test == 'qrcodeMatrix':
        # Warmup
        qrcodeMatrix('https://craigahobbs.github.io/bare-script/')

        timeBegin = datetimeNow()
        ix = 0
        while ix < iterations:
            qrcodeMatrix('https://craigahobbs.github.io/bare-script/')
            ix = ix + 1
        endwhile
        timeEnd = datetimeNow()

    # urlEncode?
    elif test == 'urlEncode':
        # Warmup
        urlEncodeQueryString(perfURLArgs)

        timeBegin = datetimeNow()
        ix = 0
        while ix < iterations:
            urlEncodeQueryString(perfURLArgs)
            ix = ix + 1
        endwhile
        timeEnd = datetimeNow()

    # urlDecode?
    elif test == 'urlDecode':
        # Warmup
        urlDecodeQueryString(perfURLHash)

        timeBegin = datetimeNow()
        ix = 0
        while ix < iterations:
            urlDecodeQueryString(perfURLHash)
            ix = ix + 1
        endwhile
        timeEnd = datetimeNow()
    endif

    return timeEnd - timeBegin
endfunction


function mandelbrotSet(width, height, xCoord, yCoord, xRange, maxIter):
    # Compute the set extents
    yRange = (height / width) * xRange
    xMin = xCoord - 0.5 * xRange
    yMin = yCoord - 0.5 * yRange

    # Compute each pixel in the set
    ix = 0
    while ix < width:
        iy = 0
        while iy < height:
            xValue = xMin + (ix / (width - 1)) * xRange
            yValue = yMin + (iy / (height - 1)) * yRange
            mandelbrotValue(xValue, yValue, maxIter)
            iy = iy + 1
        endwhile
        ix = ix + 1
    endwhile
endfunction


function mandelbrotValue(xValue, yValue, maxIter):
    # c1 = complex(x, y)
    # c2 = complex(0, 0)
    c1r = xValue
    c1i = yValue
    c2r = 0
    c2i = 0

    # Iteratively compute the next c2 value
    iter = 1
    while iter <= maxIter:
        # Done?
        if mathSqrt(c2r * c2r + c2i * c2i) > 2:
            return iter
        endif

        # c2 = c2 * c2 + c1
        c2rNew = c2r * c2r - c2i * c2i + c1r
        c2i = 2 * c2r * c2i + c1i
        c2r = c2rNew

        iter = iter + 1
    endwhile

    # Hit max iterations - the point is in the Mandelbrot set
    return 0
endfunction


