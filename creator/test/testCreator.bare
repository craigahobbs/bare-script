async function testCreatorMainFormSession():
    # The form is pre-filled from the browser session
    systemGlobalSet('vType', 'frontend')
    unittestMockAll()
    sessionStorageSet('creator.frontend', jsonStringify({'name': 'Fungus Simulator', 'spec': 'Grow.'}))
    creatorMain()
    calls = unittestMockEnd()
    systemGlobalSet('vType', null)
    arrayDelete(calls, 0)
    unittestDeepEqual(calls, testCreatorFormLog({'name': 'Fungus Simulator', 'spec': 'Grow.'}, []))

    # Invalid session values are ignored
    systemGlobalSet('vType', 'frontend')
    unittestMockAll()
    sessionStorageSet('creator.frontend', '[1, 2]')
    creatorMain()
    calls = unittestMockEnd()
    systemGlobalSet('vType', null)
    arrayDelete(calls, 0)
    expected = [['systemLogDebug', ['schema.bare: Invalid value [1,2] (type "array"), expected type "dict"']]]
    arrayExtend(expected, testCreatorFormLog({}, []))
    unittestDeepEqual(calls, expected)

    # Session values must be strings
    systemGlobalSet('vType', 'frontend')
    unittestMockAll()
    sessionStorageSet('creator.frontend', '{"name": 1}')
    creatorMain()
    calls = unittestMockEnd()
    systemGlobalSet('vType', null)
    arrayDelete(calls, 0)
    expected = [['systemLogDebug', ['schema.bare: Invalid value 1 (type "number") for member "name", expected type "string"']]]
    arrayExtend(expected, testCreatorFormLog({}, []))
    unittestDeepEqual(calls, expected)
endfunction
unittestRunTest('testCreatorMainFormSession')


