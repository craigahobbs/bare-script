function testCreatorDatetimeNow():
    return testCreatorNow
endfunction


# The frontend form values and mock data of a valid application
testCreatorValues = { \
    'copyright': 'Jane Doe', \
    'name': 'My App', \
    'description': 'A test application', \
    'spec': 'Show a list of items.\nLet the user add items.' \
}
testCreatorData = { \
