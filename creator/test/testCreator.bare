endfunction


#
# Callback-binding helpers
#


# Find an element's event callback in a call log - "matchFn" tests an element model for the one wanted
function testFindCallback(model, event, matchFn):
    type = systemType(model)
    if type == 'array':
        for item in model:
            found = testFindCallback(item, event, matchFn)
            if found != null:
                return found
            endif
        endfor
    elif type == 'object':
        callback = objectGet(model, 'callback')
        if callback != null && matchFn(model):
            return objectGet(callback, event)
        endif
        return testFindCallback(objectGet(model, 'elem'), event, matchFn)
    endif
    return null
endfunction


# Element model match functions - a link button by its text, and an input by its ID
function testMatchText(text, model):
    elem = objectGet(model, 'elem')
    return systemType(elem) == 'object' && objectGet(elem, 'text') == text
endfunction

function testMatchId(id, model):
    attr = objectGet(model, 'attr')
    return attr != null && objectGet(attr, 'id') == id
endfunction


# Verify a callback has the same effect as its handler - the optional "setupFn" seeds each mock scope
async function testSameEffect(actualFn, expectedFn, data, setupFn):
    unittestMockAll(data)
    if(setupFn != null, setupFn())
    expectedFn()
    expected = unittestMockEnd()
    unittestMockAll(data)
    if(setupFn != null, setupFn())
    actualFn()
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction


# Verify a rendered link button's click callback has the same effect as its handler
async function testVerifyClick(renderFn, text, expectedFn, data, setupFn):
    unittestMockAll(data)
    if(setupFn != null, setupFn())
    renderFn()
    found = testFindCallback(unittestMockEnd(), 'click', systemPartial(testMatchText, text))
    testSameEffect(found, expectedFn, data, setupFn)
endfunction


