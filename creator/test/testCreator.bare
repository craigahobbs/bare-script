async function testCreatorOnCreateFetchError():
    data = jsonParse(jsonStringify(testCreatorData))
    objectSet(data, 'systemFetch', {})
    unittestMockAll(data)
    testCreatorCreatePageOnCreate()
    expected = testCreatorCreateLog(testCreatorValues)
    arrayExtend(expected, [['systemFetch', ['../SKILL.md']], ['systemFetch', ['../../SKILL.md']]])
    arrayExtend(expected, testCreatorFormLog(testCreatorValues, ['Failed to fetch the bare-script skill']))
    unittestDeepEqual(unittestMockEnd(), expected)
endfunction
unittestRunTest('testCreatorOnCreateFetchError')


async function testCreatorMainOutput():
    # The "output" argument writes the archive to the file, with the form values from the browser session
    systemGlobalSet('vType', 'frontend')
    systemGlobalSet('vOutput', 'out/myApp.tar.gz')
    testCreatorMockAll({'systemFetch': {'../SKILL.md': '# Skill\n', 'out/myApp.tar.gz': '{}'}})
    sessionStorageSet('creator.frontend', jsonStringify(testCreatorValues))
    creatorMain()
    calls = unittestMockEnd()
    systemGlobalSet('vType', null)
    systemGlobalSet('vOutput', null)
    arrayDelete(calls, 0)

    # The write's request model carries the archive bytes - check its shape, then compare the rest of the log
    writeCall = arrayGet(calls, 1)
    request = arrayGet(arrayGet(writeCall, 1), 0)
    unittestEqual(arrayGet(writeCall, 0), 'systemFetch')
    unittestEqual(objectGet(request, 'url'), 'out/myApp.tar.gz')
    unittestDeepEqual(arraySlice(objectGet(request, 'body'), 0, 3), [31, 139, 8])
    arrayDelete(calls, 1)
    expected = [ \
        ['systemFetch', ['../SKILL.md']], \
        ['localStorageSet', ['creator.history', jsonStringify([testCreatorHistoryEntry()])]] \
    ]
    arrayExtend(expected, testCreatorProjectLog('out/myApp.tar.gz', 'out/myApp.tar.gz'))
    unittestDeepEqual(calls, expected)
endfunction
unittestRunTest('testCreatorMainOutput')


