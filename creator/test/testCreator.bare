}


# The expected landing page call log
function testCreatorLandingLog(error, history):
    return testCreatorLandingLogEx(error, history, false)
endfunction


function testCreatorLandingLogEx(error, history, confirmClear):
    log = [ \
        ['documentSetTitle', ['BareScript Creator']], \
        ['markdownPrint', [ \
            '# BareScript Creator', \
            '', \
            'BareScript Creator generates a [BareScript](https://craigahobbs.github.io/bare-script/) project from your ' + \
            'specification. Choose a project type, fill in its form, and download the project archive. Its Makefile has ' + \
            '[Claude Code](https://claude.com/product/claude-code#featureTerminal) write the code.' \
        ]] \
    ]
    if error != null:
        arrayPush(log, ['markdownPrint', ['', '**Error:** ' + error]])
    endif
    arrayPush(log, ['markdownPrint', ['', '## Project Types']])
    arrayPush(log, ['markdownPrint', ['', "- [Frontend Application](#var.vType='frontend') - " + objectGet(creatorFrontendType, 'description')]])
    arrayPush(log, ['markdownPrint', [ \
        '', \
        '## How It Works', \
        '', \
        '1. Fill in a project type\'s form and click **Create**. Your entries are kept for the browser session, and each', \
        '   project you create is added to the history below.', \
        '2. Extract the archive: `tar xzf <project>.tar.gz`.', \
        '3. In the project directory, run `make run`. The first run builds a Python virtual environment with the `bare`', \
        '   CLI and MarkdownUp, then runs Claude Code in your terminal:', \
        '', \
        '   ```', \
        '   claude --model opus --effort high --permission-mode acceptEdits @SPEC.md', \
        '   ```', \
        '', \
        '   Claude Code asks you to trust the new project directory, then reads `SPEC.md` (your specification plus', \
        '   implementation instructions), `CLAUDE.md`, and the bundled bare-script skill, writes the code and its unit', \
        '   tests, and runs `make commit` until they pass. File edits are pre-approved. When it finishes, exit the', \
        '   session and `make run` serves the application.', \
        '   [Claude Code](https://claude.com/product/claude-code#featureTerminal) must be installed and signed in.', \
        '4. To improve the result, load the project from the history, refine the specification, and create it again -', \
        '   or edit the project\'s `SPEC.md`, delete the generated code, and run `make run` again.', \
        '', \
        '## History' \
    ]])
    if !history:
        arrayPush(log, ['markdownPrint', ['', 'No projects have been created yet.']])
        return log
    endif
    for entry in history:
        elements = [ \
            {'text': objectGet(entry, 'display')}, \
            {'html': 'b', 'elem': {'text': objectGet(entry, 'title')}}, \
            {'text': ' '} \
        ]
        if !objectGet(entry, 'unknown'):
            arrayPush(elements, formsLinkButtonElements('Load', '<function>'), {'text': ' | '})
        endif
        arrayPush(elements, formsLinkButtonElements('Remove', '<function>'))
        arrayPush(log, ['elementModelRender', [{'html': 'p', 'elem': elements}]])
    endfor
    if confirmClear:
        arrayPush(log, ['elementModelRender', [{'html': 'p', 'elem': [ \
            {'text': 'Clear the history? '}, \
            formsLinkButtonElements('Yes, Clear History', '<function>'), \
            {'text': ' | '}, \
            formsLinkButtonElements('Cancel', '<function>') \
        ]}]])
    else:
        arrayPush(log, ['elementModelRender', [{'html': 'p', 'elem': formsLinkButtonElements('Clear History', '<function>')}]])
    endif
    return log
endfunction


# The expected frontend form render call log
function testCreatorFormLog(values, errorLines):
    log = [ \
        ['documentSetTitle', ['Frontend Application']], \
        ['markdownPrint', ['[Back](#var=)', '', '# Frontend Application', '', objectGet(creatorFrontendType, 'description')]] \
    ]
    for errorLine in errorLines:
        arrayPush(log, ['markdownPrint', ['', '**Error:** ' + errorLine]])
    endfor
    elements = []
    for field in objectGet(creatorFrontendType, 'fields'):
        arrayPush(elements, creatorFieldElements(creatorFrontendType, field, objectGet(values, objectGet(field, 'name'), '')))
    endfor
    arrayPush(elements, {'html': 'p', 'elem': [ \
        formsLinkButtonElements('Create', '<function>'), \
        {'text': ' | '}, \
        formsLinkButtonElements('Reset', '<function>') \
    ]})
    arrayPush(log, ['elementModelRender', [elements]])
    return log
endfunction


# The expected call log prefix of a form create - the input reads and the session save
function testCreatorCreateLog(values):
    return [ \
        ['documentInputValue', ['creator-frontend-copyright']], \
        ['documentInputValue', ['creator-frontend-name']], \
        ['documentInputValue', ['creator-frontend-description']], \
        ['documentInputValue', ['creator-frontend-spec']], \
        ['sessionStorageSet', ['creator.frontend', jsonStringify(values)]] \
    ]
endfunction


