async function testCreatorHistoryBindings():
    # The history is seeded in every mock scope
    confirmFn = systemPartial(creatorRenderLanding, null, true)
    testVerifyClick(creatorMain, 'Load', systemPartial(creatorOnHistoryLoad, 0), null, testCreatorHistorySeed)
    testVerifyClick(creatorMain, 'Remove', systemPartial(creatorOnHistoryRemove, 0), null, testCreatorHistorySeed)
    testVerifyClick(creatorMain, 'Clear History', confirmFn, null, testCreatorHistorySeed)
    testVerifyClick(confirmFn, 'Yes, Clear History', creatorOnHistoryClearConfirm, null, testCreatorHistorySeed)
    testVerifyClick(confirmFn, 'Cancel', systemPartial(creatorRenderLanding, null, false), null, testCreatorHistorySeed)
endfunction
unittestRunTest('testCreatorHistoryBindings')


function testCreatorHistoryAdd():
    unittestMockAll()
    now = testCreatorNow
    ix = 0
    while ix < creatorHistoryMax + 1:
        creatorHistoryAdd(creatorFrontendType, 'App ' + ix, {'name': 'App ' + ix}, now + ix * 60000)
        ix = ix + 1
    endwhile
    history = creatorHistoryLoad()
    unittestMockEnd()
    unittestEqual(arrayLength(history), creatorHistoryMax)
    unittestEqual(objectGet(arrayGet(history, 0), 'title'), 'App ' + creatorHistoryMax)
    unittestEqual(objectGet(arrayGet(history, creatorHistoryMax - 1), 'title'), 'App 1')
endfunction
unittestRunTest('testCreatorHistoryAdd')


function testCreatorHistoryAddDuplicate():
    # A project created again with the same values replaces its entry, newest first
    unittestMockAll()
    now = testCreatorNow
    creatorHistoryAdd(creatorFrontendType, 'App A', {'name': 'App A', 'spec': 'a'}, now)
    creatorHistoryAdd(creatorFrontendType, 'App B', {'name': 'App B', 'spec': 'b'}, now + 60000)
    creatorHistoryAdd(creatorFrontendType, 'App A', {'spec': 'a', 'name': 'App A'}, now + 120000)
    history = creatorHistoryLoad()
    unittestMockEnd()
    unittestDeepEqual(history, [ \
        {'type': 'frontend', 'title': 'App A', 'date': datetimeISOFormat(now + 120000), 'values': {'name': 'App A', 'spec': 'a'}}, \
        {'type': 'frontend', 'title': 'App B', 'date': datetimeISOFormat(now + 60000), 'values': {'name': 'App B', 'spec': 'b'}} \
    ])

    # The same values of a different project type are a separate entry
    unittestMockAll()
    otherType = {'name': 'other'}
    creatorHistoryAdd(creatorFrontendType, 'App A', {'name': 'App A'}, now)
    creatorHistoryAdd(otherType, 'App A', {'name': 'App A'}, now + 60000)
    history = creatorHistoryLoad()
    unittestMockEnd()
    unittestEqual(arrayLength(history), 2)
endfunction
unittestRunTest('testCreatorHistoryAddDuplicate')


