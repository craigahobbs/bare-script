# The expected project render call log - "archive" is the download file name or the written file path
function testCreatorProjectLog(archive, output):
    log = [ \
        ['documentSetTitle', ['My App']], \
        ['markdownPrint', ["[Back](#var.vType='frontend')", '', '# My App']] \
    ]
    if output != null:
        arrayPush(log, ['markdownPrint', ['', 'Wrote `' + output + '`']])
    else:
        # The download URL is the mock's, from the archive's first bytes (the gzip header)
        arrayPush(log, ['elementModelRender', [{ \
            'html': 'p', \
            'elem': { \
                'html': 'a', \
                'attr': {'href': 'blob:application/gzip-31,139,8,0,0,0,0,0', 'download': archive}, \
                'elem': {'text': 'Download ' + archive} \
            } \
        }]])
    endif
    arrayExtend(log, [ \
        ['markdownPrint', ['', '```']], \
        ['markdownPrint', [testCreatorTree]], \
        ['markdownPrint', ['```']], \
        ['markdownPrint', ['', 'To generate the code:', '', '```']], \
        ['markdownPrint', [['tar xzf ' + archive, 'cd myApp', 'make run']]], \
        ['markdownPrint', ['```']], \
        ['markdownPrint', ['', 'The first `make run` has Claude Code generate `myApp.bare` from `SPEC.md`, then serves the ' + \
            'application in your browser.']], \
        ['markdownPrint', [ \
            '', \
            'Claude Code asks you to trust the project directory when it starts; exit the session when it finishes. ' + \
            'See [BareScript Creator](#var=) for details.' \
        ]] \
    ])
    return log
endfunction


# The expected history entry of the test values
function testCreatorHistoryEntry():
    return {'type': 'frontend', 'title': 'My App', 'date': datetimeISOFormat(testCreatorNow), 'values': testCreatorValues}
endfunction


# Helper to mock all and the creation datetime
function testCreatorMockAll(data):
