# Seed the history with two entries - one of an unknown project type
function testCreatorHistorySeed():
    localStorageSet('creator.history', jsonStringify([ \
        {'type': 'frontend', 'title': 'My App', 'date': '2026-09-29T12:00:00+00:00', 'values': testCreatorValues}, \
        {'type': 'backend', 'title': 'Old Service', 'date': '2026-09-28T08:30:00+00:00', 'values': {'name': 'Old Service'}} \
    ]))
endfunction


testCreatorHistoryDisplay = [ \
    {'display': '2026-09-29 12:00 - Frontend Application - ', 'title': 'My App'}, \
    {'display': '2026-09-28 08:30 - Unknown project type "backend" - ', 'title': 'Old Service', 'unknown': true} \
]


async function testCreatorMainLandingHistory():
    unittestMockAll()
    testCreatorHistorySeed()
    creatorMain()
    calls = unittestMockEnd()
    arrayDelete(calls, 0)
    unittestDeepEqual(calls, testCreatorLandingLog(null, testCreatorHistoryDisplay))
endfunction
unittestRunTest('testCreatorMainLandingHistory')


async function testCreatorMainLandingHistoryInvalid():
    # The history is validated against its schema - an invalid history is empty
    unittestMockAll()
    localStorageSet('creator.history', '{"not": "an array"}')
    creatorMain()
    calls = unittestMockEnd()
    arrayDelete(calls, 0)
    expected = testCreatorLandingLog(null, [])
    lastCall = arrayPop(expected)
    arrayPush(expected, ['systemLogDebug', ['schema.bare: Invalid value {"not":"an array"} (type "object"), expected type "array"']], lastCall)
    unittestDeepEqual(calls, expected)

    # Malformed entry
    unittestMockAll()
    localStorageSet('creator.history', jsonStringify([ \
        {'type': 'frontend', 'title': 'My App', 'date': '2026-09-29T12:00:00+00:00', 'values': {'name': 1}} \
    ]))
    creatorMain()
    calls = unittestMockEnd()
    arrayDelete(calls, 0)
    expected = testCreatorLandingLog(null, [])
    lastCall = arrayPop(expected)
    arrayPush(expected, \
        ['systemLogDebug', ['schema.bare: Invalid value 1 (type "number") for member "0.values.name", expected type "string"']], lastCall)
    unittestDeepEqual(calls, expected)
endfunction
unittestRunTest('testCreatorMainLandingHistoryInvalid')


